# enclave-server (docs/12-servers.md §1.1). DOMAIN, OPERATOR and FAMILY
# come from .env (ENCLAVE_SERVER__* in compose.yml); anything here can be
# overridden the same way.

[server]
# The stack's internal network only: its onion service (and the Nym
# ingress, or in development compose.dev.yml) reaches it here.
listen = "0.0.0.0:7443"
data_dir = "/var/lib/enclave/server"
keys_dir = "/var/lib/enclave/keys"
public_dir = "/var/lib/enclave/public"
# The foundation's signed list, served to clients as is.
server_list = "/etc/enclave/foundation/server-list.bin"
# The release update bundle the front fetches, relayed to clients.
update_bundle = "/var/lib/enclave/updates/enclave-update.bin"
# This server's Nym address, with the optional mixnet. Empty: the ingress's
# own, which it writes to public_dir/ingress.addr and the server publishes
# in its descriptor (its onion service's address, public_dir/onion.addr,
# goes there too).
nym_address = ""

[push]
# Due wakes go to the push egress (compose service `push-egress`), which
# carries them through Tor to the push relay's onion service
# (PUSH_RELAY_ONION in .env). A stack running the push relay itself may
# send them to it directly: forward = "push-relay:7445". With the optional
# mixnet: "push-egress-nym:7446". Unset: no push.
forward = "push-egress:7446"

[policy]
# Proof-of-work efforts (Equihash work factor) and quotas (blob_tokens_per_day:
# blob-upload tokens an inbox may be issued a day). The defaults:
# effort_request = 64
# effort_claim = 8
# blob_tokens_per_day = 64
# effort_username = 64
# effort_inbox = 16
# inbox_quota = 5000
# request_quota = 100
# token_quota = 4096
# ttl_days = 30

[kt]
enabled = true
# Other operators' witnesses that cosign this log (the foundation's list
# names them), for example ["https://b.example", "https://c.example"].
witnesses = []
# Claims within this many seconds go into one epoch, so names claimed
# around the same time can't be told apart by epoch.
batch_secs = 2

[backup]
dir = "/var/lib/enclave/backups"
interval_hours = 24
keep = 7
