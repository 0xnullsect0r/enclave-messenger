<!-- AppStream metadata (Flathub, GNOME Software, KDE Discover). The first
     release must be the workspace version: `cargo xtask version` checks. -->
<component type="desktop-application">
  <id>io.github.EnclaveChat.Enclave</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Enclave</name>
  <summary>Private messages without a phone number</summary>
  <developer id="io.github.enclavechat">
    <name>The Enclave contributors</name>
  </developer>
  <description>
    <p>
      Enclave is a messenger for chats, groups, photos, voice notes and calls
      that hides not only what you say but who you talk to and when.
    </p>
    <ul>
      <li>No phone number or email: your account is a key, and a username is optional.</li>
      <li>Post-quantum encryption from the first message.</li>
      <li>Traffic goes through Tor and the Nym mixnet, every message is the same size, and cover traffic hides when you are talking.</li>
      <li>Servers are run by independent operators, and none of them can read messages, see your contacts or change your keys without being caught.</li>
      <li>Your messages stay on your devices, encrypted, with an optional app lock and an emergency PIN.</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.EnclaveChat.Enclave.desktop</launchable>
  <icon type="stock">io.github.EnclaveChat.Enclave</icon>
  <url type="homepage">https://github.com/EnclaveChat/Enclave</url>
