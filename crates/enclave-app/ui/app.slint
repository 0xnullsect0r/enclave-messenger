// Enclave app window. Point of view (docs/17-design.md): private
// correspondence done well: warm paper, deep pine ink, and one saffron seal
// that appears only when something has really been confirmed.
import "fonts/AtkinsonHyperlegibleNext-Regular.ttf";
import "fonts/AtkinsonHyperlegibleNext-SemiBold.ttf";
// Italics only for what people write (_italic_ in a message).
import "fonts/AtkinsonHyperlegibleNext-Italic.ttf";
import "fonts/AtkinsonHyperlegibleNext-SemiBoldItalic.ttf";
import "fonts/AtkinsonHyperlegibleMono-Regular.ttf";
// Emoji (reactions, and emoji people type): Noto Color Emoji (COLRv1).
import "fonts/NotoColorEmoji-Regular.ttf";
import { Tokens } from "tokens.slint";
import { AboutSlint, ListView } from "std-widgets.slint";
import {
    Body, Secondary, Caption, Title, ScreenTitle, Code, Seal, SealState, SealClose, PrimaryButton,
    QuietButton, ActionTile, Field, Avatar, Notice, Icons,
} from "controls.slint";

export { Tokens }

// 0 = waiting for them, 1 = request to us, 2 = talking.
export struct ContactRow {
    id: string,
    name: string,
    initials: string,
    tint: color,
    preview: string,
    time: string,
    unread: int,
    state: int,
    verified: bool,
    met: bool,
    // 0 person, 1 group
    kind: int,
    members: int,
    pinned: bool,
    muted: bool,
    archived: bool,
    blocked: bool,
    // A group member who is an admin (members sheet).
    admin: bool,
    // Contact art: filled cells in bits 0–24 (0 for none), and its tint.
    art: int,
    art-tint: color,
}

// A chat folder, and whether the open conversation is in it.
export struct FolderRow {
    name: string,
    on: bool,
}

export struct PickRow {
    id: string,
    name: string,
    initials: string,
    tint: color,
    selected: bool,
}

export struct DeviceRow {
    id: string,
    label: string,
    detail: string,
    removable: bool,
    history-action: string,
}

// status: 0 sending privately, 1 on its way, 2 delivered, 3 read,
// 4 not delivered yet.
export struct PollOption {
    text: string,
    count: int,
    mine: bool,
}

export struct MessageRow {
    text: string,
    // The text with its formatting (`src/format.rs`): spoilers hidden,
    // and shown (while the message is selected); and the same for a
    // screen reader.
    rich: styled-text,
    rich-revealed: styled-text,
    spoken: string,
    spoken-revealed: string,
    outgoing: bool,
    time: string,
    status: int,
    sender: string,
    // Position in the conversation (decimal), for actions on it.
    seq: string,
    can-edit: bool,
    deleted: bool,
    file: string,
    // A picture: its preview comes separately (decoded by mediad).
    picture: bool,
    has-image: bool,
    image: image,
    // 0 not a poll, 1 open, 2 closed, 3 closed with a different tally.
    poll-state: int,
    poll-options: [PollOption],
    poll-ours: bool,
    // An anonymous poll: votes sealed to whoever asked; how many voted.
    poll-anonymous: bool,
    poll-voters: int,
    pinned: bool,
    // A shared contact (empty when the message isn't one).
    contact-name: string,
    contact-initials: string,
    contact-known: bool,
    // A shared place: coordinates (empty when the message isn't one).
    location: string,
    location-label: string,
    sticker: bool,
    pack-added: bool,
    // A voice note: its waveform (0–255 per bar) and length, "0:42".
    voice: bool,
    waveform: [int],
    voice-time: string,
    // Its words, transcribed on this device (empty until asked for).
    transcript: string,
    // An animated picture (a clip): its length, "0:03"; empty otherwise.
    clip-time: string,
    // It answers another message: that one's position (empty when it
    // isn't here any more), author and first line.
    quoted: bool,
    quote-seq: string,
    quote-who: string,
    quote-text: string,
    forwarded: bool,
    // A group message that mentions us.
    mentions-me: bool,
    // Our reaction to it (empty: none).
    my-reaction: string,
    // A view-once picture or clip, and whether this device can still open
    // it.
    view-once: bool,
    view-once-ready: bool,
}

// A file in the gallery across all conversations.
export struct GalleryRow {
    conversation: string,
    name: string,
    seq: string,
    file: string,
    picture: bool,
    outgoing: bool,
    time: string,
}

// A crash report on this device (enclave-crash): which process, when, and
// its text.
export struct CrashRow {
    process: string,
    when: string,
    text: string,
}

// One licence text and the packages under it (Settings → About).
export struct LicenceEntry {
    title: string,
    text: string,
}

// A server from the foundation's list. votes: admins of the open group who
// voted to move it there.
export struct ServerOption {
    id: string,
    domain: string,
    operator: string,
    votes: int,
}

export struct StickerPackRow {
    id: string,
    title: string,
    count: int,
}

// Someone in a group call: their tile (their picture once it comes).
export struct CallPeerTile {
    id: int,
    name: string,
    initials: string,
    tint: color,
    hand: bool,
    reaction: string,
    has-picture: bool,
    picture: image,
}

// One sticker in the picker; its picture comes as a preview.
export struct StickerCell {
    pack: string,
    index: int,
    has-image: bool,
    image: image,
}

export enum Screen { welcome, name, setting-up, join, locked, main, restore }
export enum Sheet { none, pack-preview, open-map, view-once, emoji, forward, call-route, servers, about, licences, my-code, add, check-code, settings, recovery, new-group, devices, meet, timer, attach, members, poll, friends, share, conversation, share-contact, location, gallery, report, stickers, new-pack, change-words, player, delete-account, crashes }

component DeliveryMark inherits Rectangle {
    in property <int> status;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    border-width: 1.5px;
    border-color: root.status == 4 ? Tokens.danger : Tokens.meta-on-bubble-out;
    background: root.status == 2 || root.status == 3 ? Tokens.meta-on-bubble-out : transparent;
    accessible-role: image;
    accessible-label: root.status == 0 ? @tr("Sending privately")
        : root.status == 1 ? @tr("On its way")
        : root.status == 2 ? @tr("Delivered")
        : root.status == 3 ? @tr("Read")
        : @tr("Not delivered yet");
    // Read: a second ring around the filled mark.
    if root.status == 3: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: self.width / 2;
        border-width: 1px;
        border-color: Tokens.meta-on-bubble-out;
    }
    if root.status == 1: Rectangle {
        x: 0;
        width: parent.width / 2;
        border-top-left-radius: 5px;
        border-bottom-left-radius: 5px;
        background: Tokens.meta-on-bubble-out;
    }
}

component Bubble inherits HorizontalLayout {
    in property <MessageRow> msg;
    in property <length> bubble-max;
    in property <bool> selected;
    // Jump here (a pinned message picked from the list): where it is.
    in property <bool> jump;
    callback jumped(length);
    changed jump => {
        if self.jump {
            self.jumped(self.y);
        }
    }
    callback tapped();
    callback vote(int);
    callback close-poll();
    callback add-contact();
    callback copy(string);
    callback open-map();
    callback add-pack();
    callback play-clip();
    callback open-view-once();
    // A voice note: playing now, and play or stop.
    in property <bool> playing;
    callback play-voice();
    // The transcription model is here: a voice note can be transcribed.
    in property <bool> can-transcribe;
    callback transcribe();
    // The quoted message was tapped: show it.
    callback show-quote(string);
    alignment: root.msg.outgoing ? end : start;
    Rectangle {
        max-width: root.bubble-max;
        // A sticker stands on its own, without a bubble.
        background: root.msg.sticker ? transparent : root.msg.outgoing ? Tokens.bubble-out : Tokens.bubble-in;
        // A mention of us: a pine edge, so it stands out in a busy group.
        border-width: root.selected ? 2px : root.msg.mentions-me ? 1px : 0px;
        border-color: root.selected ? Tokens.focus-ring : Tokens.pine;
        TouchArea { clicked => { root.tapped(); } }
        // Each message is reached with Tab and selected with Enter or
        // Space, which opens its actions (A-3).
        bubble-focus := FocusScope {
            key-pressed(e) => {
                if e.text == " " || e.text == "\n" { root.tapped(); return accept; }
                reject
            }
        }
        if bubble-focus.has-focus: Rectangle {
            border-top-left-radius: Tokens.radius-bubble;
            border-top-right-radius: Tokens.radius-bubble;
            border-bottom-left-radius: root.msg.outgoing ? Tokens.radius-bubble : Tokens.radius-bubble-tail;
            border-bottom-right-radius: root.msg.outgoing ? Tokens.radius-bubble-tail : Tokens.radius-bubble;
            border-width: Tokens.icon-focus-ring-width;
            border-color: Tokens.focus-ring;
        }
        border-top-left-radius: Tokens.radius-bubble;
        border-top-right-radius: Tokens.radius-bubble;
        border-bottom-left-radius: root.msg.outgoing ? Tokens.radius-bubble : Tokens.radius-bubble-tail;
        border-bottom-right-radius: root.msg.outgoing ? Tokens.radius-bubble-tail : Tokens.radius-bubble;
        accessible-role: text;
        accessible-label: (root.msg.outgoing ? @tr("You: ") : "") + (root.msg.forwarded ? @tr("Forwarded. ") : "") + (root.msg.view-once ? (root.msg.outgoing ? @tr("Sent to view once. ") : root.msg.view-once-ready ? @tr("Photo to view once, not opened yet. ") : @tr("Photo to view once, opened. ")) : "") + (root.msg.mentions-me ? @tr("Mentions you. ") : "") + (root.msg.quoted ? @tr("Answering {}: {}. ", root.msg.quote-who, root.msg.quote-text) : "") + (root.msg.picture ? @tr("Photo: {}. ", root.msg.file) : "") + (root.msg.sticker ? @tr("Sticker. ") : "") + (root.msg.voice ? @tr("Voice note, ") + (root.msg.voice-time != "" ? root.msg.voice-time : @tr("length unknown")) + (root.msg.transcript != "" ? @tr(". It says: {}", root.msg.transcript) : "") + @tr(". Select it to save it as a sound file. ") : "") + (root.msg.contact-name != "" ? @tr("Contact: {}. ", root.msg.contact-name) : "") + (root.msg.location != "" ? @tr("Location: {} {}. ", root.msg.location-label, root.msg.location) : "") + (root.selected ? root.msg.spoken-revealed : root.msg.spoken) + ", " + root.msg.time;
        accessible-action-default => { root.tapped(); }
        VerticalLayout {
            padding-left: Tokens.space-sm;
            padding-right: Tokens.space-sm;
            padding-top: Tokens.space-s;
            padding-bottom: Tokens.space-s;
            spacing: Tokens.space-xs;
            if !root.msg.outgoing && root.msg.sender != "": Text {
                text: root.msg.sender;
                font-size: Tokens.type-caption;
                font-weight: 600;
                color: Tokens.pine;
            }
            if root.msg.forwarded: Text {
                text: @tr("Forwarded");
                font-size: Tokens.type-caption;
                font-italic: true;
                color: root.msg.outgoing ? Tokens.meta-on-bubble-out : Tokens.text-muted;
            }
            // View once: a plain card, opened (once) on a tap.
            if root.msg.view-once: Rectangle {
                min-width: 200px;
                height: 44px;
                border-radius: Tokens.radius-control;
                border-width: 1px;
                border-color: root.msg.outgoing ? Tokens.meta-on-bubble-out : Tokens.hairline;
                HorizontalLayout {
                    padding-left: Tokens.space-s;
                    padding-right: Tokens.space-s;
                    spacing: Tokens.space-xs;
                    Text {
                        vertical-alignment: center;
                        text: root.msg.outgoing ? @tr("Sent to view once")
                            : root.msg.view-once-ready ? @tr("Photo to view once. Tap to open.")
                            : @tr("Opened");
                        font-size: Tokens.type-secondary;
                        font-weight: root.msg.view-once-ready && !root.msg.outgoing ? 600 : 400;
                        color: root.msg.outgoing ? Tokens.meta-on-bubble-out : root.msg.view-once-ready ? Tokens.text : Tokens.text-muted;
                    }
                }
                if !root.msg.outgoing && root.msg.view-once-ready: TouchArea {
                    clicked => { root.open-view-once(); }
                }
            }
            // The message it answers: tap to go to it.
            if root.msg.quoted: Rectangle {
                border-radius: Tokens.radius-control;
                background: root.msg.outgoing ? Tokens.on-bubble-out.with-alpha(0.12) : Tokens.surface;
                quote-touch := TouchArea {
                    mouse-cursor: root.msg.quote-seq != "" ? pointer : default;
                    clicked => { if root.msg.quote-seq != "" { root.show-quote(root.msg.quote-seq); } }
                }
                HorizontalLayout {
                    spacing: Tokens.space-s;
                    Rectangle { width: 3px; background: Tokens.pine; }
                    VerticalLayout {
                        padding-top: Tokens.space-xs;
                        padding-bottom: Tokens.space-xs;
                        padding-right: Tokens.space-s;
                        if root.msg.quote-who != "": Text {
                            text: root.msg.quote-who;
                            font-size: Tokens.type-caption;
                            font-weight: 600;
                            color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.pine;
                        }
                        Text {
                            text: root.msg.quote-text;
                            font-size: Tokens.type-caption;
                            color: root.msg.outgoing ? Tokens.meta-on-bubble-out : Tokens.text-muted;
                            overflow: elide;
                        }
                    }
                }
            }
            if root.msg.voice: HorizontalLayout {
                spacing: Tokens.space-sm;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: self.width / 2;
                        background: play.pressed ? Tokens.pine.darker(20%) : root.msg.outgoing ? Tokens.on-bubble-out : Tokens.pine;
                        accessible-role: button;
                        accessible-label: root.playing ? @tr("Stop the voice note") : @tr("Play the voice note");
                        accessible-action-default => { root.play-voice(); }
                        Path {
                            width: 16px;
                            height: 16px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: root.playing ? Icons.stop : Icons.play;
                            fill: root.msg.outgoing ? Tokens.bubble-out : Tokens.on-pine;
                        }
                        play := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.play-voice(); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 2px;
                    alignment: center;
                    for w in root.msg.waveform: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 3px;
                            height: max(3px, w * 28px / 255);
                            border-radius: 1.5px;
                            background: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.pine;
                        }
                    }
                    if root.msg.waveform.length == 0: Caption { text: @tr("Voice note"); vertical-alignment: center; }
                }
                Text {
                    text: root.msg.voice-time;
                    font-size: Tokens.type-caption;
                    color: root.msg.outgoing ? Tokens.meta-on-bubble-out : Tokens.text-muted;
                    vertical-alignment: center;
                }
            }
            // Its words, once transcribed here; until then, a way to ask.
            if root.msg.voice && root.msg.transcript != "": Text {
                text: root.msg.transcript;
                wrap: word-wrap;
                font-size: Tokens.type-secondary;
                font-italic: true;
                color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.text;
            }
            if root.msg.voice && root.msg.transcript == "" && root.can-transcribe: HorizontalLayout {
                alignment: start;
                Rectangle {
                    accessible-role: button;
                    accessible-label: @tr("Transcribe the voice note");
                    accessible-action-default => { root.transcribe(); }
                    min-height: 24px;
                    Text {
                        text: @tr("Transcribe");
                        font-size: Tokens.type-caption;
                        font-weight: 600;
                        color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.pine;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.transcribe(); }
                    }
                }
            }
            if root.msg.sticker && !root.msg.has-image: Rectangle {
                width: 120px;
                height: 120px;
                border-radius: Tokens.radius-control;
                background: Tokens.bubble-in;
                Caption { text: @tr("Sticker"); }
            }
            if root.msg.has-image: Rectangle {
                // Natural size, narrowed to the bubble, aspect kept; stickers
                // at most 160 px.
                width: min(root.msg.sticker ? 160px : root.bubble-max - 2 * Tokens.space-sm, root.msg.image.width * 1px);
                height: self.width * root.msg.image.height / max(1, root.msg.image.width);
                border-radius: Tokens.radius-control;
                clip: true;
                Image {
                    source: root.msg.image;
                    width: parent.width;
                    height: parent.height;
                    image-fit: fill;
                    accessible-role: image;
                    accessible-label: @tr("Picture: {}. Opens full size.", root.msg.file);
                    accessible-action-default => { root.play-clip(); }
                }
                // Full size: a picture in the viewer, a clip in the player.
                if !root.msg.sticker: TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.play-clip(); }
                }
            }
            if root.msg.contact-name != "": HorizontalLayout {
                spacing: Tokens.space-sm;
                VerticalLayout {
                    alignment: center;
                    Avatar { initials: root.msg.contact-initials; tint: Tokens.pine; size: 36px; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.msg.contact-name;
                        font-size: Tokens.type-body;
                        font-weight: 600;
                        color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.text;
                    }
                    Text {
                        text: root.msg.outgoing ? @tr("Contact you shared") : root.msg.contact-known ? @tr("Someone you already talk to") : @tr("Contact. Check their code when you meet.");
                        font-size: Tokens.type-caption;
                        color: root.msg.outgoing ? Tokens.meta-on-bubble-out : Tokens.text-muted;
                        wrap: word-wrap;
                    }
                }
                if !root.msg.outgoing && !root.msg.contact-known: VerticalLayout {
                    alignment: center;
                    QuietButton { text: @tr("Add"); outlined: true; clicked => { root.add-contact(); } }
                }
            }
            if root.msg.location != "": VerticalLayout {
                spacing: 2px;
                Text {
                    text: root.msg.location-label != "" ? root.msg.location-label : @tr("Location");
                    font-size: Tokens.type-body;
                    font-weight: 600;
                    color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.text;
                }
                Text {
                    text: root.msg.location;
                    font-family: "Atkinson Hyperlegible Mono";
                    font-size: Tokens.type-secondary;
                    color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.text;
                }
                HorizontalLayout {
                    alignment: start;
                    QuietButton {
                        text: @tr("Copy coordinates");
                        accessible-label: @tr("Copy coordinates {}", root.msg.location);
                        clicked => { root.copy(root.msg.location); }
                    }
                    QuietButton {
                        text: @tr("Open in maps");
                        accessible-label: @tr("Open {} in a maps app", root.msg.location);
                        clicked => { root.open-map(); }
                    }
                }
            }
            if root.msg.clip-time != "" && !root.msg.deleted: HorizontalLayout {
                alignment: start;
                QuietButton {
                    text: @tr("Play · {}", root.msg.clip-time);
                    accessible-label: @tr("Play animated picture, {}", root.msg.clip-time);
                    clicked => { root.play-clip(); }
                }
            }
            if root.msg.picture && !root.msg.has-image: Text {
                text: @tr("Photo: {}", root.msg.file);
                font-size: Tokens.type-body;
                color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.text;
                wrap: word-wrap;
            }
            if root.msg.sticker && !root.msg.outgoing && !root.msg.pack-added && !root.msg.deleted: HorizontalLayout {
                alignment: start;
                QuietButton {
                    text: @tr("See the pack");
                    accessible-label: @tr("See this sticker pack before adding it");
                    clicked => { root.add-pack(); }
                }
            }
            // A poll's question as it is; a message with its formatting.
            if root.msg.text != "" && root.msg.poll-state > 0: Text {
                text: root.msg.text;
                font-size: Tokens.type-body;
                font-weight: 600;
                color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.text;
                wrap: word-wrap;
            }
            if root.msg.text != "" && root.msg.poll-state == 0: StyledText {
                text: root.selected ? root.msg.rich-revealed : root.msg.rich;
                default-font-size: Tokens.type-body;
                default-color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.text;
                accessible-role: none;
            }
            for o[i] in root.msg.poll-options: Rectangle {
                min-width: 220px;
                height: 40px;
                border-radius: Tokens.radius-control;
                border-width: o.mine ? 2px : 1px;
                border-color: o.mine ? Tokens.pine : Tokens.hairline;
                accessible-role: button;
                accessible-label: o.text + ", " + o.count + (o.count == 1 ? @tr(" vote") : @tr(" votes")) + (o.mine ? @tr(", your vote") : "");
                accessible-action-default => { if root.msg.poll-state == 1 { root.vote(i); } }
                TouchArea {
                    enabled: root.msg.poll-state == 1;
                    mouse-cursor: root.msg.poll-state == 1 ? pointer : default;
                    clicked => { root.vote(i); }
                }
                HorizontalLayout {
                    padding-left: Tokens.space-sm;
                    padding-right: Tokens.space-sm;
                    spacing: Tokens.space-s;
                    Text {
                        text: o.text;
                        font-size: Tokens.type-body;
                        color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: o.count;
                        font-size: Tokens.type-secondary;
                        font-weight: 600;
                        color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.text;
                        vertical-alignment: center;
                    }
                }
            }
            if root.msg.poll-anonymous && root.msg.poll-state == 1: Text {
                text: (root.msg.poll-voters == 1 ? @tr("1 vote so far.") : @tr("{} votes so far.", root.msg.poll-voters))
                    + (root.msg.poll-ours ? @tr(" Only you see how people voted.") : @tr(" Anonymous: only the person who asked sees how people voted; everyone sees the results when it closes."));
                font-size: Tokens.type-caption;
                color: root.msg.outgoing ? Tokens.meta-on-bubble-out : Tokens.text-muted;
                wrap: word-wrap;
            }
            if root.msg.poll-state >= 2: Text {
                text: root.msg.poll-state == 2 ? @tr("Closed.") : @tr("Closed. The count the person who asked sees differs from yours, so some votes may not have reached everyone.");
                font-size: Tokens.type-caption;
                color: root.msg.outgoing ? Tokens.meta-on-bubble-out : Tokens.text-muted;
                wrap: word-wrap;
            }
            if root.msg.poll-state == 1 && root.msg.poll-ours: HorizontalLayout {
                alignment: start;
                QuietButton { text: @tr("Close poll"); clicked => { root.close-poll(); } }
            }
            HorizontalLayout {
                alignment: end;
                spacing: Tokens.space-xs;
                Text {
                    text: root.msg.time;
                    font-size: Tokens.type-caption;
                    color: root.msg.outgoing ? Tokens.meta-on-bubble-out : Tokens.text-muted;
                    vertical-alignment: center;
                }
                // A negative status (notes to self) shows no mark.
                if root.msg.outgoing && root.msg.status >= 0: VerticalLayout {
                    alignment: center;
                    DeliveryMark { status: root.msg.status; }
                }
            }
        }
    }
}

component ContactItem inherits Rectangle {
    in property <ContactRow> item;
    in property <bool> selected;
    callback clicked();
    height: 72px;
    background: root.selected ? Tokens.bubble-in : touch.has-hover ? Tokens.surface : transparent;
    border-radius: Tokens.radius-control;
    accessible-role: list-item;
    accessible-label: root.item.name + (root.item.pinned ? @tr(", pinned") : "") + (root.item.muted ? @tr(", muted") : "") + (root.item.unread > 0 ? @tr(", {} unread", root.item.unread) : "") + ", " + root.item.preview;
    accessible-action-default => { clicked(); }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    // Reached with Tab, opened with Enter or Space (A-3).
    focus := FocusScope {
        key-pressed(e) => {
            if e.text == " " || e.text == "\n" { root.clicked(); return accept; }
            reject
        }
    }
    if focus.has-focus: Rectangle {
        border-radius: parent.border-radius;
        border-width: Tokens.icon-focus-ring-width;
        border-color: Tokens.focus-ring;
    }
    HorizontalLayout {
        padding-left: Tokens.space-sm;
        padding-right: Tokens.space-sm;
        spacing: Tokens.space-sm;
        VerticalLayout {
            alignment: center;
            Avatar { initials: root.item.initials; tint: root.item.tint; art: root.item.art; art-tint: root.item.art-tint; size: 44px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: Tokens.space-xs;
                Text {
                    text: root.item.name;
                    font-size: Tokens.type-body;
                    font-weight: root.item.unread > 0 ? 600 : 400;
                    color: Tokens.text;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.item.verified: VerticalLayout {
                    alignment: center;
                    Seal { state: SealState.checked; size: 16px; }
                }
                if root.item.pinned: VerticalLayout {
                    alignment: center;
                    Path {
                        width: 14px;
                        height: 14px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: Icons.pin;
                        stroke: Tokens.text-muted;
                        stroke-width: 2px;
                    }
                }
                Caption { text: root.item.time; vertical-alignment: center; }
            }
            HorizontalLayout {
                spacing: Tokens.space-s;
                Text {
                    text: root.item.blocked ? @tr("Blocked") : root.item.state == 1 ? @tr("Wants to talk") : root.item.state == 0 ? @tr("Waiting for them to accept") : root.item.preview;
                    font-size: Tokens.type-secondary;
                    color: Tokens.text-muted;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.item.unread > 0: Rectangle {
                    min-width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    // Muted: the count is still there, without the Pine.
                    background: root.item.muted ? Tokens.hairline : Tokens.pine;
                    Text {
                        text: root.item.unread;
                        font-size: Tokens.type-caption;
                        font-weight: 600;
                        color: root.item.muted ? Tokens.text : Tokens.on-pine;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// A labelled on/off switch filling one row.
// One choice in a row of them (chat folders over the list).
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> chosen;
    callback clicked();
    min-height: Tokens.space-touch-target-min;
    min-width: max(Tokens.space-touch-target-min, label.preferred-width + 2 * Tokens.space-m);
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: root.chosen ? Tokens.pine : Tokens.hairline;
    background: root.chosen ? Tokens.pine : touch.has-hover ? Tokens.bubble-in : transparent;
    accessible-role: button;
    accessible-checkable: true;
    accessible-checked: root.chosen;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    label := Text {
        text: root.text;
        font-size: Tokens.type-secondary;
        font-weight: 600;
        color: root.chosen ? Tokens.on-pine : Tokens.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        key-pressed(e) => {
            if e.text == " " || e.text == "\n" { root.clicked(); return accept; }
            reject
        }
    }
    if focus.has-focus: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: self.height / 2;
        border-width: Tokens.icon-focus-ring-width;
        border-color: Tokens.focus-ring;
    }
}

// How many people an invite link works for (1 to 20).
component UsesStepper inherits HorizontalLayout {
    in-out property <int> uses: 1;
    spacing: Tokens.space-s;
    alignment: start;
    Secondary {
        text: root.uses == 1 ? @tr("Works for 1 person") : @tr("Works for {} people", root.uses);
        vertical-alignment: center;
    }
    QuietButton {
        text: "−";
        outlined: true;
        accessible-label: @tr("Fewer people");
        clicked => { root.uses = max(1, root.uses - 1); }
    }
    QuietButton {
        text: "+";
        outlined: true;
        accessible-label: @tr("More people");
        clicked => { root.uses = min(20, root.uses + 1); }
    }
}

component SwitchRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> on;
    callback toggled();
    min-height: max(Tokens.space-touch-target-min, row.preferred-height);
    accessible-role: checkbox;
    accessible-checked: root.on;
    accessible-label: root.label;
    accessible-description: root.detail;
    accessible-action-default => { root.toggled(); }
    TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
    row := HorizontalLayout {
        spacing: Tokens.space-m;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Body { text: root.label; }
            Secondary { text: root.detail; }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 26px;
                border-radius: 13px;
                background: root.on ? Tokens.pine : transparent;
                border-width: root.on ? 0px : 2px;
                border-color: Tokens.text-muted;
                Rectangle {
                    x: root.on ? parent.width - self.width - 4px : 4px;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: root.on ? Tokens.on-pine : Tokens.text-muted;
                    animate x { duration: Tokens.reduce-motion ? 0ms : Tokens.motion-duration-default; easing: ease-out; }
                }
            }
        }
    }
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> filled: false;
    callback clicked();
    width: Tokens.space-touch-target-min;
    height: Tokens.space-touch-target-min;
    border-radius: root.filled ? self.width / 2 : Tokens.radius-control;
    background: root.filled ? (touch.pressed ? Tokens.pine.darker(20%) : Tokens.pine) : (touch.has-hover ? Tokens.bubble-in : transparent);
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Path {
        width: 24px;
        height: 24px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        stroke: root.filled ? Tokens.on-pine : Tokens.pine;
        stroke-width: 1.75px;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        key-pressed(e) => {
            if e.text == " " || e.text == "\n" { root.clicked(); return accept; }
            reject
        }
    }
    if focus.has-focus: Rectangle {
        border-radius: parent.border-radius;
        border-width: Tokens.icon-focus-ring-width;
        border-color: Tokens.focus-ring;
    }
}

// A round button of the call screen, with its name under it.
component CallButton inherits VerticalLayout {
    in property <string> icon;
    in property <string> label;
    in property <color> tint: Tokens.surface;
    in property <color> ink: Tokens.text;
    callback clicked();
    spacing: Tokens.space-xs;
    alignment: start;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 64px;
            height: 64px;
            border-radius: self.width / 2;
            background: touch.pressed ? root.tint.darker(20%) : touch.has-hover ? root.tint.darker(8%) : root.tint;
            accessible-role: button;
            accessible-label: root.label;
            accessible-action-default => { root.clicked(); }
            Path {
                width: 28px;
                height: 28px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
                stroke: root.ink;
                stroke-width: 1.75px;
            }
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.clicked(); }
            }
            focus := FocusScope {
                key-pressed(e) => {
                    if e.text == " " || e.text == "\n" { root.clicked(); return accept; }
                    reject
                }
            }
            if focus.has-focus: Rectangle {
                border-radius: parent.border-radius;
                border-width: Tokens.icon-focus-ring-width;
                border-color: Tokens.focus-ring;
            }
        }
    }
    Text {
        text: root.label;
        color: #ffffffd9;
        font-size: Tokens.type-caption;
        horizontal-alignment: center;
    }
}

// A small rounded button on the call screen's dark background.
component CallPill inherits Rectangle {
    in property <string> text;
    in property <color> tint: #ffffff26;
    in property <color> ink: #ffffff;
    callback clicked();
    height: 36px;
    min-width: label.preferred-width + 2 * Tokens.space-m;
    border-radius: self.height / 2;
    background: touch.pressed ? root.tint.darker(20%) : touch.has-hover ? root.tint.darker(8%) : root.tint;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    label := Text {
        text: root.text;
        color: root.ink;
        font-size: Tokens.type-caption;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        key-pressed(e) => {
            if e.text == " " || e.text == "\n" { root.clicked(); return accept; }
            reject
        }
    }
    if focus.has-focus: Rectangle {
        border-radius: parent.border-radius;
        border-width: Tokens.icon-focus-ring-width;
        border-color: Tokens.focus-ring;
    }
}

// A group call's people, as a grid of tiles: a picture or initials, the
// name, a raised hand, a passing reaction.
component CallGrid inherits Rectangle {
    in property <[CallPeerTile]> peers;
    property <int> n: root.peers.length;
    property <int> cols: root.n <= 1 ? 1 : root.n <= 4 ? 2 : root.n <= 9 ? 3 : root.n <= 16 ? 4 : 6;
    property <int> rows: Math.max(1, Math.ceil(root.n / root.cols));
    property <length> gap: Tokens.space-s;
    property <length> cell-w: (root.width - (root.cols - 1) * root.gap) / root.cols;
    property <length> cell-h: Math.min(root.cell-w * 3 / 4, (root.height - (root.rows - 1) * root.gap) / root.rows);
    for p[i] in root.peers: Rectangle {
        x: Math.mod(i, root.cols) * (root.cell-w + root.gap);
        y: Math.floor(i / root.cols) * (root.cell-h + root.gap);
        width: root.cell-w;
        height: root.cell-h;
        border-radius: Tokens.radius-control;
        clip: true;
        background: #1b2a22;
        accessible-role: groupbox;
        accessible-label: p.hand ? @tr("{}, hand raised", p.name) : p.name;
        if p.has-picture: Image {
            width: 100%;
            height: 100%;
            source: p.picture;
            image-fit: cover;
            accessible-role: image;
            accessible-label: @tr("{}'s video", p.name);
        }
        if !p.has-picture: Avatar {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 8px;
            initials: p.initials;
            tint: p.tint;
            size: Math.min(parent.height / 2, 88px);
        }
        Rectangle {
            x: 0;
            y: parent.height - self.height;
            height: 28px;
            background: #00000073;
            Text {
                x: Tokens.space-s;
                width: parent.width - 2 * Tokens.space-s;
                text: p.name;
                color: #ffffff;
                font-size: Tokens.type-caption;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if p.hand: Rectangle {
            x: Tokens.space-s;
            y: Tokens.space-s;
            width: 32px;
            height: 32px;
            border-radius: self.width / 2;
            background: Tokens.saffron;
            Path {
                width: 20px;
                height: 20px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Icons.hand;
                stroke: #101914;
                stroke-width: 1.75px;
            }
        }
        if p.reaction != "": Text {
            x: parent.width - self.width - Tokens.space-s;
            y: Tokens.space-xs;
            text: p.reaction;
            font-size: 32px;
            accessible-role: text;
            accessible-label: @tr("{} reacted {}", p.name, p.reaction);
        }
    }
}

component SheetFrame inherits Rectangle {
    in property <string> title;
    in property <length> max-card-width: 520px;
    callback close();
    background: #0000008c;
    accessible-role: groupbox;
    accessible-label: root.title;
    TouchArea { clicked => { root.close(); } }
    card := Rectangle {
        width: min(root.width - 2 * Tokens.space-m, root.max-card-width);
        // As tall as its content, up to the window; beyond that the body
        // scrolls under a fixed title row.
        height: min(root.height - 2 * Tokens.space-m, frame.padding-top + head.preferred-height + Tokens.space-m + inner.preferred-height);
        background: Tokens.surface;
        border-radius: Tokens.radius-sheet;
        clip: true;
        TouchArea { }
        frame := VerticalLayout {
            padding-top: Tokens.space-l;
            spacing: Tokens.space-m;
            head := HorizontalLayout {
                padding-left: Tokens.space-l;
                padding-right: Tokens.space-l;
                spacing: Tokens.space-s;
                Title { text: root.title; vertical-alignment: center; horizontal-stretch: 1; }
                IconButton { icon: Icons.close; label: @tr("Close"); clicked => { root.close(); } }
            }
            body := Flickable {
                vertical-stretch: 1;
                content-width: self.width;
                content-height: inner.preferred-height;
                inner := VerticalLayout {
                    x: 0;
                    y: 0;
                    width: body.width;
                    padding-left: Tokens.space-l;
                    padding-right: Tokens.space-l;
                    padding-bottom: Tokens.space-l;
                    spacing: Tokens.space-m;
                    @children
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: @tr("Enclave");
    // Rendered by `cargo xtask icons` from design/icon/enclave.svg.
    icon: @image-url("../../../packaging/icons/png/enclave-256.png");
    preferred-width: 1180px;
    preferred-height: 780px;
    min-width: 360px;
    min-height: 560px;
    background: Tokens.background;
    default-font-family: "Atkinson Hyperlegible Next";
    default-font-size: Tokens.type-body;

    in-out property <Screen> screen: Screen.welcome;
    in-out property <Sheet> sheet: Sheet.none;
    // The call (docs/11-calls.md): 0 none, 1 calling, 2 ringing, 3
    // connecting, 4 on, 5 just ended.
    in property <int> call-state;
    in property <string> call-name;
    in property <string> call-initials;
    in property <color> call-tint: Tokens.pine;
    in property <bool> call-video;
    in property <bool> call-muted;
    in property <string> call-words;
    in property <string> call-note;
    in-out property <int> call-elapsed;
    in property <bool> call-camera;
    // The call shrunk to a tile over the app (picture in picture), while
    // it rings out, connects or is on.
    in-out property <bool> call-small;
    in-out property <image> call-remote;
    in-out property <bool> call-has-remote;
    // The other person shares their screen (their picture is the screen's
    // size).
    in-out property <bool> call-remote-screen;
    in-out property <image> call-self;
    callback start-call(string, bool, bool);
    callback answer-call-direct();
    // The caller asked for a direct call (while it rings), and the media
    // goes directly now.
    // Voice notes: recording one (and for how long), and which one plays
    // ("conversation:seq").
    in-out property <bool> voice-recording;
    in-out property <int> voice-recording-secs;
    in-out property <string> voice-playing;
    // Voice-note transcription's model: 0 not here, 1 downloading, 2 ready;
    // how much has come; why the last download failed.
    in property <int> transcription;
    in property <int> transcription-percent;
    in property <string> transcription-error;
    callback transcription-model(bool);
    callback transcribe(string, string);
    callback record-voice();
    callback stop-voice(bool);
    callback play-voice(string, string);
    callback stop-playing();
    in property <bool> call-direct-asked;
    in property <bool> call-direct;
    // A group call: who is heard in it, our raised hand, and whether the
    // open group has a call going on we could join.
    in property <bool> call-group;
    in property <bool> call-hand;
    in property <bool> call-cameras-full;
    // We share the screen instead of the camera (a video call).
    in property <bool> call-screen;
    callback screen-call(bool);
    in-out property <[CallPeerTile]> call-peers;
    in property <bool> current-call-live;
    callback start-group-call(string, bool);
    callback join-group-call(string);
    callback hand-call(bool);
    callback react-call(string);
    // A call link for the group call: ours to share, who waits in its
    // lobby, and the choice of kind while it's being made.
    in property <string> call-link;
    in property <[CallPeerTile]> call-knocks;
    in-out property <bool> call-link-choosing;
    callback create-call-link(bool);
    callback admit-call(int);
    callback refuse-call(int);
    // The pre-call sheet: a video call, and the unchecked-contact warning
    // already shown.
    in-out property <bool> call-route-video;
    in-out property <bool> call-route-warned;
    callback camera-call(bool);
    callback answer-call();
    callback decline-call();
    callback end-call();
    callback mute-call(bool);
    in property <string> my-name;
    in property <string> my-initials;
    in property <color> my-tint: Tokens.pine;
    in property <[ContactRow]> contacts;
    in property <[ContactRow]> requests;
    in property <[ContactRow]> archived;
    in-out property <bool> show-archived;
    callback conv-prefs(string, bool, bool, bool);
    callback set-on-record(bool);
    callback block(string, bool);
    callback share-contact(string, string);
    callback add-shared(string, string);
    callback share-location(string, string, string, string);
    callback report(string, int, bool, bool, bool);
    callback add-pack(string, string);
    // Stickers: remove an added pack; look at a pack before adding it.
    callback remove-pack(string);
    callback preview-pack(string, string);
    in-out property <string> pack-conversation;
    in-out property <string> pack-seq;
    in property <string> pack-preview-title;
    in property <[StickerCell]> pack-preview-cells;
    callback send-sticker(string, string, int);
    callback load-stickers();
    in property <bool> typing-setting;
    in property <bool> receipts-setting: true;
    callback set-receipts-setting(bool);
    in property <bool> typing;
    // In a group: who ("Ana, Ben").
    in property <string> typing-who;
    callback set-typing-setting(bool);
    in property <bool> can-change-words;
    in property <string> held-moves;
    in property <bool> words-pending;
    in property <int> moved;
    callback change-words();
    callback play-clip(string, string);
    in-out property <[image]> player-frames;
    in-out property <int> player-index;
    in property <duration> player-interval: 66ms;
    callback draft-changed(string, bool);
    callback create-pack(string, string);
    in property <[StickerPackRow]> sticker-packs;
    in property <[StickerCell]> sticker-cells;
    in-out property <string> pack-title;
    in-out property <string> pack-paths;
    in-out property <string> pack-error;
    in-out property <int> report-reason: 1;
    in-out property <bool> report-quote: true;
    in-out property <bool> report-block: true;
    in-out property <bool> report-costlier: true;
    // "Open in maps": the place, after the sheet that says what it means.
    in-out property <string> map-coordinates;
    in-out property <string> map-label;
    callback open-map(string, string);
    // Phones: "Use my location" fills the fields (or says why not).
    callback locate();
    in-out property <bool> locating;
    in-out property <string> location-note;
    in-out property <string> location-lat;
    // Photos and files in the open conversation.
    in property <int> gallery-count;
    in-out property <string> location-lon;
    in-out property <string> location-name;
    in property <[MessageRow]> messages;
    in-out property <string> current-id;
    in property <ContactRow> current;
    in property <string> my-link;
    in property <image> my-qr;
    in property <[string]> code-groups;
    in property <string> add-error;
    in property <string> my-username;
    in property <bool> usernames;
    in property <string> username-error;
    in-out property <string> username-input;
    in property <bool> busy;
    in property <string> status-line;
    in property <bool> show-delivery-hint: true;
    in-out property <int> privacy: 0;
    in property <[string]> recovery-words;
    // BIP-39 list the words are shown in (`en`, `es`, … `zh-Hant`).
    in property <string> words-language: "en";
    // The security code as 10 words, and whether they're in English.
    in property <[string]> code-words;
    in property <bool> code-words-english;
    callback code-words-english-toggled(bool);
    callback choose-words-language(string);
    in property <[PickRow]> pick;
    in property <[DeviceRow]> devices;
    in property <[string]> link-choices;
    in property <string> link-status;
    in property <bool> can-link;
    in-out property <string> group-name;
    in-out property <string> link-code;
    in property <bool> recovery-saved;
    // Maximum privacy is holding what was written here until all three
    // KEMs protect the conversation.
    in property <bool> finishing;
    in property <bool> gap;
    // The current conversation is on the record; its contact closed their
    // account.
    in property <bool> on-record;
    in property <bool> closed;
    in-out property <string> draft;
    in-out property <string> add-link;
    in-out property <string> add-text;
    in-out property <string> name-input;

    callback get-started();
    callback create-account(string);
    callback select(string);
    callback send(string, string);
    // Answering a message: its position, author and first line, shown
    // above the composer until sent or cancelled.
    in-out property <string> reply-seq;
    in-out property <string> reply-who;
    in-out property <string> reply-text;
    callback send-reply(string, string, string);
    // Forwarding: the message, then the conversation picked.
    in-out property <string> forward-seq;
    callback forward(string, string, string);
    // The group composer's member list (@ mentions).
    in-out property <bool> mention-open;
    // The message the emoji sheet reacts to.
    in-out property <string> react-seq;
    // "Open with…": the message whose file waits for the warning's answer.
    in-out property <string> confirm-open-seq;
    callback open-file(string, string);
    callback accept(string);
    callback decline(string);
    callback add-contact(string, string);
    callback claim-username(string);
    callback remove-device(string);
    callback send-history(string);
    callback start-join();
    callback sheet-changed(Sheet);
    changed sheet => { root.sheet-changed(root.sheet); }
    // A call that rings, ends or goes away comes back to the full screen.
    changed call-state => {
        if root.call-state != 1 && root.call-state != 3 && root.call-state != 4 {
            root.call-small = false;
        }
    }
    callback cancel-join();
    in property <bool> can-join;
    in property <string> join-code;
    in property <image> join-qr;
    in property <string> join-words;
    in property <string> recovery-alert;
    in property <string> recovery-hold;
    in property <bool> recovery-stopped;
    in property <string> username-problem;
    in property <string> kt-split;
    in property <string> clock-skew;
    in property <string> new-device;
    // 0 the mixnet, 1 offer the backup route, 2 on the backup route.
    in property <int> route;
    // Censorship mode: Tor didn't come up; the bridges set (empty,
    // "builtin" or lines), why some weren't taken, and whether they wait
    // for a restart.
    in property <bool> tor-blocked;
    in property <string> bridges;
    in property <string> bridges-error;
    in property <bool> bridges-restart;
    in-out property <string> bridges-input;
    in property <string> joining;
    in property <string> restore-error;
    in property <[PickRow]> friends;
    in property <int> friends-chosen;
    in property <[string]> share-holders;
    in property <int> share-threshold;
    in property <bool> holds-share;
    in property <string> share-release;
    in property <string> share-release-words;
    in property <image> share-release-qr;
    in-out property <string> share-request-input;
    in property <string> share-request;
    in property <string> share-request-words;
    in property <image> share-request-qr;
    in-out property <string> restore-words;
    in-out property <string> restore-s1;
    in-out property <string> restore-s2;
    in-out property <string> restore-s3;
    in-out property <string> restore-s4;
    in-out property <string> restore-s5;
    in-out property <string> restore-file;
    callback restore(string, string, string, string, string, string, string);
    callback save-backup(bool);
    callback set-server-backup(bool);
    // Open the system's file dialog for a path field: 0 the backup to
    // restore, 1 a backup to check, 2 a file to send, 3 sticker pictures.
    callback browse(int);
    // Scanning a code with the camera into a field: 1 add, 2 meet in
    // person, 3 a friend's new device (recovery share), 4 linking a device,
    // 10 the next empty share field when restoring.
    in property <bool> can-scan: true;
    in-out property <bool> scanning;
    in property <image> scan-frame;
    in property <string> scan-error;
    callback scan(int);
    callback stop-scan();
    // The servers to pick from, and what picking is for: 0 setting up,
    // 1 moving the account, 2 voting to move the open group.
    in property <[ServerOption]> servers;
    in property <string> home-id;
    in property <string> home-label;
    in property <bool> moving;
    in property <bool> can-move;
    in property <string> group-host;
    in property <string> group-host-label;
    in property <string> group-vote-label;
    in property <int> group-admins;
    in-out property <int> server-pick-for;
    in-out property <string> chosen-server;
    callback pick-server(int, string);
    // About: this build's version, and the open-source notices, loaded
    // when their sheet opens.
    in property <string> version;
    // This computer keeps Enclave's keys in files (no keyring).
    in property <bool> file-keys;
    // Screen security: the window is kept out of screen capture where the
    // platform can (can-hide-capture).
    in-out property <bool> screen-security: true;
    in property <bool> can-hide-capture;
    // Which platform's wording (0 Linux, 1 Windows, 2 macOS, 3 Android,
    // 4 iOS), and whether Windows refused (older than version 2004).
    in property <int> capture-platform;
    // Linux without Landlock: the vault's files aren't confined (PC-46).
    in property <bool> sandbox-weak;
    // The open group: only admins post.
    in property <bool> announcement-only;
    callback set-announcement-only(bool);
    // Chat folders: each with whether the open conversation is in it, and
    // the one the list shows (empty: all).
    in property <[FolderRow]> folders;
    in property <string> folder;
    in-out property <string> new-folder-name;
    callback new-folder(string);
    callback delete-folder(string);
    callback in-folder(string, bool);
    callback show-folder(string);
    // Android may stop the app to save battery; and its setting.
    in property <bool> battery-restricted;
    callback open-battery-settings();
    in property <bool> capture-failed;
    callback set-screen-security(bool);
    // Touch ID or Windows Hello for the app lock: its name where set up.
    in property <string> biometric;
    in property <bool> biometric-on;
    callback unlock-biometric();
    callback set-biometric(bool);
    in property <[LicenceEntry]> licences;
    callback load-licences();
    // Release updates (docs/19-ops.md §1): a newer release the vault
    // checked, whether this version is below a release's minimum (1: no
    // sending; 2: no receiving either), whether this install updates
    // itself, else how it is updated, and what the updater is doing.
    in property <string> update-release;
    in property <int> update-required;
    in property <bool> can-self-update;
    in property <string> update-how;
    in-out property <string> update-progress;
    in property <string> build-check;
    callback get-update();
    callback check-updates();
    callback verify-build();
    // Crash reports kept on this device; nothing is sent unless chosen.
    in property <[CrashRow]> crash-reports;
    // Whether this build knows where Enclave Support is.
    in property <bool> support-known;
    callback save-crash(int);
    callback send-crash(int);
    callback delete-crash(int);
    callback delete-crashes();
    callback check-backup(string, string);
    in-out property <bool> backup-media;
    in property <bool> server-backup;
    in property <string> server-backup-at;
    in property <string> backup-check;
    in-out property <string> check-words;
    in-out property <string> check-file;
    callback give-shares(int);
    callback reveal-share(string);
    callback release-share(string);
    callback delete-account();
    callback set-root-pin(string);
    callback secure-account();
    callback set-previews(bool);
    in property <bool> previews;
    // How messages reach the phone with the app closed (Android): 0 stay
    // connected, 1 UnifiedPush, 3 Google's push.
    callback set-delivery(int);
    in property <int> delivery;
    in property <bool> can-unifiedpush;
    in property <bool> can-firebase;
    in property <bool> securing;
    callback unlock-root(string);
    in property <bool> has-root-pin;
    in property <string> pin-error;
    in-out property <string> root-pin-input;
    in-out property <string> new-pin-input;
    callback erase-device();
    in property <bool> removed;
    in-out property <string> delete-confirm;
    callback ask-shares();
    callback new-group-invite(string, int, bool);
    // What the next invite link allows: how many people, and (group links)
    // whether an admin approves each join.
    in-out property <int> invite-uses: 1;
    in-out property <bool> invite-approve: true;
    callback stop-recovery();
    callback backup-route(bool);
    callback set-bridges(string);
    callback meet-scan(string);
    callback search(string);
    callback add-members(string);
    callback unlock(string);
    callback lock-now();
    callback set-app-lock(string);
    callback set-lock-timeout(int);
    callback set-emergency-pin(string);
    // The window is locked by the app PIN (not the passphrase).
    in property <bool> pin-lock;
    // An app PIN is set.
    in property <bool> app-lock;
    // Seconds without use before Enclave locks (0: never).
    in property <int> lock-timeout: 300;
    in-out property <string> app-pin-input;
    in-out property <string> emergency-pin-input;
    callback set-passphrase(string);
    callback new-invite(int);
    callback cancel-invites();
    in property <int> invites;
    in property <string> unlock-error;
    in property <bool> can-lock;
    in-out property <string> passphrase-input;
    in-out property <string> new-passphrase;
    callback remove-member(string, string);
    callback set-group-admin(string, string, bool);
    callback leave-group(string);
    in property <[ContactRow]> members;
    in property <[PickRow]> addable;
    in property <bool> group-admin;
    in-out property <string> confirm-leave;
    in property <[ContactRow]> search-results;
    in-out property <string> search-query;
    callback react(string, string, string);
    callback pin(string, string, bool);
    // The open conversation's pinned messages, most recently pinned first.
    in property <[string]> pins;
    in property <[string]> pin-seqs;
    // The pinned messages listed, a message to jump to, and how far up from
    // the newest the conversation is scrolled (0: at the newest).
    in-out property <bool> pins-open;
    in-out property <string> jump-seq;
    in-out property <length> scroll-offset;
    callback edit-message(string, string, string);
    callback delete-message(string, string);
    callback set-timer(string, int);
    callback send-file(string, string, string, bool);
    // The gallery: every file in every conversation (asked for, then
    // shown in gallery-rows).
    in-out property <bool> gallery-all;
    in property <[GalleryRow]> gallery-rows;
    callback load-gallery();
    // Open a view-once picture (conversation, seq), after the sheet that
    // says what it means.
    callback open-view-once(string, string);
    in-out property <string> view-once-seq;
    // The next file goes to be viewed once.
    in-out property <bool> attach-view-once;
    // The player shows a view-once picture: nothing to keep.
    in-out property <bool> player-once;
    callback save-file(string, string);
    in property <int> timer;
    in-out property <string> selected-seq;
    in-out property <string> editing-seq;
    // A message whose "Delete for everyone" waits for a second tap.
    in-out property <string> confirm-delete-seq;
    in-out property <string> attach-path;
    in-out property <string> poll-question;
    in-out property <string> poll-a;
    in-out property <string> poll-b;
    in-out property <string> poll-c;
    in-out property <string> poll-d;
    callback create-poll(string, string, string, string, string, string, bool);
    in-out property <bool> poll-anonymous;
    callback vote(string, string, int);
    callback close-poll(string, string);
    in-out property <string> attach-caption;
    in-out property <string> attach-error;
    in-out property <string> file-note;
    callback meet-confirm();
    in property <string> meet-code;
    in property <image> meet-qr;
    in property <string> meet-words;
    in property <string> meet-name;
    in property <string> meet-error;
    in property <string> meet-done;
    in-out property <string> meet-input;
    callback approve-recovery();
    in-out property <string> confirm-remove;
    callback mark-checked(string);
    callback copy-text(string);
    callback set-privacy(int);
    callback open-sheet(Sheet);
    callback words-saved();
    callback toggle-pick(string);
    callback create-group(string);
    callback link-scan(string);
    callback link-pick(int);

    property <bool> wide: root.width >= 760px;
    property <bool> has-current: root.current-id != "";

    // ---------------------------------------------------------------- welcome
    if root.screen == Screen.welcome: VerticalLayout {
        alignment: center;
        padding: Tokens.space-l;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(440px, root.width - 2 * Tokens.space-l);
                spacing: Tokens.space-l;
                HorizontalLayout { alignment: start; Seal { state: SealState.checked; size: 64px; } }
                VerticalLayout {
                    spacing: Tokens.space-s;
                    Text {
                        text: @tr("Talk privately.");
                        font-size: Tokens.type-onboarding;
                        font-weight: 600;
                        color: Tokens.text;
                        wrap: word-wrap;
                    }
                    Body { text: @tr("No phone number. No email. Only the people you choose can reach you."); color: Tokens.text-muted; }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-s;
                    PrimaryButton { text: @tr("Get started"); clicked => { root.get-started(); } }
                    if root.can-join: QuietButton { text: @tr("I already have Enclave"); clicked => { root.start-join(); } }
                }
                if root.can-join: HorizontalLayout {
                    alignment: start;
                    QuietButton { text: @tr("Restore from a backup"); clicked => { root.screen = Screen.restore; } }
                }
            }
        }
    }

    // ---------------------------------------------------------------- restore
    if root.screen == Screen.restore: Flickable {
        VerticalLayout {
            alignment: start;
            padding: Tokens.space-l;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    width: min(480px, root.width - 2 * Tokens.space-l);
                    spacing: Tokens.space-m;
                    ScreenTitle { text: @tr("Bring your account back"); }
                    Secondary { text: @tr("You need your backup file, and either your 24 recovery words or enough shares from the friends who hold them."); }
                    Field { placeholder: @tr("Your 24 recovery words"); mono: true; text <=> root.restore-words; }
                    Caption { text: @tr("Or get your friends' shares: meet each of them, let them scan the code below, and scan the code they show you back, one in each box."); wrap: word-wrap; }
                    if root.share-request == "": HorizontalLayout {
                        alignment: start;
                        QuietButton { text: @tr("Ask a friend in person"); outlined: true; clicked => { root.ask-shares(); } }
                    }
                    if root.share-request != "": HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 296px;
                            height: 296px;
                            background: #ffffff;
                            border-radius: Tokens.radius-control;
                            Image {
                                width: 280px;
                                height: 280px;
                                source: root.share-request-qr;
                                image-rendering: pixelated;
                                accessible-role: image;
                                accessible-label: @tr("Code for a friend who holds part of your recovery");
                            }
                        }
                    }
                    if root.share-request != "": Secondary {
                        text: @tr("Their screen should show: {}. Each friend scans this same code.", root.share-request-words);
                    }
                    Field { placeholder: @tr("Share 1 (the code a friend shows you)"); mono: true; text <=> root.restore-s1; }
                    if root.can-scan: HorizontalLayout {
                        alignment: start;
                        QuietButton { text: @tr("Scan a friend's code"); outlined: true; clicked => { root.scan(10); } }
                    }
                    Field { placeholder: @tr("Share 2"); mono: true; text <=> root.restore-s2; }
                    Field { placeholder: @tr("Share 3 (if needed)"); mono: true; text <=> root.restore-s3; }
                    Field { placeholder: @tr("Share 4 (if needed)"); mono: true; text <=> root.restore-s4; }
                    Field { placeholder: @tr("Share 5 (if needed)"); mono: true; text <=> root.restore-s5; }
                    HorizontalLayout {
                        spacing: Tokens.space-s;
                        Field { placeholder: @tr("Path to your backup file (or leave empty for the one on your server)"); mono: true; text <=> root.restore-file; horizontal-stretch: 1; }
                        QuietButton { text: @tr("Choose…"); outlined: true; accessible-label: @tr("Choose your backup file"); clicked => { root.browse(0); } }
                    }
                    if root.restore-file == "" && root.home-label != "": HorizontalLayout {
                        spacing: Tokens.space-s;
                        Secondary { text: @tr("Your server: {}", root.home-label); horizontal-stretch: 1; }
                        if root.servers.length > 1: QuietButton {
                            text: @tr("Change");
                            accessible-label: @tr("Choose the server your backup is on");
                            clicked => { root.server-pick-for = 0; root.chosen-server = root.home-id; root.sheet = Sheet.servers; }
                        }
                    }
                    if root.restore-error != "": Text {
                        text: root.restore-error;
                        color: Tokens.danger;
                        font-size: Tokens.type-secondary;
                        wrap: word-wrap;
                    }
                    Secondary { text: @tr("Your contacts accept this device after 72 hours, unless one of your other devices stops it. That wait protects you if someone else has your words."); }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-s;
                        PrimaryButton {
                            text: root.busy ? @tr("Restoring…") : (root.restore-file == "" ? @tr("Restore from my server") : @tr("Restore"));
                            enabled: (root.restore-words != "" || (root.restore-s1 != "" && root.restore-s2 != "")) && !root.busy;
                            clicked => { root.restore(root.restore-words, root.restore-s1, root.restore-s2, root.restore-s3, root.restore-s4, root.restore-s5, root.restore-file); }
                        }
                        QuietButton { text: @tr("Back"); clicked => { root.screen = Screen.welcome; } }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------------- name
    if root.screen == Screen.name: VerticalLayout {
        alignment: center;
        padding: Tokens.space-l;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(440px, root.width - 2 * Tokens.space-l);
                spacing: Tokens.space-m;
                ScreenTitle { text: @tr("What should people call you?"); }
                name-field := Field {
                    placeholder: @tr("Your name");
                    text <=> root.name-input;
                    accepted => { if root.name-input != "" && !(root.can-join && root.file-keys && root.new-passphrase == "") { root.create-account(root.name-input); } }
                    init => { self.focus(); }
                }
                Secondary { text: @tr("Only people you talk to can see this."); }
                if root.home-label != "": HorizontalLayout {
                    spacing: Tokens.space-s;
                    Secondary { text: @tr("Your server: {}", root.home-label); horizontal-stretch: 1; }
                    if root.servers.length > 1: QuietButton {
                        text: @tr("Change");
                        accessible-label: @tr("Choose another server");
                        clicked => { root.server-pick-for = 0; root.chosen-server = root.home-id; root.sheet = Sheet.servers; }
                    }
                }
                if root.can-join: Field {
                    placeholder: root.file-keys ? @tr("Passphrase for this computer") : @tr("Passphrase for this computer (optional)");
                    secret: true;
                    text <=> root.new-passphrase;
                }
                if root.can-join && root.file-keys && root.new-passphrase == "": Secondary {
                    text: @tr("This computer has no keyring for Enclave's keys, so they are kept in files. Choose a passphrase: it protects them if someone copies those files.");
                }
                if root.can-join && root.new-passphrase != "": Secondary {
                    text: @tr("You'll type it each time Enclave starts. Nobody can reset it; if you forget it, your recovery words bring your account back.");
                }
                HorizontalLayout {
                    alignment: start;
                    PrimaryButton {
                        text: @tr("Continue");
                        enabled: root.name-input != "" && !(root.can-join && root.file-keys && root.new-passphrase == "");
                        clicked => { root.create-account(root.name-input); }
                    }
                }
            }
        }
    }

    // Keys in files and no passphrase yet (restored, or linked, on a
    // computer without a keyring): one must be set before anything else
    // (PC-45).
    if root.screen == Screen.main && root.can-join && root.file-keys && !root.can-lock: Rectangle {
        background: Tokens.background.with-alpha(0.92);
        TouchArea { }
        VerticalLayout {
            alignment: center;
            padding: Tokens.space-l;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    width: min(440px, root.width - 2 * Tokens.space-l);
                    spacing: Tokens.space-m;
                    ScreenTitle { text: @tr("Choose a passphrase"); }
                    Secondary { text: @tr("This computer has no keyring for Enclave's keys, so they are kept in files. A passphrase protects them if someone copies those files. You'll type it each time Enclave starts; if you forget it, your recovery words bring your account back."); }
                    Field { placeholder: @tr("Passphrase"); secret: true; text <=> root.new-passphrase; }
                    HorizontalLayout {
                        alignment: start;
                        PrimaryButton {
                            text: root.busy ? @tr("Saving…") : @tr("Set");
                            enabled: root.new-passphrase != "" && !root.busy;
                            clicked => { root.set-passphrase(root.new-passphrase); }
                        }
                    }
                }
            }
        }
    }

    // ----------------------------------------------------------------- locked
    if root.screen == Screen.locked: VerticalLayout {
        alignment: center;
        padding: Tokens.space-l;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(440px, root.width - 2 * Tokens.space-l);
                spacing: Tokens.space-m;
                HorizontalLayout { alignment: start; Seal { state: SealState.checked; size: 48px; } }
                ScreenTitle { text: @tr("Enclave is locked"); }
                Secondary { text: root.pin-lock ? @tr("Type your PIN to open Enclave.") : @tr("Type your passphrase to open your messages on this computer."); }
                unlock-field := Field {
                    placeholder: root.pin-lock ? @tr("PIN") : @tr("Passphrase");
                    secret: true;
                    text <=> root.passphrase-input;
                    accepted => { if root.passphrase-input != "" { root.unlock(root.passphrase-input); root.passphrase-input = ""; } }
                    init => { self.focus(); }
                }
                if root.unlock-error != "": Text {
                    text: root.unlock-error;
                    color: Tokens.danger;
                    font-size: Tokens.type-secondary;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-s;
                    PrimaryButton {
                        text: root.busy ? @tr("Opening…") : @tr("Unlock");
                        enabled: root.passphrase-input != "" && !root.busy;
                        clicked => { root.unlock(root.passphrase-input); root.passphrase-input = ""; }
                    }
                    if root.pin-lock && root.biometric-on: QuietButton {
                        text: @tr("Use {}", root.biometric);
                        clicked => { root.unlock-biometric(); }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------- setting up
    if root.screen == Screen.setting-up: VerticalLayout {
        alignment: center;
        padding: Tokens.space-l;
        spacing: Tokens.space-m;
        HorizontalLayout { alignment: center; Seal { size: 48px; } }
        Body { text: @tr("Setting up your private address…"); horizontal-alignment: center; }
        Secondary { text: root.status-line; horizontal-alignment: center; }
    }

    // ------------------------------------------------------ link this device
    if root.screen == Screen.join: VerticalLayout {
        alignment: center;
        padding: Tokens.space-l;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(440px, root.width - 2 * Tokens.space-l);
                spacing: Tokens.space-m;
                ScreenTitle { text: root.join-words == "" ? @tr("Link this device") : @tr("Pick these words"); }
                Secondary {
                    text: root.join-words == ""
                        ? @tr("On the device you already use, open Settings → Your devices and paste this code. Only use it with your own account.")
                        : @tr("Your other device now shows four sets of words. Pick the set that matches these.");
                }
                if root.join-words == "" && root.join-code != "": HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 216px;
                        height: 216px;
                        background: #ffffff;
                        border-radius: Tokens.radius-control;
                        Image {
                            width: 200px;
                            height: 200px;
                            source: root.join-qr;
                            image-rendering: pixelated;
                            accessible-role: image;
                            accessible-label: @tr("QR code of this device's link code");
                        }
                    }
                }
                if root.join-words == "" && root.join-code != "": Text {
                    text: root.join-code;
                    font-family: "Atkinson Hyperlegible Mono";
                    font-size: Tokens.type-caption;
                    color: Tokens.text-muted;
                    overflow: elide;
                }
                if root.join-words != "": Code {
                    text: root.join-words;
                    wrap: word-wrap;
                    accessible-label: @tr("Words: {}", root.join-words);
                }
                if root.status-line != "": Secondary { text: root.status-line; }
                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-s;
                    if root.join-words == "" && root.join-code != "": PrimaryButton { text: @tr("Copy code"); clicked => { root.copy-text(root.join-code); } }
                    QuietButton { text: @tr("Cancel"); clicked => { root.cancel-join(); } }
                }
            }
        }
    }

    // ------------------------------------------------------------------- main
    if root.screen == Screen.main: HorizontalLayout {
        // Conversation list.
        if root.wide || !root.has-current: Rectangle {
            width: root.wide ? 320px : root.width;
            background: Tokens.background;
            VerticalLayout {
                padding: Tokens.space-m;
                spacing: Tokens.space-m;
                HorizontalLayout {
                    spacing: Tokens.space-sm;
                    Avatar { initials: root.my-initials; tint: root.my-tint; size: 36px; }
                    Title { text: root.my-name; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    IconButton {
                        icon: Icons.settings;
                        label: @tr("Settings");
                        clicked => { root.open-sheet(Sheet.settings); }
                    }
                }
                HorizontalLayout {
                    spacing: Tokens.space-s;
                    vertical-stretch: 0;
                    ActionTile { text: @tr("My code"); icon: Icons.qr; horizontal-stretch: 1; clicked => { root.open-sheet(Sheet.my-code); } }
                    ActionTile { text: @tr("Add"); icon: Icons.link; horizontal-stretch: 1; clicked => { root.open-sheet(Sheet.add); } }
                    ActionTile { text: @tr("Group"); icon: Icons.group; horizontal-stretch: 1; clicked => { root.open-sheet(Sheet.new-group); } }
                }
                if root.recovery-alert != "": Notice {
                    title: @tr("Someone is setting up your account on another device");
                    text: @tr("They used your recovery words. If this isn't you, stop it now. Otherwise your contacts will accept that device on {}.", root.recovery-alert);
                    kind: 2;
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-s;
                        PrimaryButton {
                            text: @tr("Stop it");
                            danger: true;
                            enabled: !root.busy;
                            clicked => { root.stop-recovery(); }
                        }
                        QuietButton { text: @tr("It's me"); clicked => { root.approve-recovery(); } }
                    }
                }
                if root.recovery-stopped: Notice {
                    title: @tr("One of your other devices stopped this change");
                    text: @tr("Your contacts won't accept this device, so it can't send. If this was you, link this device from your other one instead.");
                    kind: 2;
                }
                if root.recovery-hold != "" && !root.recovery-stopped: Notice {
                    title: @tr("Your contacts are checking this device");
                    text: @tr("You restored your account without one of your other devices, so contacts wait until {} before accepting it. Approve it from another device to skip the wait. You can read, but not send, until then.", root.recovery-hold);
                    kind: 1;
                }
                if root.removed: Notice {
                    title: @tr("This device was removed from your account");
                    text: @tr("It can't get new messages any more. Erase it to remove your conversations from it.");
                    kind: 2;
                    HorizontalLayout {
                        alignment: start;
                        PrimaryButton { text: @tr("Erase this device"); danger: true; clicked => { root.erase-device(); } }
                    }
                }
                if root.joining != "": Notice {
                    title: @tr("Waiting to join {}", root.joining);
                    text: @tr("An admin needs to let you in. You'll see the group here when they do.");
                    kind: 0;
                }
                if root.tor-blocked && !root.bridges-restart: Notice {
                    title: @tr("This network seems to block Tor");
                    text: @tr("Enclave reaches the private network through Tor, and Tor couldn't connect from here. A bridge can get around the block.");
                    kind: 2;
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-s;
                        PrimaryButton { text: @tr("Use a bridge"); clicked => { root.set-bridges("builtin"); } }
                        QuietButton { text: @tr("Enter my own"); clicked => { root.open-sheet(Sheet.settings); } }
                    }
                }
                if root.bridges-restart: Notice {
                    title: @tr("Restart Enclave to use the new bridge settings");
                    text: @tr("Tor picks up bridges when it starts.");
                    kind: 1;
                }
                if root.route == 1: Notice {
                    title: @tr("Backup route: slower to hide who you talk to");
                    text: @tr("Enclave can't reach the private network. It can use a backup route through Tor until the network is back: your server still can't read your messages, and nobody learns where you are, but someone watching the internet closely could more easily tell when you and your contacts talk.");
                    kind: 1;
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-s;
                        PrimaryButton { text: @tr("Use it"); clicked => { root.backup-route(true); } }
                        QuietButton { text: @tr("Keep waiting"); clicked => { root.backup-route(false); } }
                    }
                }
                if root.route == 2: Notice {
                    title: @tr("On the backup route");
                    text: @tr("Messages go to your server through Tor instead of the private network. Switch back when the private network works again.");
                    kind: 1;
                    HorizontalLayout {
                        alignment: start;
                        QuietButton { text: @tr("Back to the private route"); clicked => { root.backup-route(false); } }
                    }
                }
                if root.kt-split != "": Notice {
                    title: @tr("A username server showed people different lists");
                    text: @tr("{} gave you and one of your contacts two different signed versions of its public list of usernames. Someone may be trying to send you, or them, to the wrong person. Check security codes, ideally in person, before sharing anything private.", root.kt-split);
                    kind: 2;
                }
                if root.new-device != "": Notice {
                    title: @tr("New device linked");
                    text: @tr("Your account was linked to {}. If that wasn't you, remove it now: it can read your new messages.", root.new-device);
                    kind: 1;
                    HorizontalLayout {
                        alignment: start;
                        QuietButton { text: @tr("Your devices"); clicked => { root.open-sheet(Sheet.devices); } }
                    }
                }
                if root.clock-skew != "": Notice {
                    title: @tr("This device's clock is wrong");
                    text: @tr("It is {} compared with the time Enclave's independent witnesses sign. Set the date and time to automatic in your device's settings. Until then, message times may look wrong and some checks may fail.", root.clock-skew);
                    kind: 1;
                }
                if root.username-problem != "": Notice {
                    title: @tr("Your username no longer leads to you");
                    text: @tr("The server's public log now shows {} pointing to someone else, or to no one. Your server may have changed it. Tell your contacts to use your code or invite link, and check security codes before sharing anything private.", root.username-problem);
                    kind: 2;
                    HorizontalLayout {
                        alignment: start;
                        QuietButton { text: @tr("Choose a new username"); clicked => { root.open-sheet(Sheet.settings); } }
                    }
                }
                if root.update-required > 0: Notice {
                    title: @tr("Update Enclave to keep sending messages.");
                    text: root.update-required == 2
                        ? @tr("This version has a serious problem fixed in a newer one. It no longer sends or receives messages until you update.")
                        : @tr("This version has a serious problem fixed in a newer one. Until you update, you can read new messages for 30 days but not send.");
                    kind: 2;
                    if root.can-self-update: HorizontalLayout {
                        alignment: start;
                        QuietButton { text: @tr("Update"); clicked => { root.get-update(); } }
                    }
                    if !root.can-self-update: Secondary { text: root.update-how; }
                    if root.update-progress != "": Caption { text: root.update-progress; }
                }
                if root.update-required == 0 && root.update-release != "": Notice {
                    title: @tr("Enclave {} is available", root.update-release);
                    text: root.can-self-update
                        ? @tr("Before it is installed, the download is checked against the release its maintainers signed and the public log.")
                        : root.update-how;
                    kind: 0;
                    if root.can-self-update: HorizontalLayout {
                        alignment: start;
                        QuietButton { text: @tr("Update"); clicked => { root.get-update(); } }
                    }
                    if root.update-progress != "": Caption { text: root.update-progress; }
                }
                if root.crash-reports.length > 0: Notice {
                    title: @tr("Enclave closed unexpectedly");
                    text: @tr("A report was saved on this device. Nothing was sent. You can read it and choose whether to share it.");
                    kind: 1;
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-s;
                        QuietButton { text: @tr("Read the report"); clicked => { root.open-sheet(Sheet.crashes); } }
                        QuietButton { text: @tr("Delete"); clicked => { root.delete-crashes(); } }
                    }
                }
                if !root.recovery-saved: Notice {
                    title: @tr("Save your recovery words");
                    text: @tr("They bring your account back if you lose this device.");
                    kind: 0;
                    HorizontalLayout {
                        alignment: start;
                        QuietButton { text: @tr("Show words"); clicked => { root.open-sheet(Sheet.recovery); } }
                    }
                }
                Field {
                    placeholder: @tr("Search messages");
                    text <=> root.search-query;
                    edited => { root.search(root.search-query); }
                }
                if root.folders.length > 0 && root.search-query == "": Flickable {
                    height: Tokens.space-touch-target-min;
                    viewport-width: chips.preferred-width;
                    chips := HorizontalLayout {
                        spacing: Tokens.space-s;
                        Chip {
                            text: @tr("All");
                            chosen: root.folder == "";
                            clicked => { root.show-folder(""); }
                        }
                        for f in root.folders: Chip {
                            text: f.name;
                            chosen: root.folder == f.name;
                            clicked => { root.show-folder(f.name); }
                        }
                    }
                }
                Flickable {
                    vertical-stretch: 1;
                    content-height: list.preferred-height;
                    list := VerticalLayout {
                        alignment: start;
                        spacing: 2px;
                        if root.search-query != "": Caption {
                            text: root.search-results.length == 0
                                ? (root.search-query.character-count < 2 ? @tr("Keep typing…") : @tr("No messages found. Search only looks on this device."))
                                : @tr("Messages");
                            font-weight: 600;
                            height: 28px;
                            vertical-alignment: center;
                        }
                        if root.search-query != "": VerticalLayout {
                            spacing: 2px;
                            for h in root.search-results: ContactItem {
                                item: h;
                                selected: false;
                                clicked => { root.select(h.id); }
                            }
                        }
                        if root.search-query == "" && root.requests.length > 0: Caption {
                            text: @tr("Message requests");
                            font-weight: 600;
                            height: 28px;
                            vertical-alignment: center;
                        }
                        if root.search-query == "": VerticalLayout {
                            spacing: 2px;
                            for r in root.requests: ContactItem {
                                item: r;
                                selected: r.id == root.current-id;
                                clicked => { root.select(r.id); }
                            }
                            if root.requests.length > 0 && root.contacts.length > 0: Caption {
                                text: @tr("Conversations");
                                font-weight: 600;
                                height: 28px;
                                vertical-alignment: center;
                            }
                            for c in root.contacts: ContactItem {
                                item: c;
                                selected: c.id == root.current-id;
                                clicked => { root.select(c.id); }
                            }
                            if root.folder != "" && root.contacts.length == 0: Caption {
                                text: @tr("Nothing in this folder yet. Open a conversation's details to add it.");
                                wrap: word-wrap;
                            }
                            if root.archived.length > 0: Rectangle {
                                height: Tokens.space-touch-target-min;
                                border-radius: Tokens.radius-control;
                                background: archived-touch.has-hover ? Tokens.surface : transparent;
                                accessible-role: button;
                                accessible-label: (root.show-archived ? @tr("Hide archived, ") : @tr("Show archived, ")) + root.archived.length;
                                accessible-action-default => { root.show-archived = !root.show-archived; }
                                archived-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.show-archived = !root.show-archived; }
                                }
                                HorizontalLayout {
                                    padding-left: Tokens.space-sm;
                                    padding-right: Tokens.space-sm;
                                    Text {
                                        text: @tr("Archived ({})", root.archived.length);
                                        font-size: Tokens.type-secondary;
                                        font-weight: 600;
                                        color: Tokens.pine;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Caption { text: root.show-archived ? @tr("Hide") : @tr("Show"); vertical-alignment: center; }
                                }
                            }
                            if root.show-archived: VerticalLayout {
                                spacing: 2px;
                                for c in root.archived: ContactItem {
                                    item: c;
                                    selected: c.id == root.current-id;
                                    clicked => { root.select(c.id); }
                                }
                            }
                        }
                    }
                }
                Caption { text: root.status-line; wrap: word-wrap; }
            }
        }
        if root.wide: Rectangle { width: 1px; background: Tokens.hairline; }

        // Conversation.
        if root.wide || root.has-current: Rectangle {
            horizontal-stretch: 1;
            background: Tokens.background;

            if !root.has-current: VerticalLayout {
                alignment: center;
                padding: Tokens.space-xl;
                spacing: Tokens.space-m;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: min(420px, parent.width - 2 * Tokens.space-xl);
                        spacing: Tokens.space-m;
                        Title { text: root.contacts.length + root.requests.length == 0 ? @tr("Start your first conversation") : @tr("Choose a conversation"); }
                        Secondary {
                            text: @tr("Show your code to someone next to you, or send them your invite link. Meeting in person is the strongest way to check it's really them.");
                        }
                    }
                }
            }

            if root.has-current: VerticalLayout {
                // Header.
                Rectangle {
                    height: 72px;
                    HorizontalLayout {
                        padding-left: Tokens.space-m;
                        padding-right: Tokens.space-m;
                        spacing: Tokens.space-sm;
                        if !root.wide: VerticalLayout {
                            alignment: center;
                            IconButton { icon: Icons.back; label: @tr("Back"); clicked => { root.current-id = ""; } }
                        }
                        VerticalLayout {
                            alignment: center;
                            Avatar { initials: root.current.initials; tint: root.current.tint; art: root.current.art; art-tint: root.current.art-tint; size: 40px; }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Title { text: root.current.name; overflow: elide; wrap: no-wrap; }
                            HorizontalLayout {
                                spacing: Tokens.space-xs;
                                if root.current.kind == 0: Seal { state: root.current.verified ? SealState.checked : SealState.unchecked; size: 16px; }
                                if root.typing && root.current.kind == 0: Caption {
                                    text: @tr("typing…");
                                    color: Tokens.pine;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    accessible-label: @tr("{} is typing", root.current.name);
                                }
                                if root.typing && root.current.kind == 1: Caption {
                                    text: @tr("{} typing…", root.typing-who);
                                    color: Tokens.pine;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    accessible-label: @tr("{} typing", root.typing-who);
                                }
                                if !(root.typing && root.current.kind <= 1): Caption {
                                    text: root.current.kind == 2
                                        ? @tr("Only you, on your devices")
                                        : root.current.kind == 1
                                        ? root.current.members + (root.on-record ? @tr(" people · On the record") : @tr(" people · Off the record"))
                                        : (root.current.met ? @tr("Met in person") : root.current.verified ? @tr("Checked") : @tr("Not checked yet")) + (root.on-record ? @tr(" · On the record") : @tr(" · Off the record"));
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                        if root.current.state == 2: VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: Icons.more;
                                label: @tr("Conversation settings");
                                clicked => { root.open-sheet(Sheet.conversation); }
                            }
                        }
                        if root.current.kind == 1 && root.current-call-live && root.call-state == 0: VerticalLayout {
                            alignment: center;
                            QuietButton {
                                text: @tr("Join call");
                                clicked => { root.join-group-call(root.current-id); }
                            }
                        }
                        if root.current.kind == 1 && !root.current-call-live && root.call-state == 0: VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: Icons.phone;
                                label: @tr("Call the group");
                                clicked => { root.start-group-call(root.current-id, false); }
                            }
                        }
                        if root.wide && root.current.kind == 1 && !root.current-call-live && root.call-state == 0: VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: Icons.video;
                                label: @tr("Video call the group");
                                clicked => { root.start-group-call(root.current-id, true); }
                            }
                        }
                        if root.current.kind == 1: VerticalLayout {
                            alignment: center;
                            QuietButton {
                                text: @tr("Members");
                                clicked => { root.open-sheet(Sheet.members); }
                            }
                        }
                        // On a phone the timer lives in the conversation sheet.
                        if root.wide && root.current.state == 2 && root.current.kind == 0: VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: Icons.timer;
                                label: root.timer > 0 ? @tr("Disappearing messages: on") : @tr("Disappearing messages: off");
                                clicked => { root.open-sheet(Sheet.timer); }
                            }
                        }
                        if root.current.state == 2 && root.current.kind == 0: VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: Icons.phone;
                                label: @tr("Call {}", root.current.name);
                                clicked => { root.call-route-video = false; root.call-route-warned = false; root.sheet = Sheet.call-route; }
                            }
                        }
                        // On a phone, video calls start from the conversation sheet.
                        if root.wide && root.current.state == 2 && root.current.kind == 0: VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: Icons.video;
                                label: @tr("Video call {}", root.current.name);
                                clicked => { root.call-route-video = true; root.call-route-warned = false; root.sheet = Sheet.call-route; }
                            }
                        }
                        if root.current.state == 2 && root.current.kind == 0: VerticalLayout {
                            alignment: center;
                            QuietButton {
                                text: !root.wide ? @tr("Code") : root.current.verified ? @tr("Security code") : @tr("Check code");
                                clicked => { root.open-sheet(Sheet.check-code); }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.hairline; }
                }

                // Pinned messages: the most recent one, and how many; tapped,
                // all of them, each a way to its message.
                if root.pins.length > 0: Rectangle {
                    background: Tokens.surface;
                    accessible-role: button;
                    accessible-label: (root.pins.length == 1 ? @tr("Pinned message: ") : @tr("{} pinned messages. Latest: ", root.pins.length)) + root.pins[0];
                    accessible-action-default => { root.pins-open = !root.pins-open; }
                    TouchArea { clicked => { root.pins-open = !root.pins-open; } }
                    HorizontalLayout {
                        padding-left: Tokens.space-m;
                        padding-right: Tokens.space-m;
                        padding-top: Tokens.space-s;
                        padding-bottom: Tokens.space-s;
                        spacing: Tokens.space-sm;
                        Rectangle { width: 3px; border-radius: 1.5px; background: Tokens.pine; }
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Caption { text: root.pins.length == 1 ? @tr("Pinned") : @tr("Pinned · {}", root.pins.length); }
                            Text {
                                text: root.pins[0];
                                font-size: Tokens.type-secondary;
                                color: Tokens.text;
                                overflow: elide;
                                wrap: no-wrap;
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.hairline; }
                }
                if root.pins.length > 0 && root.pins-open: VerticalLayout {
                    padding-left: Tokens.space-m;
                    padding-right: Tokens.space-m;
                    padding-bottom: Tokens.space-s;
                    spacing: 2px;
                    for p[i] in root.pins: Rectangle {
                        min-height: 36px;
                        border-radius: Tokens.radius-control;
                        background: pin-touch.has-hover ? Tokens.surface : transparent;
                        accessible-role: button;
                        accessible-label: @tr("Go to pinned message: {}", p);
                        accessible-action-default => { root.jump-seq = root.pin-seqs[i]; root.selected-seq = root.pin-seqs[i]; root.pins-open = false; }
                        pin-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.jump-seq = root.pin-seqs[i]; root.selected-seq = root.pin-seqs[i]; root.pins-open = false; }
                        }
                        HorizontalLayout {
                            padding-left: Tokens.space-s;
                            Text { text: p; font-size: Tokens.type-secondary; color: Tokens.text; overflow: elide; wrap: no-wrap; vertical-alignment: center; }
                        }
                    }
                }

                // Messages.
                flick := Flickable {
                    vertical-stretch: 1;
                    content-height: max(self.height, thread.preferred-height);
                    content-y: min(0px, self.height - self.content-height + root.scroll-offset);
                    thread := VerticalLayout {
                        alignment: end;
                        padding: Tokens.space-m;
                        spacing: Tokens.space-s;
                        if root.show-delivery-hint && root.current.state == 2 && root.current.kind != 2: Caption {
                            text: @tr("Private delivery takes a few seconds. That pause is part of what hides who you talk to.");
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        for m in root.messages: Bubble {
                            msg: m;
                            bubble-max: min(480px, root.width * 0.7);
                            selected: root.selected-seq == m.seq;
                            tapped => {
                                if root.current.state == 2 && !m.deleted {
                                    root.selected-seq = root.selected-seq == m.seq ? "" : m.seq;
                                }
                            }
                            vote(i) => { root.vote(root.current-id, m.seq, i); }
                            close-poll => { root.close-poll(root.current-id, m.seq); }
                            add-contact => { root.add-shared(root.current-id, m.seq); }
                            copy(t) => { root.copy-text(t); }
                            open-map => {
                                root.map-coordinates = m.location;
                                root.map-label = m.location-label;
                                root.sheet = Sheet.open-map;
                            }
                            add-pack => {
                                root.pack-conversation = root.current-id;
                                root.pack-seq = m.seq;
                                root.preview-pack(root.current-id, m.seq);
                                root.sheet = Sheet.pack-preview;
                            }
                            play-clip => { root.play-clip(root.current-id, m.seq); }
                            open-view-once => {
                                root.view-once-seq = m.seq;
                                root.sheet = Sheet.view-once;
                            }
                            playing: root.voice-playing == root.current-id + ":" + m.seq;
                            jump: root.jump-seq == m.seq;
                            show-quote(seq) => { root.jump-seq = seq; root.selected-seq = seq; }
                            jumped(at) => {
                                // Its top a little below the view's.
                                root.scroll-offset = max(0px, flick.content-height - flick.height - at + Tokens.space-l);
                                root.jump-seq = "";
                            }
                            can-transcribe: root.transcription == 2;
                            transcribe => { root.transcribe(root.current-id, m.seq); }
                            play-voice => {
                                if root.voice-playing == root.current-id + ":" + m.seq {
                                    root.stop-playing();
                                } else {
                                    root.play-voice(root.current-id, m.seq);
                                }
                            }
                        }
                    }
                }

                // A message held back somewhere (RT-24).
                if root.gap && root.current.state == 2: Rectangle {
                    VerticalLayout {
                        padding-left: Tokens.space-m;
                        padding-right: Tokens.space-m;
                        padding-top: Tokens.space-s;
                        Notice {
                            title: @tr("A message may not have arrived");
                            text: @tr("Later messages from {} came over a minute ago, but an earlier one hasn't. If it comes, it's marked “delivered late”. Their app sends it again if it was lost.", root.current.name);
                            kind: 1;
                        }
                    }
                }
                // Request, pending or composer.
                if root.current.state == 1: Rectangle {
                    VerticalLayout {
                        padding: Tokens.space-m;
                        Notice {
                            title: @tr("{} wants to talk", root.current.name);
                            text: @tr("You haven't talked before. They can't see whether you've read this until you accept. The name is what they typed; check their security code before sharing anything private.");
                            HorizontalLayout {
                                spacing: Tokens.space-s;
                                alignment: start;
                                PrimaryButton { text: @tr("Accept"); clicked => { root.accept(root.current-id); } }
                                QuietButton { text: @tr("Delete"); danger: true; clicked => { root.decline(root.current-id); } }
                                QuietButton {
                                    text: @tr("Block");
                                    danger: true;
                                    accessible-label: @tr("Block {}", root.current.name);
                                    clicked => { root.block(root.current-id, true); }
                                }
                                QuietButton {
                                    text: @tr("Report");
                                    danger: true;
                                    accessible-label: @tr("Report {}", root.current.name);
                                    clicked => { root.open-sheet(Sheet.report); }
                                }
                            }
                        }
                    }
                }
                if root.current.state == 0: Rectangle {
                    VerticalLayout {
                        padding: Tokens.space-m;
                        Notice {
                            title: @tr("Waiting for {} to accept", root.current.name);
                            text: @tr("You can write again once they accept your request.");
                        }
                    }
                }
                // Actions on the selected message.
                if root.current.state == 2 && root.selected-seq != "": Rectangle {
                    background: Tokens.surface;
                    Rectangle { y: 0; height: 1px; background: Tokens.hairline; }
                    HorizontalLayout {
                        padding-left: Tokens.space-m;
                        padding-right: Tokens.space-m;
                        padding-top: Tokens.space-s;
                        spacing: Tokens.space-xs;
                        for e in root.current.kind == 2 ? [] : ["👍", "❤", "😂", "😮", "😢", "🙏"]: Rectangle {
                            width: Tokens.space-touch-target-min;
                            height: Tokens.space-touch-target-min;
                            border-radius: Tokens.radius-control;
                            background: react-touch.has-hover ? Tokens.bubble-in : transparent;
                            accessible-role: button;
                            accessible-label: @tr("React {}", e);
                            accessible-action-default => {
                                root.react(root.current-id, root.selected-seq, e);
                                root.selected-seq = "";
                            }
                            Text {
                                text: e;
                                font-size: 24px;
                                color: Tokens.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            react-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.react(root.current-id, root.selected-seq, e);
                                    root.selected-seq = "";
                                }
                            }
                        }
                        if root.current.kind != 2: QuietButton {
                            text: "+";
                            accessible-label: @tr("More reactions");
                            clicked => { root.react-seq = root.selected-seq; root.sheet = Sheet.emoji; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        for m in root.messages: HorizontalLayout {
                            spacing: Tokens.space-xs;
                            if m.seq == root.selected-seq && m.my-reaction != "": QuietButton {
                                text: @tr("Take back {}", m.my-reaction);
                                accessible-label: @tr("Take back your reaction");
                                clicked => {
                                    root.react(root.current-id, m.seq, "");
                                    root.selected-seq = "";
                                }
                            }
                            if m.seq == root.selected-seq && root.current.kind != 2 && !m.deleted: QuietButton {
                                text: @tr("Reply");
                                clicked => {
                                    root.reply-seq = m.seq;
                                    root.reply-who = m.outgoing ? @tr("You") : m.sender != "" ? m.sender : root.current.name;
                                    root.reply-text = m.text != "" ? m.text : m.file;
                                    root.editing-seq = "";
                                    root.selected-seq = "";
                                }
                            }
                            if m.seq == root.selected-seq && !m.deleted && !m.sticker && m.poll-state == 0 && m.location == "" && m.contact-name == "": QuietButton {
                                text: @tr("Forward");
                                clicked => {
                                    root.forward-seq = m.seq;
                                    root.selected-seq = "";
                                    root.sheet = Sheet.forward;
                                }
                            }
                            if m.seq == root.selected-seq && root.current.kind != 2: QuietButton {
                                text: m.pinned ? @tr("Unpin") : @tr("Pin");
                                accessible-label: m.pinned ? @tr("Unpin for everyone") : @tr("Pin for everyone");
                                clicked => {
                                    root.pin(root.current-id, m.seq, !m.pinned);
                                    root.selected-seq = "";
                                }
                            }
                            if m.seq == root.selected-seq && m.can-edit: QuietButton {
                                text: @tr("Edit");
                                clicked => {
                                    root.editing-seq = m.seq;
                                    root.draft = m.text;
                                    root.selected-seq = "";
                                }
                            }
                            if m.seq == root.selected-seq && m.outgoing && !m.deleted && root.confirm-delete-seq != m.seq: QuietButton {
                                text: @tr("Delete");
                                danger: true;
                                accessible-label: root.current.kind == 2 ? @tr("Delete note") : @tr("Delete for everyone");
                                clicked => {
                                    if root.current.kind == 2 {
                                        root.delete-message(root.current-id, m.seq);
                                        root.selected-seq = "";
                                    } else {
                                        root.confirm-delete-seq = m.seq;
                                    }
                                }
                            }
                            // Delete for everyone is a request: said so before.
                            if m.seq == root.selected-seq && root.confirm-delete-seq == m.seq: VerticalLayout {
                                spacing: Tokens.space-xs;
                                Secondary { text: @tr("Their app deletes it if it cooperates. Someone may already have copied, saved or seen it."); }
                                HorizontalLayout {
                                    spacing: Tokens.space-s;
                                    QuietButton {
                                        text: @tr("Delete for everyone");
                                        danger: true;
                                        clicked => {
                                            root.delete-message(root.current-id, m.seq);
                                            root.confirm-delete-seq = "";
                                            root.selected-seq = "";
                                        }
                                    }
                                    QuietButton { text: @tr("Cancel"); clicked => { root.confirm-delete-seq = ""; } }
                                }
                            }
                            if m.seq == root.selected-seq && m.file != "" && !m.voice && root.confirm-open-seq != m.seq: QuietButton {
                                text: @tr("Open with…");
                                clicked => { root.confirm-open-seq = m.seq; }
                            }
                            if m.seq == root.selected-seq && root.confirm-open-seq == m.seq: VerticalLayout {
                                spacing: Tokens.space-xs;
                                Secondary {
                                    text: @tr("Files can contain harmful content, and another app may not protect it as Enclave does. Open it only if you trust who sent it and know what it is.");
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: Tokens.space-s;
                                    QuietButton {
                                        text: @tr("Open");
                                        clicked => {
                                            root.open-file(root.current-id, m.seq);
                                            root.confirm-open-seq = "";
                                            root.selected-seq = "";
                                        }
                                    }
                                    QuietButton { text: @tr("Cancel"); clicked => { root.confirm-open-seq = ""; } }
                                }
                            }
                            if m.seq == root.selected-seq && m.file != "": QuietButton {
                                text: @tr("Save");
                                accessible-label: @tr("Save {}", m.file);
                                clicked => {
                                    root.save-file(root.current-id, m.seq);
                                    root.selected-seq = "";
                                }
                            }
                        }
                    }
                }
                if root.moved != 0 && root.current.kind == 0: HorizontalLayout {
                    padding-left: Tokens.space-m;
                    padding-right: Tokens.space-m;
                    Notice {
                        title: root.moved == 1
                            ? @tr("{} changed their recovery words", root.current.name)
                            : @tr("{}'s account moved to a new key", root.current.name);
                        text: root.moved == 1
                            ? @tr("Their security code changed too. Check it again before sharing anything private.")
                            : @tr("Enclave can't confirm it was them who did this. Check the security code in person before sharing anything private.");
                        kind: 1;
                        HorizontalLayout {
                            alignment: start;
                            QuietButton { text: @tr("Check now"); clicked => { root.open-sheet(Sheet.check-code); } }
                        }
                    }
                }
                if root.held-moves != "" && root.current.kind == 1: HorizontalLayout {
                    padding-left: Tokens.space-m;
                    padding-right: Tokens.space-m;
                    Notice {
                        title: @tr("{} changed their recovery words, but this device didn't hear it from them", root.held-moves);
                        text: @tr("Their new key is on hold in this group until it does. Ask them to open Enclave, and check with them another way before sharing anything private.");
                        kind: 1;
                    }
                }
                if root.holds-share && root.current.kind == 0 && root.current.state == 2: HorizontalLayout {
                    padding-left: Tokens.space-m;
                    padding-right: Tokens.space-m;
                    Notice {
                        title: @tr("You hold part of {}'s recovery", root.current.name);
                        text: @tr("If they lose every device, meet them: their new phone shows a code, and you give them your part by scanning it. Only in person.");
                        kind: 0;
                        HorizontalLayout {
                            alignment: start;
                            QuietButton { text: @tr("Help them get back in"); clicked => { root.share-request-input = ""; root.reveal-share(root.current-id); root.open-sheet(Sheet.share); } }
                        }
                    }
                }
                if root.current.state == 2 && root.file-note != "": Caption {
                    text: root.file-note;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if root.current.blocked: Rectangle {
                    VerticalLayout {
                        padding: Tokens.space-m;
                        Notice {
                            title: @tr("You blocked {}", root.current.name);
                            text: @tr("They can't send you messages, and they aren't told. Anything they send is dropped.");
                            HorizontalLayout {
                                alignment: start;
                                QuietButton { text: @tr("Unblock"); outlined: true; clicked => { root.block(root.current-id, false); } }
                            }
                        }
                    }
                }
                if root.closed && root.current.kind == 0: Rectangle {
                    VerticalLayout {
                        padding: Tokens.space-m;
                        Notice {
                            title: @tr("{} closed their account", root.current.name);
                            text: @tr("You can still read this conversation. Nothing more can be sent to them.");
                        }
                    }
                }
                if root.reply-seq != "" && root.current.state == 2: Rectangle {
                    background: Tokens.surface;
                    HorizontalLayout {
                        padding-left: Tokens.space-m;
                        padding-right: Tokens.space-m;
                        padding-top: Tokens.space-s;
                        spacing: Tokens.space-s;
                        Rectangle { width: 3px; background: Tokens.pine; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Caption { text: @tr("Answering {}", root.reply-who); font-weight: 600; }
                            Caption { text: root.reply-text; overflow: elide; }
                        }
                        QuietButton {
                            text: @tr("Cancel");
                            accessible-label: @tr("Don't answer it");
                            clicked => { root.reply-seq = ""; }
                        }
                    }
                }
                if root.mention-open && root.current.kind == 1 && root.current.state == 2: Rectangle {
                    background: Tokens.surface;
                    HorizontalLayout {
                        padding-left: Tokens.space-m;
                        padding-right: Tokens.space-m;
                        padding-top: Tokens.space-s;
                        spacing: Tokens.space-s;
                        for p in root.members: Chip {
                            text: "@" + p.name;
                            chosen: false;
                            clicked => {
                                root.draft = root.draft + (root.draft == "" ? "" : " ") + "@" + p.name + " ";
                                root.mention-open = false;
                            }
                        }
                    }
                }
                // Edits and deletes are advisory: said where they're made.
                if root.editing-seq != "" && root.current.kind != 2: Secondary {
                    x: Tokens.space-m;
                    width: parent.width - 2 * Tokens.space-m;
                    text: @tr("Your edit replaces the text for everyone and shows as edited. Their app may keep the original.");
                }
                if root.current.kind == 1 && root.announcement-only && !root.group-admin: Caption {
                    x: Tokens.space-m;
                    width: parent.width - 2 * Tokens.space-m;
                    text: @tr("Only admins can post in this group.");
                    wrap: word-wrap;
                }
                if root.current.state == 2 && !root.current.blocked && !(root.closed && root.current.kind == 0) && !(root.current.kind == 1 && root.announcement-only && !root.group-admin): Rectangle {
                    HorizontalLayout {
                        padding: Tokens.space-m;
                        spacing: Tokens.space-s;
                        if root.current.kind != 2 && root.editing-seq == "": IconButton {
                            icon: Icons.attach;
                            label: @tr("Send a file");
                            clicked => { root.attach-error = ""; root.open-sheet(Sheet.attach); }
                        }
                        if (root.current.kind == 1 || root.current.kind == 0) && root.editing-seq == "": IconButton {
                            icon: Icons.poll;
                            label: @tr("Ask a question");
                            clicked => { root.open-sheet(Sheet.poll); }
                        }
                        if root.current.kind == 1 && root.members.length > 0: QuietButton {
                            text: "@";
                            accessible-label: @tr("Mention someone");
                            clicked => { root.mention-open = !root.mention-open; }
                        }
                        if root.current.kind != 2 && root.editing-seq == "": IconButton {
                            icon: Icons.sticker;
                            label: @tr("Stickers");
                            clicked => { root.load-stickers(); root.open-sheet(Sheet.stickers); }
                        }
                        if root.voice-recording: HorizontalLayout {
                            horizontal-stretch: 1;
                            spacing: Tokens.space-s;
                            alignment: start;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 5px;
                                background: #b3261e;
                            }
                            Text {
                                text: @tr("Recording ") + Math.floor(root.voice-recording-secs / 60) + ":" + (Math.mod(root.voice-recording-secs, 60) < 10 ? "0" : "") + Math.mod(root.voice-recording-secs, 60);
                                vertical-alignment: center;
                                color: Tokens.text;
                                accessible-role: text;
                            }
                            QuietButton {
                                text: @tr("Cancel");
                                clicked => { root.voice-recording = false; root.stop-voice(false); }
                            }
                        }
                        if !root.voice-recording: composer := Field {
                            placeholder: root.editing-seq != "" ? @tr("Edit your message") : @tr("Message");
                            text <=> root.draft;
                            horizontal-stretch: 1;
                            edited => {
                                if root.current.kind == 0 && root.editing-seq == "" {
                                    root.draft-changed(root.current-id, root.draft != "");
                                }
                            }
                            accepted => {
                                if root.draft != "" {
                                    if root.editing-seq != "" {
                                        root.edit-message(root.current-id, root.editing-seq, root.draft);
                                        root.editing-seq = "";
                                    } else {
                                        if root.reply-seq != "" {
                                            root.send-reply(root.current-id, root.draft, root.reply-seq);
                                            root.reply-seq = "";
                                        } else {
                                            root.send(root.current-id, root.draft);
                                        }
                                        root.mention-open = false;
                                        root.scroll-offset = 0;
                                    }
                                    root.draft = "";
                                }
                            }
                        }
                        if root.editing-seq != "": QuietButton {
                            text: @tr("Cancel");
                            clicked => { root.editing-seq = ""; root.draft = ""; }
                        }
                        if root.draft == "" && root.editing-seq == "" && !root.voice-recording && root.current.kind != 2: IconButton {
                            icon: Icons.voice;
                            label: @tr("Record a voice note");
                            clicked => {
                                root.voice-recording-secs = 0;
                                root.voice-recording = true;
                                root.record-voice();
                            }
                        }
                        if root.voice-recording: IconButton {
                            icon: Icons.send;
                            label: @tr("Send the voice note");
                            filled: true;
                            clicked => { root.voice-recording = false; root.stop-voice(true); }
                        }
                        if !root.voice-recording && !(root.draft == "" && root.editing-seq == "" && root.current.kind != 2): IconButton {
                            icon: Icons.send;
                            label: root.editing-seq != "" ? @tr("Save edit") : @tr("Send");
                            filled: true;
                            clicked => {
                                if root.draft != "" {
                                    if root.editing-seq != "" {
                                        root.edit-message(root.current-id, root.editing-seq, root.draft);
                                        root.editing-seq = "";
                                    } else {
                                        if root.reply-seq != "" {
                                            root.send-reply(root.current-id, root.draft, root.reply-seq);
                                            root.reply-seq = "";
                                        } else {
                                            root.send(root.current-id, root.draft);
                                        }
                                        root.mention-open = false;
                                        root.scroll-offset = 0;
                                    }
                                    root.draft = "";
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ----------------------------------------------------------------- sheets
    if root.sheet == Sheet.emoji: SheetFrame {
        title: @tr("React");
        close => { root.sheet = Sheet.none; }
        for row in [
            ["😀", "😁", "😂", "🤣", "😊", "😍", "😘", "😎"],
            ["🤔", "😮", "😢", "😭", "😡", "😱", "🥳", "😴"],
            ["👍", "👎", "👏", "🙌", "🙏", "💪", "👀", "🤝"],
            ["❤️", "🧡", "💛", "💚", "💙", "💜", "🖤", "💔"],
            ["🔥", "✨", "🎉", "💯", "✅", "❌", "⭐", "☕"],
            ["🐶", "🐱", "🌸", "🌈", "🍕", "🍰", "⚽", "🎵"],
        ]: HorizontalLayout {
            spacing: Tokens.space-xs;
            for e in row: Rectangle {
                width: Tokens.space-touch-target-min;
                height: Tokens.space-touch-target-min;
                border-radius: Tokens.radius-control;
                background: pick-touch.has-hover ? Tokens.bubble-in : transparent;
                accessible-role: button;
                accessible-label: @tr("React {}", e);
                accessible-action-default => { root.react(root.current-id, root.react-seq, e); root.selected-seq = ""; root.sheet = Sheet.none; }
                Text {
                    text: e;
                    font-size: 26px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                pick-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.react(root.current-id, root.react-seq, e); root.selected-seq = ""; root.sheet = Sheet.none; }
                }
            }
        }
        Caption {
            text: @tr("A reaction replaces your earlier one on that message. They see it change.");
            wrap: word-wrap;
        }
    }

    if root.sheet == Sheet.forward: SheetFrame {
        title: @tr("Forward to");
        close => { root.sheet = Sheet.none; }
        Secondary {
            text: @tr("It goes as a new message, marked Forwarded. A file is sent again, sealed afresh.");
            wrap: word-wrap;
        }
        for c in root.contacts: ContactItem {
            item: c;
            selected: false;
            clicked => {
                root.forward(root.current-id, root.forward-seq, c.id);
                root.sheet = Sheet.none;
            }
        }
    }

    if root.sheet == Sheet.my-code: SheetFrame {
        title: @tr("Your code");
        close => { root.sheet = Sheet.none; }
        Secondary { text: @tr("Let someone next to you scan this. For someone who isn't here, copy an invite link: each one works for one person, for 7 days. Either way, they can then send you a message request."); }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 248px;
                height: 248px;
                background: #ffffff;
                border-radius: Tokens.radius-control;
                Image {
                    width: 232px;
                    height: 232px;
                    source: root.my-qr;
                    image-rendering: pixelated;
                    accessible-role: image;
                    accessible-label: @tr("QR code of your contact code");
                }
            }
        }
        if root.my-username != "": HorizontalLayout {
            spacing: Tokens.space-s;
            Secondary { text: @tr("Or they can look you up as"); vertical-alignment: center; horizontal-stretch: 0; }
            Text {
                text: root.my-username;
                font-family: "Atkinson Hyperlegible Mono";
                font-size: Tokens.type-secondary;
                color: Tokens.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        UsesStepper { uses <=> root.invite-uses; }
        HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton { text: @tr("Copy invite link"); enabled: !root.busy; clicked => { root.new-invite(root.invite-uses); } }
            if root.my-username != "": QuietButton { text: @tr("Copy username"); clicked => { root.copy-text(root.my-username); } }
        }
        if root.invites > 0: HorizontalLayout {
            spacing: Tokens.space-s;
            Caption {
                text: root.invites == 1 ? @tr("1 invite link hasn't been used yet.") : @tr("{} invite links haven't been used yet.", root.invites);
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            QuietButton { text: @tr("Cancel them"); horizontal-stretch: 0; clicked => { root.cancel-invites(); } }
        }
    }

    if root.sheet == Sheet.add: SheetFrame {
        title: @tr("Add someone");
        close => { root.sheet = Sheet.none; }
        Secondary { text: root.usernames ? @tr("Paste the invite link they sent you, or type their username.") : @tr("Paste the invite link they sent you."); }
        HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: root.usernames ? @tr("enclave:add#…  or  @name@server") : @tr("enclave:add#…"); mono: true; text <=> root.add-link; horizontal-stretch: 1; }
            if root.can-scan: QuietButton { text: @tr("Scan"); outlined: true; accessible-label: @tr("Scan their invite code with the camera"); clicked => { root.scan(1); } }
        }
        Field { placeholder: @tr("Say hello (optional)"); text <=> root.add-text; }
        if root.add-error != "": HorizontalLayout {
            spacing: Tokens.space-s;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: Tokens.danger;
                Text { text: "!"; color: Tokens.surface; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            }
            Text { text: @tr("Couldn't add them"); color: Tokens.danger; font-size: Tokens.type-body; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
        }
        if root.add-error != "": Text {
            text: root.add-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton {
                text: root.busy ? @tr("Sending request…") : @tr("Send request");
                enabled: root.add-link != "" && !root.busy;
                clicked => { root.add-contact(root.add-link, root.add-text); }
            }
        }
        HorizontalLayout {
            alignment: start;
            QuietButton { text: @tr("Together right now? Meet in person"); outlined: true; clicked => { root.open-sheet(Sheet.meet); } }
        }
    }

    if root.sheet == Sheet.conversation: SheetFrame {
        title: root.current.name;
        close => { root.sheet = Sheet.none; }
        // Contact info: the McEliece braid isn't done (`docs/17-design.md`
        // keeps this off the conversation itself).
        if root.finishing: Notice {
            title: @tr("Extra protection: finishing…");
            text: @tr("Maximum privacy holds what you write until all three kinds of encryption protect this conversation. It goes out on its own once {}'s app has finished setting it up.", root.current.name);
        }
        if root.current.kind == 0 && root.current.state == 2: HorizontalLayout {
            spacing: Tokens.space-s;
            alignment: start;
            QuietButton {
                text: @tr("Video call");
                clicked => { root.call-route-video = true; root.call-route-warned = false; root.sheet = Sheet.call-route; }
            }
        }
        if root.current.kind == 0: SwitchRow {
            label: @tr("On the record");
            detail: root.on-record
                ? @tr("Your messages carry your signature. Anyone who gets a copy can prove you wrote them.")
                : @tr("Nobody can prove to others who wrote these messages.");
            on: root.on-record;
            toggled => { root.set-on-record(!root.on-record); }
        }
        if root.current.kind == 0: Caption {
            text: @tr("Both of you see when this changes, and who changed it.");
            wrap: word-wrap;
        }
        SwitchRow {
            label: @tr("Pin to top");
            detail: @tr("Keep it above your other conversations. Up to 4.");
            on: root.current.pinned;
            toggled => { root.conv-prefs(root.current-id, false, !root.current.pinned, root.current.muted); }
        }
        SwitchRow {
            label: @tr("Mute");
            detail: @tr("New messages are counted quietly and don't bring it back from the archive.");
            on: root.current.muted;
            toggled => { root.conv-prefs(root.current-id, root.current.archived, root.current.pinned, !root.current.muted); }
        }
        SwitchRow {
            label: @tr("Archive");
            detail: @tr("Move it out of your list until someone writes.");
            on: root.current.archived;
            toggled => {
                root.conv-prefs(root.current-id, !root.current.archived, root.current.pinned, root.current.muted);
                if !root.current.archived { root.sheet = Sheet.none; }
            }
        }
        if root.folders.length > 0: Body { text: @tr("Folders"); font-weight: 600; }
        for f in root.folders: SwitchRow {
            label: f.name;
            on: f.on;
            toggled => { root.in-folder(f.name, !f.on); }
        }
        Caption {
            text: @tr("These choices stay on your devices. Nobody in the conversation sees them.");
            wrap: word-wrap;
        }
        if root.gallery-count > 0: HorizontalLayout {
            alignment: start;
            QuietButton {
                text: @tr("Photos and files ({})", root.gallery-count);
                outlined: true;
                clicked => { root.gallery-all = false; root.sheet = Sheet.gallery; }
            }
        }
        if root.current.kind == 0: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            QuietButton {
                text: root.timer > 0 ? @tr("Disappearing messages: on") : @tr("Disappearing messages: off");
                outlined: true;
                clicked => { root.open-sheet(Sheet.timer); }
            }
            QuietButton {
                text: @tr("Report");
                danger: true;
                accessible-label: @tr("Report {}", root.current.name);
                clicked => { root.sheet = Sheet.report; }
            }
            QuietButton {
                text: root.current.blocked ? @tr("Unblock") : @tr("Block");
                danger: !root.current.blocked;
                accessible-label: (root.current.blocked ? @tr("Unblock ") : @tr("Block ")) + root.current.name;
                clicked => {
                    root.block(root.current-id, !root.current.blocked);
                    root.sheet = Sheet.none;
                }
            }
        }
    }

    // The pre-call sheet (`docs/11-calls.md` §4): the private route, or
    // direct with what it shows; a second, stronger warning for a contact
    // whose code wasn't checked.
    if root.sheet == Sheet.call-route: SheetFrame {
        title: root.call-route-video ? @tr("Video call {}", root.current.name) : @tr("Call {}", root.current.name);
        close => { root.sheet = Sheet.none; }
        if !root.call-route-warned: Secondary {
            text: @tr("The private route goes through two relays run by different operators, so neither sees both of you, and {} doesn't see your internet address.", root.current.name);
        }
        if !root.call-route-warned: PrimaryButton {
            text: @tr("Private route");
            clicked => { root.sheet = Sheet.none; root.start-call(root.current-id, root.call-route-video, false); }
        }
        if !root.call-route-warned: QuietButton {
            text: @tr("Call directly");
            clicked => {
                if root.current.verified {
                    root.sheet = Sheet.none;
                    root.start-call(root.current-id, root.call-route-video, true);
                } else {
                    root.call-route-warned = true;
                }
            }
        }
        if !root.call-route-warned: Secondary {
            text: @tr("Directly is clearer, but {} can see your internet address.", root.current.name);
        }
        if root.call-route-warned: Notice {
            kind: 2;
            title: @tr("You haven't checked {}'s security code", root.current.name);
            text: @tr("Direct calls show your internet address to whoever is on the other end. If this isn't really {}, they learn where you are.", root.current.name);
        }
        if root.call-route-warned: PrimaryButton {
            text: @tr("Use the private route");
            clicked => { root.sheet = Sheet.none; root.start-call(root.current-id, root.call-route-video, false); }
        }
        if root.call-route-warned: QuietButton {
            text: @tr("Call directly anyway");
            danger: true;
            clicked => { root.sheet = Sheet.none; root.start-call(root.current-id, root.call-route-video, true); }
        }
    }
    if root.sheet == Sheet.timer: SheetFrame {
        title: @tr("Disappearing messages");
        close => { root.sheet = Sheet.none; }
        Secondary { text: @tr("New messages in this conversation disappear from both phones this long after they're read. Anyone can still take a screenshot."); }
        for option in [
            { label: @tr("Off"), secs: 0 },
            { label: @tr("5 minutes"), secs: 300 },
            { label: @tr("1 hour"), secs: 3600 },
            { label: @tr("1 day"), secs: 86400 },
            { label: @tr("1 week"), secs: 604800 },
        ]: Rectangle {
            height: Tokens.space-touch-target-min;
            border-radius: Tokens.radius-control;
            border-width: root.timer == option.secs ? 2px : 1px;
            border-color: root.timer == option.secs ? Tokens.pine : Tokens.hairline;
            accessible-role: radio-button;
            accessible-checked: root.timer == option.secs;
            accessible-label: option.label;
            accessible-action-default => { root.set-timer(root.current-id, option.secs); }
            TouchArea { clicked => { root.set-timer(root.current-id, option.secs); } }
            HorizontalLayout {
                padding-left: Tokens.space-m;
                spacing: Tokens.space-sm;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        border-width: 2px;
                        border-color: root.timer == option.secs ? Tokens.pine : Tokens.text-muted;
                        if root.timer == option.secs: Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Tokens.pine; }
                    }
                }
                Body { text: option.label; vertical-alignment: center; }
            }
        }
    }

    if root.sheet == Sheet.attach: SheetFrame {
        title: @tr("Send a file");
        close => { root.sheet = Sheet.none; }
        Secondary { text: @tr("Files are sealed before they leave this device and padded so their size doesn't give them away. ") + (root.current.kind == 1 ? @tr("Each member downloads them") : @tr("{} downloads them", root.current.name)) + @tr(" only when they choose to. A WAV recording is sent as a voice note."); }
        HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: @tr("Path to the file"); mono: true; text <=> root.attach-path; horizontal-stretch: 1; }
            QuietButton { text: @tr("Choose…"); outlined: true; accessible-label: @tr("Choose a file to send"); clicked => { root.browse(2); } }
        }
        Field { placeholder: @tr("Add a caption (optional)"); text <=> root.attach-caption; }
        SwitchRow {
            label: @tr("View once");
            detail: @tr("For a picture or animation: it can be opened once, and isn't kept, on either side. A screenshot or another camera can still capture it.");
            on: root.attach-view-once;
            toggled => { root.attach-view-once = !root.attach-view-once; }
        }
        if root.attach-error != "": Text {
            text: root.attach-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? @tr("Sending…") : @tr("Send");
                enabled: root.attach-path != "" && !root.busy;
                clicked => { root.send-file(root.current-id, root.attach-path, root.attach-caption, root.attach-view-once); }
            }
            if root.current.kind == 0: QuietButton {
                text: @tr("Share a contact instead");
                clicked => { root.sheet = Sheet.share-contact; }
            }
            if root.current.kind == 0: QuietButton {
                text: @tr("Share a location");
                clicked => { root.sheet = Sheet.location; }
            }
        }
    }

    if root.sheet == Sheet.stickers: SheetFrame {
        title: @tr("Stickers");
        close => { root.sheet = Sheet.none; }
        if root.sticker-packs.length == 0: Secondary { text: @tr("No sticker packs yet. Make one from your own pictures, or add one from a sticker someone sends you."); }
        for p in root.sticker-packs: VerticalLayout {
            spacing: Tokens.space-xs;
            HorizontalLayout {
                spacing: Tokens.space-s;
                Caption { text: p.title; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                QuietButton {
                    text: @tr("Remove");
                    accessible-label: @tr("Remove the pack {} from this device", p.title);
                    clicked => { root.remove-pack(p.id); }
                }
            }
            Flickable {
                height: 72px;
                content-width: p.count * 76px;
                HorizontalLayout {
                    spacing: 4px;
                    for c in root.sticker-cells: Rectangle {
                        visible: c.pack == p.id;
                        width: self.visible ? 72px : 0px;
                        height: 72px;
                        border-radius: Tokens.radius-control;
                        background: cell-touch.has-hover ? Tokens.bubble-in : transparent;
                        accessible-role: button;
                        accessible-label: @tr("Send sticker {} from {}", (c.index + 1), p.title);
                        accessible-action-default => { root.send-sticker(root.current-id, c.pack, c.index); root.sheet = Sheet.none; }
                        cell-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.send-sticker(root.current-id, c.pack, c.index); root.sheet = Sheet.none; }
                        }
                        if c.has-image: Image {
                            source: c.image;
                            width: 64px;
                            height: 64px;
                            image-fit: contain;
                        }
                        if !c.has-image: Caption { text: c.index + 1; }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            QuietButton { text: @tr("Make a pack"); outlined: true; clicked => { root.pack-error = ""; root.sheet = Sheet.new-pack; } }
        }
    }

    if root.sheet == Sheet.new-pack: SheetFrame {
        title: @tr("Make a sticker pack");
        close => { root.sheet = Sheet.stickers; }
        Secondary { text: @tr("Pictures are redrawn small, without their metadata, and sealed into one pack; a GIF becomes a short animation. People you send a sticker to can add the whole pack."); }
        Field { placeholder: @tr("Pack name"); text <=> root.pack-title; }
        HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: @tr("Paths to pictures, separated by ;"); mono: true; text <=> root.pack-paths; horizontal-stretch: 1; }
            QuietButton { text: @tr("Choose…"); outlined: true; accessible-label: @tr("Choose pictures for the pack"); clicked => { root.browse(3); } }
        }
        if root.pack-error != "": Text {
            text: root.pack-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? @tr("Making…") : @tr("Make pack");
                enabled: root.pack-title != "" && root.pack-paths != "" && !root.busy;
                clicked => { root.create-pack(root.pack-title, root.pack-paths); }
            }
        }
    }

    if root.sheet == Sheet.report: SheetFrame {
        title: @tr("Report {}", root.current.name);
        close => { root.sheet = Sheet.none; }
        Secondary { text: @tr("The report goes to the people who run {}'s server. It doesn't say who you are. They can close the account's message requests; they can't read your conversations.", root.current.name); }
        for option in [
            { label: @tr("Spam"), value: 1 },
            { label: @tr("Harassment or threats"), value: 2 },
            { label: @tr("Something else"), value: 3 },
        ]: Rectangle {
            height: Tokens.space-touch-target-min;
            border-radius: Tokens.radius-control;
            border-width: root.report-reason == option.value ? 2px : 1px;
            border-color: root.report-reason == option.value ? Tokens.pine : Tokens.hairline;
            accessible-role: radio-button;
            accessible-checked: root.report-reason == option.value;
            accessible-label: option.label;
            accessible-action-default => { root.report-reason = option.value; }
            TouchArea { clicked => { root.report-reason = option.value; } }
            HorizontalLayout {
                padding-left: Tokens.space-m;
                Body { text: option.label; vertical-alignment: center; }
            }
        }
        SwitchRow {
            label: @tr("Include their last messages");
            detail: @tr("Up to 10, as you see them. This chat is off the record, so the operator can't confirm who wrote them.");
            on: root.report-quote;
            toggled => { root.report-quote = !root.report-quote; }
        }
        SwitchRow {
            label: @tr("Also block them");
            detail: @tr("They can't send you anything more, and they aren't told.");
            on: root.report-block;
            toggled => { root.report-block = !root.report-block; }
        }
        if root.report-reason == 1: SwitchRow {
            label: @tr("Make message requests cost more");
            detail: @tr("For a month, anyone sending you a message request has their device do more work first. It slows down people who send many; one message from a friend still goes through.");
            on: root.report-costlier;
            toggled => { root.report-costlier = !root.report-costlier; }
        }
        HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? @tr("Sending…") : @tr("Send report");
                enabled: !root.busy;
                clicked => {
                    root.report(root.current-id, root.report-reason, root.report-quote, root.report-block, root.report-costlier);
                    root.sheet = Sheet.none;
                }
            }
        }
    }

    if root.sheet == Sheet.gallery: SheetFrame {
        title: @tr("Photos and files");
        close => { root.sheet = root.gallery-all || root.current-id == "" ? Sheet.none : Sheet.conversation; }
        if root.current-id != "": HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-xs;
            Chip {
                text: @tr("This conversation");
                chosen: !root.gallery-all;
                clicked => { root.gallery-all = false; }
            }
            Chip {
                text: @tr("All conversations");
                chosen: root.gallery-all;
                clicked => { root.gallery-all = true; root.load-gallery(); }
            }
        }
        Secondary { text: root.gallery-all ? @tr("Every file in every conversation, newest first. Nothing is downloaded until you open or save it.") : @tr("Everything sent in this conversation, newest last. Files stay sealed on this device until you save them."); }
        if root.gallery-all && root.gallery-rows.length == 0: Secondary { text: @tr("No files yet."); }
        if root.gallery-all: VerticalLayout {
            spacing: Tokens.space-xs;
            for g in root.gallery-rows: Rectangle {
                height: 56px;
                accessible-role: list-item;
                accessible-label: (g.picture ? @tr("Photo: ") : @tr("File: ")) + g.file + ", " + g.name + ", " + g.time;
                HorizontalLayout {
                    spacing: Tokens.space-sm;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Body { text: g.file; overflow: elide; }
                        Caption { text: g.name + " · " + (g.outgoing ? @tr("you sent it") : @tr("received")) + " · " + g.time; overflow: elide; }
                    }
                    if g.picture: VerticalLayout {
                        alignment: center;
                        QuietButton {
                            text: @tr("View");
                            accessible-label: @tr("View {}", g.file);
                            clicked => { root.play-clip(g.conversation, g.seq); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        QuietButton {
                            text: @tr("Save");
                            accessible-label: @tr("Save {}", g.file);
                            clicked => { root.save-file(g.conversation, g.seq); }
                        }
                    }
                }
            }
        }
        if !root.gallery-all: VerticalLayout {
            spacing: Tokens.space-xs;
            for m in root.messages: Rectangle {
                visible: m.file != "" && !m.deleted;
                height: self.visible ? 64px : 0px;
                accessible-role: list-item;
                accessible-label: (m.picture ? @tr("Photo: ") : @tr("File: ")) + m.file + ", " + m.time;
                HorizontalLayout {
                    spacing: Tokens.space-sm;
                    Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: Tokens.radius-control;
                        background: Tokens.bubble-in;
                        clip: true;
                        if m.has-image: Image {
                            source: m.image;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                        }
                        if !m.has-image: Path {
                            width: 24px;
                            height: 24px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: Icons.attach;
                            stroke: Tokens.text-muted;
                            stroke-width: 1.75px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Body { text: m.file; overflow: elide; }
                        Caption { text: (m.picture ? @tr("Photo") : @tr("File")) + " · " + (m.outgoing ? @tr("you sent it") : @tr("received")) + " · " + m.time; overflow: elide; }
                    }
                    VerticalLayout {
                        alignment: center;
                        QuietButton {
                            text: @tr("Save");
                            accessible-label: @tr("Save {}", m.file);
                            clicked => { root.save-file(root.current-id, m.seq); }
                        }
                    }
                }
            }
        }
    }

    if root.sheet == Sheet.location: SheetFrame {
        title: @tr("Share a location");
        close => { root.sheet = Sheet.none; }
        Secondary { text: root.capture-platform >= 3 ? @tr("Use where the phone is, or type the coordinates. Enclave doesn't look anything up and shows no map, so nobody else learns the place.") : @tr("Type or paste the coordinates. Enclave doesn't look anything up and shows no map, so nobody else learns the place."); }
        if root.capture-platform >= 3: HorizontalLayout {
            alignment: start;
            QuietButton {
                text: root.locating ? @tr("Finding where you are…") : @tr("Use my location");
                outlined: true;
                clicked => {
                    if !root.locating { root.location-note = ""; root.locate(); }
                }
            }
        }
        if root.location-note != "": Text {
            text: root.location-note;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        Field { placeholder: @tr("Latitude, like 52.5200"); mono: true; text <=> root.location-lat; }
        Field { placeholder: @tr("Longitude, like 13.4050"); mono: true; text <=> root.location-lon; }
        Field { placeholder: @tr("Name it (optional)"); text <=> root.location-name; }
        HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: @tr("Send");
                enabled: root.location-lat != "" && root.location-lon != "";
                clicked => {
                    root.share-location(root.current-id, root.location-lat, root.location-lon, root.location-name);
                    root.location-lat = "";
                    root.location-lon = "";
                    root.location-name = "";
                    root.sheet = Sheet.none;
                }
            }
        }
    }

    if root.sheet == Sheet.share-contact: SheetFrame {
        title: @tr("Share a contact");
        close => { root.sheet = Sheet.none; }
        Secondary { text: @tr("{} gets their code and can send them a request. Nobody is told who shared it.", root.current.name); }
        for p in root.friends: Rectangle {
            visible: p.id != root.current-id;
            height: self.visible ? 56px : 0px;
            border-radius: Tokens.radius-control;
            background: share-touch.has-hover ? Tokens.bubble-in : transparent;
            accessible-role: button;
            accessible-label: @tr("Share {}", p.name);
            accessible-action-default => { root.share-contact(root.current-id, p.id); root.sheet = Sheet.none; }
            share-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.share-contact(root.current-id, p.id); root.sheet = Sheet.none; }
            }
            HorizontalLayout {
                padding-left: Tokens.space-s;
                padding-right: Tokens.space-s;
                spacing: Tokens.space-sm;
                VerticalLayout { alignment: center; Avatar { initials: p.initials; tint: p.tint; size: 36px; } }
                Body { text: p.name; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            }
        }
        if root.friends.length < 2: Secondary { text: @tr("You can share people you already talk to."); }
    }

    if root.sheet == Sheet.poll: SheetFrame {
        title: @tr("Ask a question");
        close => { root.sheet = Sheet.none; }
        Secondary {
            text: root.current.kind != 1
                ? @tr("{} can vote, and you both see each other's vote. Only you can close it.", root.current.name)
                : root.poll-anonymous
                    ? @tr("Everyone in {} can vote. Only you see how each person voted; everyone sees the results when you close it.", root.current.name)
                    : @tr("Everyone in {} can vote and see how everyone else voted. Only you can close it.", root.current.name);
            wrap: word-wrap;
        }
        if root.current.kind == 1: SwitchRow {
            label: @tr("Anonymous");
            detail: @tr("Votes are sealed to you, so other members can't see who chose what.");
            on: root.poll-anonymous;
            toggled => { root.poll-anonymous = !root.poll-anonymous; }
        }
        Field { placeholder: @tr("Question"); text <=> root.poll-question; }
        Field { placeholder: @tr("Option 1"); text <=> root.poll-a; }
        Field { placeholder: @tr("Option 2"); text <=> root.poll-b; }
        Field { placeholder: @tr("Option 3 (optional)"); text <=> root.poll-c; }
        Field { placeholder: @tr("Option 4 (optional)"); text <=> root.poll-d; }
        HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? @tr("Sending…") : @tr("Ask");
                enabled: root.poll-question != "" && root.poll-a != "" && root.poll-b != "" && !root.busy;
                clicked => { root.create-poll(root.current-id, root.poll-question, root.poll-a, root.poll-b, root.poll-c, root.poll-d, root.current.kind == 1 && root.poll-anonymous); }
            }
        }
    }

    if root.sheet == Sheet.meet: SheetFrame {
        title: root.meet-done != "" ? @tr("You and {} are checked in person", root.meet-done) : root.meet-words != "" ? @tr("Do you both see these words?") : @tr("Meet in person");
        close => { root.sheet = Sheet.none; }
        HorizontalLayout {
            alignment: start;
            SealClose { closed: root.meet-done != "" || root.meet-words != ""; size: 56px; }
        }
        if root.meet-done != "": Secondary { text: @tr("If anything changes, we'll tell you before you send anything. Your conversation now also rests on a secret that only crossed the room between your two screens."); }
        if root.meet-done != "": HorizontalLayout {
            alignment: start;
            PrimaryButton { text: @tr("Done"); clicked => { root.sheet = Sheet.none; } }
        }

        if root.meet-done == "" && root.meet-words == "": Secondary {
            text: @tr("Show this code to the other person and scan theirs. It only works face to face: codes sent over a message or a call don't count.");
        }
        if root.meet-done == "" && root.meet-words == "" && root.meet-code != "": HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 216px;
                height: 216px;
                background: #ffffff;
                border-radius: Tokens.radius-control;
                Image {
                    width: 200px;
                    height: 200px;
                    source: root.meet-qr;
                    image-rendering: pixelated;
                    accessible-role: image;
                    accessible-label: @tr("Your in-person code");
                }
            }
        }
        if root.meet-done == "" && root.meet-words == "": HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: @tr("Their code: enclave:meet#…"); mono: true; text <=> root.meet-input; horizontal-stretch: 1; }
            if root.can-scan: QuietButton { text: @tr("Scan"); outlined: true; accessible-label: @tr("Scan their code with the camera"); clicked => { root.scan(2); } }
        }
        if root.meet-done == "" && root.meet-words == "" && root.meet-error != "": Text {
            text: root.meet-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        if root.meet-done == "" && root.meet-words == "": HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: @tr("Continue");
                enabled: root.meet-input != "";
                clicked => { root.meet-scan(root.meet-input); root.meet-input = ""; }
            }
        }

        if root.meet-done == "" && root.meet-words != "": HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-sm;
            Code {
                text: root.meet-words;
                vertical-alignment: center;
                accessible-label: @tr("Seal words: {}", root.meet-words);
            }
        }
        if root.meet-done == "" && root.meet-words != "": Secondary {
            text: @tr("{}'s phone should show the same three words. If it does, you scanned each other and nobody else.", root.meet-name);
        }
        if root.meet-done == "" && root.meet-words != "" && root.meet-error != "": Text {
            text: root.meet-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        if root.meet-done == "" && root.meet-words != "": HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton {
                text: root.busy ? @tr("Checking…") : @tr("They match");
                enabled: !root.busy;
                clicked => { root.meet-confirm(); }
            }
            QuietButton { text: @tr("They don't"); clicked => { root.sheet = Sheet.none; } }
        }
    }

    if root.sheet == Sheet.check-code: SheetFrame {
        title: root.current.verified ? @tr("You and {} are checked", root.current.name) : @tr("Check it's really {}", root.current.name);
        close => { root.sheet = Sheet.none; }
        Secondary {
            text: root.current.verified
                ? @tr("If anything changes, we'll tell you before you send anything.")
                : @tr("Compare these numbers with {} in person or on a call. If every group matches, tap They match.", root.current.name);
        }
        HorizontalLayout {
            alignment: center;
            Avatar { initials: root.current.initials; tint: root.current.tint; art: root.current.art; art-tint: root.current.art-tint; size: 56px; }
        }
        HorizontalLayout {
            alignment: center;
            GridLayout {
                spacing-horizontal: Tokens.space-l;
                spacing-vertical: Tokens.space-s;
                for g[i] in root.code-groups: Code {
                    text: g;
                    row: i / 3;
                    col: mod(i, 3);
                    accessible-label: @tr("Group {}: {}", (i + 1), g);
                }
            }
        }
        // The same code to read aloud on a call.
        if root.code-words.length > 0: VerticalLayout {
            spacing: Tokens.space-xs;
            Caption { text: @tr("Or read these words to each other:"); }
            // Two rows of five, each word read on its own with its place
            // (A-11).
            for row in [0, 5]: HorizontalLayout {
                alignment: start;
                spacing: Tokens.space-s;
                for w[k] in [root.code-words[row], root.code-words[row + 1], root.code-words[row + 2], root.code-words[row + 3], root.code-words[row + 4]]: Text {
                    text: w;
                    font-family: "Atkinson Hyperlegible Mono";
                    font-size: Tokens.type-body;
                    color: Tokens.text;
                    accessible-label: @tr("Word {} of 10: {}", row + k + 1, w);
                }
            }
            HorizontalLayout {
                alignment: start;
                QuietButton {
                    text: root.code-words-english ? @tr("Show in my language") : @tr("Show in English");
                    clicked => { root.code-words-english-toggled(!root.code-words-english); }
                }
            }
        }
        if root.current.verified: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            Seal { state: SealState.checked; size: 24px; }
            Body { text: root.current.met ? @tr("Checked in person") : @tr("Checked"); vertical-alignment: center; }
        }
        if !root.current.verified: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton { text: @tr("They match"); clicked => { root.mark-checked(root.current-id); } }
            QuietButton { text: @tr("Not now"); clicked => { root.sheet = Sheet.none; } }
        }
        if !root.current.met: HorizontalLayout {
            alignment: start;
            QuietButton { text: @tr("Together right now? Meet in person"); outlined: true; clicked => { root.open-sheet(Sheet.meet); } }
        }
    }

    if root.sheet == Sheet.servers: SheetFrame {
        title: root.server-pick-for == 0 ? @tr("Choose a server") : root.server-pick-for == 1 ? @tr("Move to another server") : @tr("Move the group");
        close => { root.sheet = root.server-pick-for == 2 ? Sheet.members : root.server-pick-for == 1 ? Sheet.settings : Sheet.none; }
        Secondary {
            text: root.server-pick-for == 0
                ? @tr("Your messages wait on this server until your devices collect them. It sees only sealed units of one size: it can't read them or tell who sent them. You can move later.")
                : root.server-pick-for == 1
                    ? @tr("Your inboxes, username and invite links move with you. Contacts and groups are told as they come online; keep Enclave running until the move is done.")
                    : @tr("The group moves from the next day once more than half of its admins vote for the same server. Votes count for 7 days, and earlier messages stay where they are.");
        }
        Flickable {
            height: min(360px, server-list.preferred-height);
            server-list := VerticalLayout {
                spacing: Tokens.space-s;
                for o in root.servers: Rectangle {
                    property <bool> current: o.id == (root.server-pick-for == 2 ? root.group-host : root.server-pick-for == 1 ? root.home-id : "");
                    min-height: srow.preferred-height;
                    border-radius: Tokens.radius-control;
                    border-width: root.chosen-server == o.id ? 2px : 1px;
                    border-color: root.chosen-server == o.id ? Tokens.pine : Tokens.hairline;
                    accessible-role: radio-button;
                    accessible-checked: root.chosen-server == o.id;
                    accessible-label: @tr("{}, run by {}", o.domain, o.operator);
                    accessible-action-default => { root.chosen-server = o.id; }
                    TouchArea { clicked => { root.chosen-server = o.id; } }
                    srow := HorizontalLayout {
                        padding: Tokens.space-m;
                        spacing: Tokens.space-sm;
                        VerticalLayout {
                            alignment: start;
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 10px;
                                border-width: 2px;
                                border-color: root.chosen-server == o.id ? Tokens.pine : Tokens.text-muted;
                                if root.chosen-server == o.id: Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Tokens.pine; }
                            }
                        }
                        VerticalLayout {
                            spacing: Tokens.space-xs;
                            Body { text: o.domain; font-weight: 600; overflow: elide; }
                            Secondary {
                                text: @tr("Run by ") + o.operator
                                    + (current ? (root.server-pick-for == 2 ? @tr(" · The group is here") : @tr(" · You're here")) : "")
                                    + (root.server-pick-for == 2 && o.votes > 0 ? @tr(" · {} of {} admins voted for it", o.votes, root.group-admins) : "");
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton {
                text: root.server-pick-for == 0 ? @tr("Use this server") : root.server-pick-for == 1 ? (root.busy ? @tr("Moving…") : @tr("Move my account")) : @tr("Vote for this server");
                enabled: root.chosen-server != "" && !root.busy
                    && root.chosen-server != (root.server-pick-for == 2 ? root.group-host : root.server-pick-for == 1 ? root.home-id : "");
                clicked => {
                    root.pick-server(root.server-pick-for, root.chosen-server);
                    root.sheet = root.server-pick-for == 2 ? Sheet.members : root.server-pick-for == 1 ? Sheet.settings : Sheet.none;
                }
            }
        }
    }

    if root.sheet == Sheet.settings: SheetFrame {
        title: @tr("Settings");
        close => { root.sheet = Sheet.none; }
        HorizontalLayout {
            alignment: start;
            QuietButton {
                text: @tr("Photos and files from every conversation");
                outlined: true;
                clicked => { root.gallery-all = true; root.load-gallery(); root.sheet = Sheet.gallery; }
            }
        }
        // iPhone suspends apps in the background: nothing is sent then, and
        // new messages wake Enclave through Apple's push (PC-05).
        for option[i] in root.capture-platform == 4 ? [
            { title: @tr("Standard"), text: @tr("Hides who you talk to. Uses about 80 MB an hour while Enclave is open. In the background iPhone lets Enclave send nothing; Apple's push wakes it when something arrives.") },
            { title: @tr("Maximum"), text: @tr("Also hides when you're using Enclave, but only while it's open: iPhone stops it in the background, and push is off. Large files send slowly.") },
        ] : [
            { title: @tr("Standard"), text: @tr("Hides who you talk to. Uses about 80 MB an hour while Enclave is open, and about 50 MB a day in the background.") },
            { title: @tr("Maximum"), text: @tr("Also hides when you're using Enclave. Uses about 2 GB a day. Large files send slowly.") },
        ]: Rectangle {
            min-height: row.preferred-height;
            border-radius: Tokens.radius-control;
            border-width: root.privacy == i ? 2px : 1px;
            border-color: root.privacy == i ? Tokens.pine : Tokens.hairline;
            accessible-role: radio-button;
            accessible-checked: root.privacy == i;
            accessible-label: option.title;
            accessible-action-default => { root.set-privacy(i); }
            TouchArea { clicked => { root.set-privacy(i); } }
            row := HorizontalLayout {
                padding: Tokens.space-m;
                spacing: Tokens.space-sm;
                VerticalLayout {
                    alignment: start;
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        border-width: 2px;
                        border-color: root.privacy == i ? Tokens.pine : Tokens.text-muted;
                        if root.privacy == i: Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Tokens.pine; }
                    }
                }
                VerticalLayout {
                    spacing: Tokens.space-xs;
                    Body { text: option.title; font-weight: 600; }
                    Secondary { text: option.text; }
                }
            }
        }
        Rectangle { height: 1px; background: Tokens.hairline; }
        if root.home-label != "": Body { text: @tr("Your server"); font-weight: 600; }
        if root.home-label != "": Secondary {
            text: root.home-label + (root.moving ? @tr(". Moving: still telling your contacts and groups. Keep Enclave running until it's done.") : ".");
        }
        if root.can-move && !root.moving && root.servers.length > 1: HorizontalLayout {
            alignment: start;
            QuietButton {
                text: @tr("Move to another server");
                outlined: true;
                clicked => { root.server-pick-for = 1; root.chosen-server = ""; root.sheet = Sheet.servers; }
            }
        }
        Body { text: @tr("Tor bridges"); font-weight: 600; }
        Secondary {
            text: root.bridges == ""
                ? @tr("Off. If your network blocks Tor, a bridge gets around it. Use Tor's built-in bridges or Snowflake, or paste obfs4 or WebTunnel bridge lines from bridges.torproject.org.")
                : root.bridges == "builtin"
                    ? @tr("Using Tor's built-in bridges.")
                    : root.bridges == "snowflake"
                        ? @tr("Using Snowflake: Tor traffic passes through volunteers' browsers, and looks like a video call.")
                        : @tr("Using your own bridges.");
        }
        Field { placeholder: @tr("obfs4 … cert=… iat-mode=0"); mono: true; multiline: true; text <=> root.bridges-input; }
        HorizontalLayout {
            spacing: Tokens.space-s;
            alignment: start;
            PrimaryButton { text: @tr("Save"); enabled: root.bridges-input != ""; clicked => { root.set-bridges(root.bridges-input); } }
            QuietButton { text: @tr("Built-in"); clicked => { root.set-bridges("builtin"); } }
            QuietButton { text: @tr("Snowflake"); clicked => { root.set-bridges("snowflake"); } }
            if root.bridges != "": QuietButton { text: @tr("Turn off"); clicked => { root.set-bridges(""); } }
        }
        if root.bridges-error != "": Text {
            text: root.bridges-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        Rectangle { height: 1px; background: Tokens.hairline; }
        if root.can-hide-capture: SwitchRow {
            label: @tr("Hide from screenshots");
            detail: root.capture-platform == 4
                ? @tr("iPhone can't block screenshots. Enclave blurs itself in the app switcher and while the screen is recorded or mirrored.")
                : root.capture-platform == 2
                ? @tr("Screen sharing and the system's screenshots leave Enclave's window out. Some other capture tools may still see it.")
                : root.capture-platform == 3
                ? @tr("Screenshots, screen recordings and the app switcher show a blank screen instead of your messages.")
                : @tr("Screenshots, screen recordings and screen sharing show a blank window instead of your messages.");
            on: root.screen-security;
            toggled => { root.set-screen-security(!root.screen-security); }
        }
        if root.can-hide-capture && root.capture-failed && root.screen-security: Text {
            text: @tr("This version of Windows can't hide Enclave from screen capture. Windows 10 version 2004 or later can.");
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        if !root.can-hide-capture: Secondary {
            text: @tr("On Linux any program you run can capture the screen, and Enclave can't stop it. Close Enclave before sharing your screen.");
        }
        if root.sandbox-weak: Text {
            text: @tr("This system's kernel doesn't support Landlock, so Enclave can't fully limit which files its key-holding part can reach. It still runs with its other protections. A kernel from 5.13 on, with Landlock turned on, closes this gap.");
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        Rectangle { height: 1px; background: Tokens.hairline; }
        Body { text: @tr("Chat folders"); font-weight: 600; }
        Secondary {
            text: @tr("Sort conversations into folders, shown above your list. They stay on your own devices.");
            wrap: word-wrap;
        }
        for f in root.folders: HorizontalLayout {
            spacing: Tokens.space-s;
            Body { text: f.name; vertical-alignment: center; horizontal-stretch: 1; }
            QuietButton {
                text: @tr("Delete");
                danger: true;
                accessible-label: @tr("Delete the folder {}", f.name);
                clicked => { root.delete-folder(f.name); }
            }
        }
        HorizontalLayout {
            spacing: Tokens.space-s;
            Field {
                placeholder: @tr("New folder");
                text <=> root.new-folder-name;
                horizontal-stretch: 1;
                accepted => { root.new-folder(root.new-folder-name); root.new-folder-name = ""; }
            }
            QuietButton {
                text: @tr("Add");
                outlined: true;
                clicked => { root.new-folder(root.new-folder-name); root.new-folder-name = ""; }
            }
        }
        Rectangle { height: 1px; background: Tokens.hairline; }
        SwitchRow {
            label: @tr("Read receipts");
            detail: @tr("Let people know when you've read their messages, and see when they've read yours. Off, neither side sees them; messages still show as delivered.");
            on: root.receipts-setting;
            toggled => { root.set-receipts-setting(!root.receipts-setting); }
        }
        Rectangle { height: 1px; background: Tokens.hairline; }
        SwitchRow {
            label: @tr("Typing indicators");
            detail: @tr("Show people when you're typing, and see when they are. They only replace cover traffic, so they never use more data, and some may not arrive.");
            on: root.typing-setting;
            toggled => { root.set-typing-setting(!root.typing-setting); }
        }
        if root.usernames: Rectangle { height: 1px; background: Tokens.hairline; }
        if root.usernames: Body { text: @tr("Username"); font-weight: 600; }
        if root.usernames && root.my-username != "": Text {
            text: root.my-username;
            font-family: "Atkinson Hyperlegible Mono";
            font-size: Tokens.type-body;
            color: Tokens.text;
            accessible-label: @tr("Your username: {}", root.my-username);
        }
        if root.usernames: Secondary {
            text: root.my-username == ""
                ? @tr("Optional. A username is public, like an email address: anyone who knows it can send you a message request.")
                : @tr("Anyone who knows it can send you a message request. Choosing a new one retires this one.");
        }
        if root.usernames: HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: "name"; mono: true; text <=> root.username-input; horizontal-stretch: 1; }
            PrimaryButton {
                text: root.busy ? @tr("Checking…") : (root.my-username == "" ? @tr("Choose") : @tr("Change"));
                enabled: root.username-input != "" && !root.busy;
                clicked => { root.claim-username(root.username-input); }
            }
        }
        if root.usernames && root.username-error != "": Text {
            text: root.username-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Tokens.space-s;
            QuietButton {
                text: @tr("Recovery words");
                outlined: true;
                horizontal-stretch: 1;
                clicked => { root.open-sheet(Sheet.recovery); }
            }
            QuietButton {
                text: @tr("Your devices");
                outlined: true;
                horizontal-stretch: 1;
                clicked => { root.open-sheet(Sheet.devices); }
            }
        }
        if root.can-join: Rectangle { height: 1px; background: Tokens.hairline; }
        if root.can-join: Body { text: @tr("Passphrase"); font-weight: 600; }
        if root.can-join: Secondary {
            text: root.can-lock
                ? @tr("Enclave asks for it each time it starts on this computer.")
                : root.file-keys
                ? @tr("Needed: this computer has no keyring, so Enclave's keys are kept in files, and the passphrase protects them.")
                : @tr("Optional. Enclave would ask for it each time it starts on this computer.");
        }
        if root.can-join: HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: root.can-lock ? @tr("New passphrase") : @tr("Passphrase"); secret: true; text <=> root.new-passphrase; horizontal-stretch: 1; }
            PrimaryButton {
                text: root.busy ? @tr("Saving…") : (root.can-lock ? @tr("Change") : @tr("Set"));
                enabled: root.new-passphrase != "" && !root.busy;
                clicked => { root.set-passphrase(root.new-passphrase); }
            }
        }
        if root.can-lock: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            QuietButton { text: @tr("Lock now"); outlined: true; clicked => { root.sheet = Sheet.none; root.lock-now(); } }
            if !root.file-keys: QuietButton { text: @tr("Remove passphrase"); danger: true; clicked => { root.set-passphrase(""); } }
        }
        Rectangle { height: 1px; background: Tokens.hairline; }
        Body { text: @tr("Screen lock"); font-weight: 600; }
        Secondary {
            text: root.can-lock
                ? @tr("Enclave locks itself when you haven't used it for a while, and your passphrase opens it again.")
                : root.app-lock
                    ? @tr("Enclave locks itself when you haven't used it for a while, and your PIN opens it again. Messages keep arriving while it's locked.")
                    : @tr("Set a PIN, and Enclave locks itself when you haven't used it for a while. Messages keep arriving while it's locked.");
        }
        if !root.can-lock: HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: root.app-lock ? @tr("New PIN") : @tr("PIN (at least 4 digits)"); secret: true; text <=> root.app-pin-input; horizontal-stretch: 1; }
            PrimaryButton {
                text: root.app-lock ? @tr("Change") : @tr("Set");
                enabled: root.app-pin-input != "";
                clicked => { root.set-app-lock(root.app-pin-input); root.app-pin-input = ""; }
            }
        }
        if root.can-lock || root.app-lock: Caption { text: @tr("Lock after"); }
        if root.can-lock || root.app-lock: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-xs;
            for t in [
                { secs: 60, name: @tr("1 minute") }, { secs: 300, name: @tr("5 minutes") },
                { secs: 900, name: @tr("15 minutes") }, { secs: 3600, name: @tr("1 hour") },
                { secs: 0, name: @tr("Never") },
            ]: QuietButton {
                text: t.name;
                outlined: root.lock-timeout == t.secs;
                accessible-label: @tr("Lock after {}", t.name);
                clicked => { root.set-lock-timeout(t.secs); }
            }
        }
        if root.app-lock && !root.can-lock && root.biometric != "": SwitchRow {
            label: @tr("Unlock with {}", root.biometric);
            detail: @tr("Opens the screen lock only. Removing a device, new recovery words and deleting your account still need your PIN.");
            on: root.biometric-on;
            toggled => { root.set-biometric(!root.biometric-on); }
        }
        if root.app-lock && !root.can-lock: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            QuietButton { text: @tr("Lock now"); outlined: true; clicked => { root.sheet = Sheet.none; root.lock-now(); } }
            QuietButton { text: @tr("Turn off"); danger: true; clicked => { root.set-app-lock(""); } }
        }
        Body { text: @tr("Emergency PIN"); font-weight: 600; }
        Secondary {
            text: @tr("If someone makes you open Enclave, type this instead of your PIN or passphrase. It erases Enclave from this computer and opens it as if it were new. A copy of this computer made before you used it isn't affected.");
        }
        HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: @tr("Emergency PIN (at least 4 digits)"); secret: true; text <=> root.emergency-pin-input; horizontal-stretch: 1; }
            PrimaryButton {
                text: @tr("Set");
                enabled: root.emergency-pin-input != "";
                clicked => { root.set-emergency-pin(root.emergency-pin-input); root.emergency-pin-input = ""; }
            }
            QuietButton { text: @tr("Remove"); clicked => { root.set-emergency-pin(""); } }
        }
        Body { text: @tr("Backup"); font-weight: 600; }
        Secondary { text: @tr("An encrypted copy of your contacts, messages and notes. Only your recovery words open it."); }
        if root.can-change-words: SwitchRow {
            label: @tr("Keep a backup on my server");
            detail: root.server-backup
                ? (root.server-backup-at != "" ? @tr("Renewed every week. Last: {}.", root.server-backup-at) : @tr("Renewed every week."))
                : @tr("Renewed every week. Your server sees only an encrypted file; your words alone bring it back.");
            on: root.server-backup;
            toggled => { if !root.busy { root.set-server-backup(!root.server-backup); } }
        }
        SwitchRow {
            label: @tr("Include photos and files");
            detail: @tr("In backups you save here. They can get large.");
            on: root.backup-media;
            toggled => { root.backup-media = !root.backup-media; }
        }
        HorizontalLayout {
            alignment: start;
            QuietButton { text: @tr("Save a backup"); outlined: true; clicked => { root.save-backup(root.backup-media); } }
        }
        Caption { text: @tr("Check my backup"); }
        Secondary { text: @tr("Make sure the words you wrote down open your backup, without restoring anything."); }
        Field { placeholder: @tr("Your 24 recovery words"); mono: true; secret: true; text <=> root.check-words; }
        HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: @tr("Path to a backup file (or leave empty for the one on your server)"); mono: true; text <=> root.check-file; horizontal-stretch: 1; }
            QuietButton { text: @tr("Choose…"); outlined: true; accessible-label: @tr("Choose a backup file to check"); clicked => { root.browse(1); } }
        }
        HorizontalLayout {
            alignment: start;
            QuietButton {
                text: root.busy ? @tr("Checking…") : @tr("Check");
                outlined: true;
                clicked => { if root.check-words != "" && !root.busy { root.check-backup(root.check-words, root.check-file); root.check-words = ""; } }
            }
        }
        if root.backup-check != "": Secondary { text: root.backup-check; }
        Body { text: @tr("PIN"); font-weight: 600; }
        Secondary { text: root.has-root-pin ? @tr("Enclave asks for your PIN before removing a device, changing your recovery words or deleting your account.") : @tr("Set a PIN, and Enclave asks for it before removing a device, changing your recovery words or deleting your account. Someone who picks up your unlocked phone can't do those."); }
        if root.has-root-pin: Field { placeholder: @tr("Current PIN"); secret: true; text <=> root.root-pin-input; }
        HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: root.has-root-pin ? @tr("New PIN") : @tr("PIN (at least 6)"); secret: true; text <=> root.new-pin-input; horizontal-stretch: 1; }
            QuietButton {
                text: root.has-root-pin ? @tr("Change PIN") : @tr("Set PIN");
                outlined: true;
                clicked => {
                    if root.has-root-pin { root.unlock-root(root.root-pin-input); }
                    root.set-root-pin(root.new-pin-input);
                    root.new-pin-input = "";
                    root.root-pin-input = "";
                }
            }
        }
        if root.pin-error != "": Text { text: root.pin-error; color: Tokens.danger; font-size: Tokens.type-secondary; wrap: word-wrap; }
        Body { text: @tr("Voice note transcription"); font-weight: 600; }
        Secondary {
            text: root.transcription == 2
                ? @tr("Voice notes can be turned into text on this device. Nothing you hear is sent anywhere.")
                : root.transcription == 1
                ? @tr("Downloading the speech model through Tor… {}%", root.transcription-percent)
                : @tr("Turn voice notes into text on this device. This downloads a 40 MB speech model through Tor once; what's said never leaves the device.");
        }
        if root.transcription-error != "": Text { text: root.transcription-error; color: Tokens.danger; font-size: Tokens.type-secondary; wrap: word-wrap; }
        HorizontalLayout {
            alignment: start;
            QuietButton {
                text: root.transcription == 0 ? @tr("Download the model") : root.transcription == 1 ? @tr("Cancel") : @tr("Delete the model");
                outlined: true;
                clicked => { root.transcription-model(root.transcription == 0); }
            }
        }
        Body { text: @tr("Notifications"); font-weight: 600; }
        Secondary { text: root.previews ? @tr("Notifications on your phone show who wrote and the start of the message. Only your devices can read them; Apple and Google see nothing.") : @tr("Notifications say \"New message\" only. Turn previews on to see who wrote and the start of the message, readable only by your devices."); }
        HorizontalLayout {
            alignment: start;
            QuietButton { text: root.previews ? @tr("Turn previews off") : @tr("Show previews"); outlined: true; clicked => { root.set-previews(!root.previews); } }
        }
        if root.can-unifiedpush || root.can-firebase: Body { text: @tr("With the app closed"); font-weight: 600; }
        if root.can-unifiedpush || root.can-firebase: Secondary {
            text: root.delivery == 1
                ? @tr("Your push service (UnifiedPush) wakes Enclave when something arrives. It learns only that something arrived, not what or from whom.")
                : root.delivery == 3
                ? @tr("Google's push service wakes Enclave when something arrives. Google learns only that something arrived, not what or from whom.")
                : @tr("Enclave stays connected in the background, so messages arrive at once, and Android shows that it's running. A push service uses less battery.");
        }
        // Staying connected needs Android to leave Enclave running (PC-22).
        if root.capture-platform == 3 && root.delivery == 0 && root.battery-restricted: Text {
            text: @tr("Android may stop Enclave to save battery, and messages then wait until you open it. To let it run in the background, find Enclave in the list that opens and turn battery optimization off for it.");
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        if root.capture-platform == 3 && root.delivery == 0 && root.battery-restricted: HorizontalLayout {
            alignment: start;
            QuietButton { text: @tr("Open battery settings"); outlined: true; clicked => { root.open-battery-settings(); } }
        }
        if root.can-unifiedpush || root.can-firebase: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            if root.delivery != 0: QuietButton { text: @tr("Stay connected"); outlined: true; clicked => { root.set-delivery(0); } }
            if root.delivery != 1 && root.can-unifiedpush: QuietButton { text: @tr("Use UnifiedPush"); outlined: true; clicked => { root.set-delivery(1); } }
            if root.delivery != 3 && root.can-firebase: QuietButton { text: @tr("Use Google's push"); outlined: true; clicked => { root.set-delivery(3); } }
        }
        Body { text: @tr("Secure my account"); font-weight: 600; }
        Secondary { text: root.securing ? @tr("Securing your account. This finishes on its own.") : @tr("Lost a device, or worried someone saw something? This gives your account new keys, new inboxes and new device keys, and starts fresh protection with every contact and group. Your security code and conversations stay the same."); }
        if root.can-change-words && !root.securing && root.has-root-pin: Field { placeholder: @tr("Your PIN"); secret: true; text <=> root.root-pin-input; }
        if root.can-change-words && !root.securing: HorizontalLayout {
            alignment: start;
            QuietButton {
                text: root.busy ? @tr("Securing…") : @tr("Secure my account");
                outlined: true;
                clicked => { if !root.busy { if root.has-root-pin { root.unlock-root(root.root-pin-input); root.root-pin-input = ""; } root.secure-account(); } }
            }
        }
        Body { text: @tr("Delete"); font-weight: 600; }
        Secondary { text: root.can-change-words ? @tr("Delete your account for everyone, or only erase this device.") : @tr("Erase this device. Deleting the account is done on the device that holds your recovery words."); }
        HorizontalLayout {
            alignment: start;
            QuietButton { text: root.can-change-words ? @tr("Delete my account") : @tr("Erase this device"); danger: true; clicked => { root.delete-confirm = ""; root.open-sheet(Sheet.delete-account); } }
        }
        Body { text: @tr("Recovery with friends"); font-weight: 600; }
        Secondary {
            text: root.share-threshold > 0
                ? @tr("Any {} of the {} people you chose can help you get your account back if you lose your words and every device. None of them can do it alone.", root.share-threshold, root.share-holders.length)
                : @tr("Give a few people you trust each a share of your recovery. If you lose your words and every device, meeting enough of them gets your account back. None of them can do it alone.");
        }
        HorizontalLayout {
            alignment: start;
            QuietButton { text: root.share-threshold > 0 ? @tr("Choose again") : @tr("Choose friends"); outlined: true; clicked => { root.open-sheet(Sheet.friends); } }
        }
        Rectangle { height: 1px; background: Tokens.hairline; }
        HorizontalLayout {
            alignment: start;
            QuietButton { text: @tr("About Enclave"); clicked => { root.sheet = Sheet.about; } }
        }
    }

    if root.sheet == Sheet.about: SheetFrame {
        title: @tr("About Enclave");
        close => { root.sheet = Sheet.settings; }
        HorizontalLayout {
            spacing: Tokens.space-m;
            alignment: start;
            Image {
                width: 64px;
                height: 64px;
                source: @image-url("../../../packaging/icons/png/enclave-128.png");
                accessible-role: image;
                accessible-label: @tr("Enclave");
            }
            VerticalLayout {
                alignment: center;
                Body { text: @tr("Enclave"); font-weight: 600; }
                Secondary { text: @tr("Version {}", root.version); }
            }
        }
        Secondary { text: @tr("Free software under the GNU General Public License, version 3, with additional permissions for app stores. Anyone can read, build and check it: github.com/0xnullsect0r/enclave-messenger."); }
        Secondary { text: @tr("No single company runs its servers: independent operators do, and the foundation only signs the list of them."); }
        HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            QuietButton { text: @tr("Check for updates"); outlined: true; clicked => { root.check-updates(); } }
            // Phones install from their stores, which check the build
            // (PC-10); the desktop compares its programs with the release's.
            if root.capture-platform < 3: QuietButton { text: @tr("Verify this build"); outlined: true; clicked => { root.verify-build(); } }
        }
        if root.build-check != "": Secondary { text: root.build-check; }
        HorizontalLayout { alignment: start; AboutSlint { } }
        HorizontalLayout {
            alignment: start;
            QuietButton {
                text: @tr("Open-source licences");
                outlined: true;
                clicked => { root.load-licences(); root.sheet = Sheet.licences; }
            }
        }
    }

    if root.sheet == Sheet.crashes: SheetFrame {
        title: @tr("Crash reports");
        max-card-width: 720px;
        close => { root.sheet = Sheet.none; }
        Secondary { text: @tr("Each report says which part of Enclave stopped, where in its code, and the names of the functions it was running. It holds no messages, contacts, keys or memory. It stays on this device unless you save or send it."); }
        if root.crash-reports.length == 0: Secondary { text: @tr("No reports."); }
        ListView {
            height: min(root.height * 0.6, 640px);
            for r[i] in root.crash-reports: VerticalLayout {
                padding-top: Tokens.space-s;
                padding-bottom: Tokens.space-m;
                spacing: Tokens.space-xs;
                Text {
                    text: @tr("{} · {}", r.process, r.when);
                    font-size: Tokens.type-secondary;
                    font-weight: 600;
                    color: Tokens.text;
                }
                Code { text: r.text; wrap: word-wrap; font-size: Tokens.type-caption; }
                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-s;
                    if root.support-known: QuietButton { text: @tr("Send to Enclave Support"); outlined: true; clicked => { root.send-crash(i); } }
                    QuietButton { text: @tr("Save as a file"); outlined: true; clicked => { root.save-crash(i); } }
                    QuietButton { text: @tr("Delete"); danger: true; clicked => { root.delete-crash(i); } }
                }
            }
        }
        if !root.support-known: Caption { text: @tr("To report it, save it as a file and attach it to an issue at github.com/0xnullsect0r/enclave-messenger."); wrap: word-wrap; }
    }

    if root.sheet == Sheet.licences: SheetFrame {
        title: @tr("Open-source licences");
        max-card-width: 720px;
        close => { root.sheet = Sheet.about; }
        Secondary { text: @tr("Enclave is built with the work of these projects, under the licences below."); }
        ListView {
            height: min(root.height * 0.6, 640px);
            for e in root.licences: VerticalLayout {
                padding-top: Tokens.space-s;
                padding-bottom: Tokens.space-s;
                spacing: Tokens.space-xs;
                Text {
                    text: e.title;
                    font-size: Tokens.type-secondary;
                    font-weight: 600;
                    color: Tokens.text;
                    wrap: word-wrap;
                }
                Caption { text: e.text; wrap: word-wrap; }
            }
        }
    }

    if root.sheet == Sheet.friends: SheetFrame {
        property <int> chosen: root.friends-chosen;
        title: @tr("Recovery with friends");
        close => { root.sheet = Sheet.none; }
        Secondary { text: @tr("Choose 3 to 5 people you trust and can meet. Each gets a share by message, and can only give it back to you in person."); }
        if root.share-threshold > 0: Secondary { text: @tr("Leaving out someone who holds a share now changes your recovery words, so their share stops working. You'll be shown the new words."); }
        for p in root.friends: Rectangle {
            height: 56px;
            border-radius: Tokens.radius-control;
            background: p.selected ? Tokens.bubble-in : transparent;
            accessible-role: checkbox;
            accessible-checked: p.selected;
            accessible-label: p.name;
            accessible-action-default => { root.toggle-pick(p.id); }
            TouchArea { clicked => { root.toggle-pick(p.id); } }
            HorizontalLayout {
                padding-left: Tokens.space-s;
                padding-right: Tokens.space-s;
                spacing: Tokens.space-sm;
                VerticalLayout { alignment: center; Avatar { initials: p.initials; tint: p.tint; size: 36px; } }
                Body { text: p.name; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Text { text: p.selected ? @tr("Chosen") : ""; font-size: Tokens.type-caption; color: Tokens.pine; vertical-alignment: center; }
            }
        }
        if root.friends.length < 2: Secondary { text: @tr("You need at least two conversations with people you trust first."); }
        if root.has-root-pin: Field { placeholder: @tr("Your PIN"); secret: true; text <=> root.root-pin-input; }
        HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? @tr("Sharing…") : (chosen >= 2 ? @tr("Share with {} ({} needed)", chosen, (floor(chosen / 2) + 1)) : @tr("Share"));
                enabled: chosen >= 2 && !root.busy;
                clicked => { if root.has-root-pin { root.unlock-root(root.root-pin-input); root.root-pin-input = ""; } root.give-shares(floor(chosen / 2) + 1); root.sheet = Sheet.none; }
            }
        }
    }

    if root.sheet == Sheet.share: SheetFrame {
        title: @tr("Part of {}'s recovery", root.current.name);
        close => { root.reveal-share(""); root.sheet = Sheet.none; }
        if root.share-release == "": Body {
            text: @tr("{} asked for your part of their recovery. Only continue if you're with {} right now.", root.current.name, root.current.name);
            wrap: word-wrap;
        }
        if root.share-release == "": Secondary {
            text: @tr("Anyone who collects enough of these can take over their account. Never give it over a message or a call, even if it seems to be them.");
        }
        if root.share-release == "": HorizontalLayout {
            spacing: Tokens.space-s;
            Field {
                placeholder: @tr("Scan or paste the code on their new device");
                mono: true;
                text <=> root.share-request-input;
                horizontal-stretch: 1;
            }
            if root.can-scan: QuietButton { text: @tr("Scan"); outlined: true; accessible-label: @tr("Scan the code on their new device with the camera"); clicked => { root.scan(3); } }
        }
        if root.share-release == "": HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton {
                text: @tr("I'm with them: continue");
                enabled: root.share-request-input != "";
                clicked => { root.release-share(root.share-request-input); }
            }
            QuietButton { text: @tr("Not now"); clicked => { root.reveal-share(""); root.sheet = Sheet.none; } }
        }
        if root.share-release != "": Body {
            text: @tr("Check their screen shows these words: {}", root.share-release-words);
            wrap: word-wrap;
        }
        if root.share-release != "": Secondary {
            text: @tr("If the words differ, close this: you scanned the wrong screen. If they match, let {} scan this code.", root.current.name);
        }
        if root.share-release != "": HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 296px;
                height: 296px;
                background: #ffffff;
                border-radius: Tokens.radius-control;
                Image {
                    width: 280px;
                    height: 280px;
                    source: root.share-release-qr;
                    image-rendering: pixelated;
                    accessible-role: image;
                    accessible-label: @tr("Your part of {}'s recovery, sealed for their new device", root.current.name);
                }
            }
        }
        if root.share-release != "": HorizontalLayout {
            alignment: start;
            PrimaryButton { text: @tr("Done"); clicked => { root.reveal-share(""); root.sheet = Sheet.none; } }
        }
    }

    if root.sheet == Sheet.new-group: SheetFrame {
        title: @tr("New group");
        close => { root.sheet = Sheet.none; }
        Field { placeholder: @tr("Group name"); text <=> root.group-name; }
        Secondary { text: root.pick.length == 0 ? @tr("Add people as contacts first. Groups are made from people who have accepted you.") : @tr("Choose who to add. Everyone in the group can see who else is in it."); }
        for p in root.pick: Rectangle {
            height: 56px;
            border-radius: Tokens.radius-control;
            background: p.selected ? Tokens.bubble-in : transparent;
            accessible-role: checkbox;
            accessible-checked: p.selected;
            accessible-label: p.name;
            accessible-action-default => { root.toggle-pick(p.id); }
            TouchArea { clicked => { root.toggle-pick(p.id); } }
            HorizontalLayout {
                padding-left: Tokens.space-s;
                padding-right: Tokens.space-s;
                spacing: Tokens.space-sm;
                VerticalLayout { alignment: center; Avatar { initials: p.initials; tint: p.tint; size: 36px; } }
                Body { text: p.name; vertical-alignment: center; horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: p.selected ? Tokens.pine : Tokens.text-muted;
                        background: p.selected ? Tokens.pine : transparent;
                        if p.selected: Path {
                            width: 16px;
                            height: 16px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M 5 12 L 10 17 L 19 7";
                            stroke: Tokens.on-pine;
                            stroke-width: 2.5px;
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? @tr("Creating…") : @tr("Create group");
                enabled: root.group-name != "" && !root.busy;
                clicked => { root.create-group(root.group-name); }
            }
        }
    }

    if root.sheet == Sheet.members: SheetFrame {
        title: root.current.name;
        close => { root.sheet = Sheet.none; root.confirm-leave = ""; }
        Secondary { text: @tr("{} people, you included. Everyone in the group can see who else is in it.", root.current.members); }
        for m in root.members: HorizontalLayout {
            spacing: Tokens.space-sm;
            min-height: 56px;
            VerticalLayout { alignment: start; padding-top: Tokens.space-s; Avatar { initials: m.initials; tint: m.tint; art: m.art; art-tint: m.art-tint; size: 36px; } }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Body { text: m.name; overflow: elide; }
                if m.met || m.verified || m.admin: Caption {
                    text: (m.admin ? @tr("Admin") : "") + (m.admin && (m.met || m.verified) ? " · " : "") + (m.met ? @tr("Met in person") : m.verified ? @tr("Checked") : "");
                }
                // An admin's controls go under the name, so a long name
                // keeps its room on a phone.
                if root.group-admin: HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-s;
                    QuietButton {
                        text: m.admin ? @tr("Not admin") : @tr("Make admin");
                        accessible-label: (m.admin ? @tr("Stop {} being an admin", m.name) : @tr("Make {} an admin", m.name));
                        clicked => { root.set-group-admin(root.current-id, m.id, !m.admin); }
                    }
                    QuietButton {
                        text: @tr("Remove");
                        danger: true;
                        accessible-label: @tr("Remove {}", m.name);
                        clicked => { root.remove-member(root.current-id, m.id); }
                    }
                }
            }
        }
        if root.group-admin: SwitchRow {
            label: @tr("Only admins can post");
            detail: @tr("Everyone can still read, vote in polls and react.");
            on: root.announcement-only;
            toggled => { root.set-announcement-only(!root.announcement-only); }
        }
        if !root.group-admin && root.announcement-only: Caption {
            text: @tr("Only admins can post here. You can still vote in polls and react.");
            wrap: word-wrap;
        }
        if root.group-admin: SwitchRow {
            label: @tr("On the record");
            detail: root.on-record
                ? @tr("Messages carry their sender's signature. Anyone who gets a copy can prove who wrote them.")
                : @tr("Nobody can prove to others who wrote these messages.");
            on: root.on-record;
            toggled => { root.set-on-record(!root.on-record); }
        }
        if !root.group-admin: Caption {
            text: root.on-record
                ? @tr("On the record: messages carry their sender's signature. Admins can change this.")
                : @tr("Off the record: nobody can prove to others who wrote these messages. Admins can change this.");
            wrap: word-wrap;
        }
        if root.group-host-label != "": Secondary { text: root.group-host-label + root.group-vote-label; }
        if root.group-admin && root.servers.length > 1: HorizontalLayout {
            alignment: start;
            QuietButton {
                text: @tr("Vote to move the group");
                clicked => { root.server-pick-for = 2; root.chosen-server = ""; root.sheet = Sheet.servers; }
            }
        }
        if root.group-admin: UsesStepper { uses <=> root.invite-uses; }
        if root.group-admin: SwitchRow {
            label: @tr("Approve each join");
            detail: root.invite-approve
                ? @tr("People who use the link wait until you let them in.")
                : @tr("Anyone with the link joins straight away. Only send it to people you trust.");
            on: root.invite-approve;
            toggled => { root.invite-approve = !root.invite-approve; }
        }
        if root.group-admin: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            QuietButton {
                text: @tr("Copy invite link");
                accessible-label: @tr("Copy a group invite link");
                clicked => { root.new-group-invite(root.current-id, root.invite-uses, root.invite-approve); }
            }
        }
        if root.group-admin: Caption {
            text: @tr("A link works for 7 days, until you leave the group, or until you cancel it. People who join see only new messages.");
            wrap: word-wrap;
        }
        if root.group-admin && root.addable.length > 0: Body { text: @tr("Add people"); font-weight: 600; }
        if root.group-admin && root.addable.length > 0: Secondary { text: @tr("They'll see new messages from now on, not what was said before they joined."); }
        if root.group-admin: VerticalLayout {
        for p in root.addable: Rectangle {
            height: 56px;
            border-radius: Tokens.radius-control;
            background: p.selected ? Tokens.bubble-in : transparent;
            accessible-role: checkbox;
            accessible-checked: p.selected;
            accessible-label: p.name;
            accessible-action-default => { root.toggle-pick(p.id); }
            TouchArea { clicked => { root.toggle-pick(p.id); } }
            HorizontalLayout {
                padding-left: Tokens.space-s;
                padding-right: Tokens.space-s;
                spacing: Tokens.space-sm;
                VerticalLayout { alignment: center; Avatar { initials: p.initials; tint: p.tint; size: 36px; } }
                Body { text: p.name; vertical-alignment: center; horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: p.selected ? Tokens.pine : Tokens.text-muted;
                        background: p.selected ? Tokens.pine : transparent;
                        if p.selected: Path {
                            width: 16px;
                            height: 16px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M 5 12 L 10 17 L 19 7";
                            stroke: Tokens.on-pine;
                            stroke-width: 2.5px;
                        }
                    }
                }
            }
        }
        }
        if root.group-admin && root.addable.length > 0: HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? @tr("Adding…") : @tr("Add to group");
                enabled: !root.busy;
                clicked => { root.add-members(root.current-id); }
            }
        }
        if root.confirm-leave == "": HorizontalLayout {
            alignment: start;
            QuietButton { text: @tr("Leave group"); danger: true; clicked => { root.confirm-leave = root.current-id; } }
        }
        if root.confirm-leave != "": Notice {
            title: @tr("Leave {}?", root.current.name);
            text: @tr("You'll stop getting its messages. Someone would have to add you again.");
            kind: 2;
            HorizontalLayout {
                alignment: start;
                spacing: Tokens.space-s;
                PrimaryButton { text: @tr("Leave"); danger: true; clicked => { root.leave-group(root.current-id); root.confirm-leave = ""; } }
                QuietButton { text: @tr("Stay"); clicked => { root.confirm-leave = ""; } }
            }
        }
    }

    if root.sheet == Sheet.devices: SheetFrame {
        title: @tr("Your devices");
        close => { root.sheet = Sheet.none; }
        for d in root.devices: Rectangle {
            min-height: dev.preferred-height;
            dev := VerticalLayout {
            spacing: Tokens.space-s;
            HorizontalLayout {
                spacing: Tokens.space-sm;
                VerticalLayout {
                    horizontal-stretch: 1;
                    Body { text: d.label; font-weight: 600; }
                    Secondary { text: d.detail; }
                }
                if d.removable && root.confirm-remove != d.id: QuietButton {
                    text: @tr("Remove");
                    accessible-label: @tr("Remove {}", d.label);
                    clicked => { root.confirm-remove = d.id; }
                }
            }
            if d.history-action != "" && root.confirm-remove != d.id: HorizontalLayout {
                alignment: start;
                QuietButton {
                    text: d.history-action;
                    outlined: true;
                    accessible-label: d.history-action + ": " + d.label;
                    clicked => { root.send-history(d.id); }
                }
            }
            if root.confirm-remove == d.id: Rectangle {
                min-height: confirm.preferred-height;
                border-radius: Tokens.radius-control;
                border-width: 1px;
                border-color: Tokens.danger;
                confirm := VerticalLayout {
                    padding: Tokens.space-m;
                    spacing: Tokens.space-s;
                    Body { text: @tr("Remove this device?"); font-weight: 600; }
                    Secondary { text: @tr("It stops getting new messages, and your contacts stop sending to it. Messages already on it stay there until it's erased."); }
                    if root.has-root-pin: Field { placeholder: @tr("Your PIN"); secret: true; text <=> root.root-pin-input; }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-s;
                        PrimaryButton {
                            text: root.busy ? @tr("Removing…") : @tr("Remove device");
                            danger: true;
                            enabled: !root.busy;
                            clicked => { if root.has-root-pin { root.unlock-root(root.root-pin-input); root.root-pin-input = ""; } root.remove-device(d.id); }
                        }
                        QuietButton { text: @tr("Keep it"); clicked => { root.confirm-remove = ""; } }
                    }
                }
            }
        }
        }
        if root.can-link && root.link-choices.length == 0: Secondary {
            text: @tr("To link a new device, open Enclave on it, choose \"I already have Enclave\", and paste its link code here. Only do this with your own device.");
        }
        if root.can-link && root.link-choices.length == 0: HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: @tr("enclave:link#…"); mono: true; text <=> root.link-code; horizontal-stretch: 1; }
            if root.can-scan: QuietButton { text: @tr("Scan"); outlined: true; accessible-label: @tr("Scan the new device's code with the camera"); clicked => { root.scan(4); } }
        }
        if root.can-link && root.link-choices.length == 0: HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? @tr("Checking…") : @tr("Continue");
                enabled: root.link-code != "" && !root.busy;
                clicked => { root.link-scan(root.link-code); }
            }
        }
        if root.link-choices.length > 0: VerticalLayout {
            spacing: Tokens.space-s;
            Body { text: @tr("Which words does your new device show?"); font-weight: 600; }
            for c[i] in root.link-choices: QuietButton {
                text: c;
                outlined: true;
                clicked => { root.link-pick(i); }
            }
        }
        if root.link-status != "": Secondary { text: root.link-status; }
        if !root.can-link: Secondary { text: @tr("Only your first device can link new ones."); }
    }

    if root.sheet == Sheet.recovery: SheetFrame {
        title: @tr("Your recovery words");
        max-card-width: 640px;
        close => { root.sheet = Sheet.none; }
        Secondary {
            text: @tr("If you lose this device, these 24 words bring your account back. Anyone who has them can become you. Write them down on paper and keep them somewhere safe.");
        }
        // The same words in any of BIP-39's lists: whichever is written
        // down brings the same account back.
        Caption { text: @tr("Show them in:"); }
        GridLayout {
            spacing: Tokens.space-xs;
            for l[i] in [
                { code: "en", name: @tr("English") }, { code: "es", name: @tr("Español") },
                { code: "fr", name: @tr("Français") }, { code: "it", name: @tr("Italiano") },
                { code: "pt", name: @tr("Português") }, { code: "cs", name: @tr("Čeština") },
                { code: "ja", name: "日本語" }, { code: "ko", name: "한국어" },
                { code: @tr("zh-Hans"), name: "简体中文" }, { code: @tr("zh-Hant"), name: "繁體中文" },
            ]: QuietButton {
                row: root.wide ? i / 5 : i / 2;
                col: root.wide ? mod(i, 5) : mod(i, 2);
                text: l.name;
                outlined: l.code == root.words-language;
                accessible-label: @tr("Show the words in {}", l.name);
                clicked => { root.choose-words-language(l.code); }
            }
        }
        // Behind a PIN the words are wrapped: they show for two minutes
        // after it is entered.
        if root.can-change-words && root.has-root-pin && root.recovery-words.length == 0 && !root.busy: Secondary {
            text: @tr("Your words are locked with your PIN.");
        }
        if root.can-change-words && root.has-root-pin && root.recovery-words.length == 0 && !root.busy: HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: @tr("Your PIN"); secret: true; text <=> root.root-pin-input; horizontal-stretch: 1; }
            PrimaryButton {
                text: @tr("Show");
                clicked => { root.unlock-root(root.root-pin-input); root.root-pin-input = ""; }
            }
        }
        if root.can-change-words && root.has-root-pin && root.recovery-words.length == 0 && root.pin-error != "": Text {
            text: root.pin-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        GridLayout {
            spacing-horizontal: Tokens.space-m;
            spacing-vertical: Tokens.space-xs;
            // Read one word at a time, with its place (A-11).
            for w[i] in root.recovery-words: Rectangle {
                row: root.wide ? mod(i, 6) : i / 2;
                col: root.wide ? i / 6 : mod(i, 2);
                accessible-role: text;
                accessible-label: @tr("Word {} of {}: {}", i + 1, root.recovery-words.length, w);
                HorizontalLayout {
                    spacing: Tokens.space-s;
                    Caption { text: i + 1; width: 20px; horizontal-alignment: right; vertical-alignment: center; accessible-role: none; }
                    Text {
                        text: w;
                        font-family: "Atkinson Hyperlegible Mono";
                        font-size: Tokens.type-body;
                        color: Tokens.text;
                        accessible-role: none;
                    }
                }
            }
        }
        if root.busy: Secondary { text: @tr("Making your new words…"); }
        if !root.busy: HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.recovery-saved ? @tr("Done") : @tr("I've written them down");
                clicked => { root.words-saved(); root.sheet = Sheet.none; }
            }
        }
        if root.words-pending && !root.busy: Caption {
            text: @tr("Telling your contacts and groups about your new words. This finishes on its own.");
            wrap: word-wrap;
        }
        if root.can-change-words && !root.busy && !root.words-pending: Rectangle { height: 1px; background: Tokens.hairline; }
        if root.can-change-words && !root.busy && !root.words-pending: Secondary {
            text: @tr("Think someone may have seen them? You can replace them with new words.");
        }
        if root.can-change-words && !root.busy && !root.words-pending: HorizontalLayout {
            alignment: start;
            QuietButton {
                text: @tr("Change my words");
                outlined: true;
                clicked => { root.open-sheet(Sheet.change-words); }
            }
        }
        // A linked device: the words live on the first device.
        if !root.can-change-words && root.recovery-words.length == 0 && !root.busy && !root.words-pending: Secondary {
            text: @tr("Your recovery words are on the device you set Enclave up on first, not this one. Lost the words and that device too? You can make new words here.");
        }
        if !root.can-change-words && root.recovery-words.length == 0 && !root.busy && !root.words-pending: HorizontalLayout {
            alignment: start;
            QuietButton {
                text: @tr("Make new words");
                outlined: true;
                clicked => { root.open-sheet(Sheet.change-words); }
            }
        }
    }

    if root.sheet == Sheet.pack-preview: SheetFrame {
        title: root.pack-preview-title != "" ? root.pack-preview-title : @tr("Sticker pack");
        close => { root.sheet = Sheet.none; }
        Secondary {
            text: root.pack-preview-cells.length == 0 ? (root.busy ? @tr("Getting the pack…") : @tr("Enclave couldn't open this pack."))
                : @tr("{} stickers. Adding the pack keeps it on this device, sealed, for you to send from.", root.pack-preview-cells.length);
            wrap: word-wrap;
        }
        Flickable {
            height: 80px;
            content-width: root.pack-preview-cells.length * 76px;
            HorizontalLayout {
                spacing: 4px;
                for c in root.pack-preview-cells: Rectangle {
                    width: 72px;
                    height: 72px;
                    accessible-role: image;
                    accessible-label: @tr("Sticker {}", c.index + 1);
                    if c.has-image: Image { source: c.image; width: 64px; height: 64px; image-fit: contain; }
                    if !c.has-image: Caption { text: c.index + 1; }
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton {
                text: @tr("Add pack");
                enabled: root.pack-preview-cells.length > 0;
                clicked => { root.add-pack(root.pack-conversation, root.pack-seq); root.sheet = Sheet.none; }
            }
            QuietButton { text: @tr("Not now"); clicked => { root.sheet = Sheet.none; } }
        }
    }

    if root.sheet == Sheet.open-map: SheetFrame {
        title: @tr("Open in maps");
        close => { root.sheet = Sheet.none; }
        Body { text: @tr("This hands {} to a maps app you pick. That app may look the place up online, and its maker may learn it.", root.map-label != "" ? root.map-label + " (" + root.map-coordinates + ")" : root.map-coordinates); }
        HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton {
                text: @tr("Open");
                clicked => { root.open-map(root.map-coordinates, root.map-label); root.sheet = Sheet.none; }
            }
            QuietButton { text: @tr("Not now"); clicked => { root.sheet = Sheet.none; } }
        }
    }

    if root.sheet == Sheet.view-once: SheetFrame {
        title: @tr("View once");
        close => { root.sheet = Sheet.none; }
        Body { text: @tr("You can look at this once. Enclave doesn't keep it, here or on your other devices, and it can't be saved or forwarded."); }
        Secondary { text: @tr("Nothing stops a screenshot or another camera, and the sender isn't told if you take one."); }
        HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton {
                text: @tr("Open");
                clicked => { root.open-view-once(root.current-id, root.view-once-seq); }
            }
            QuietButton { text: @tr("Not now"); clicked => { root.sheet = Sheet.none; } }
        }
    }

    if root.sheet == Sheet.player: SheetFrame {
        title: root.player-once ? @tr("View once") : root.player-frames.length == 1 ? @tr("Picture") : @tr("Animated picture");
        // A view-once picture goes with the sheet.
        close => {
            if root.player-once { root.player-frames = []; root.player-once = false; }
            root.sheet = Sheet.none;
        }
        if root.player-frames.length == 0: Secondary { text: root.busy ? @tr("Getting it ready…") : @tr("Enclave couldn't open this one."); }
        if root.player-frames.length > 0: Rectangle {
            height: self.width * root.player-frames[0].height / max(1, root.player-frames[0].width);
            border-radius: Tokens.radius-control;
            clip: true;
            Image {
                source: root.player-frames[min(root.player-index, root.player-frames.length - 1)];
                width: parent.width;
                height: parent.height;
                image-fit: contain;
                accessible-role: image;
                accessible-label: root.player-frames.length == 1 ? @tr("Picture, full size") : @tr("Animated picture");
            }
        }
        // Plays on a loop while the sheet is open; reduce-motion shows the
        // first frame only.
        Timer {
            interval: root.player-interval;
            running: root.sheet == Sheet.player && root.player-frames.length > 1 && !Tokens.reduce-motion;
            triggered => { root.player-index = mod(root.player-index + 1, root.player-frames.length); }
        }
    }

    if root.sheet == Sheet.delete-account: SheetFrame {
        title: root.can-change-words ? @tr("Delete your account") : @tr("Erase this device");
        close => { root.sheet = Sheet.none; }
        if root.can-change-words: Body {
            text: @tr("This deletes your account for everyone. Your contacts see that you closed it, you leave every group, your username is withdrawn for good, and your server deletes your inboxes. Then everything on this device is erased, and your other devices erase themselves. It can't be undone.");
            wrap: word-wrap;
        }
        if !root.can-change-words: Body {
            text: @tr("This erases your conversations and keys from this device only. Your account goes on on your other devices.");
            wrap: word-wrap;
        }
        Field { placeholder: @tr("Type delete to confirm"); text <=> root.delete-confirm; }
        if root.has-root-pin && root.can-change-words: Field { placeholder: @tr("Your PIN"); secret: true; text <=> root.root-pin-input; }
        HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton {
                text: root.busy ? @tr("Deleting…") : (root.can-change-words ? @tr("Delete my account") : @tr("Erase this device"));
                danger: true;
                enabled: root.delete-confirm == "delete" && !root.busy;
                clicked => { if root.can-change-words { if root.has-root-pin { root.unlock-root(root.root-pin-input); root.root-pin-input = ""; } root.delete-account(); } else { root.erase-device(); } }
            }
            QuietButton { text: @tr("Keep it"); clicked => { root.sheet = Sheet.none; } }
        }
        if root.can-change-words: Rectangle { height: 1px; background: Tokens.hairline; }
        if root.can-change-words: Secondary { text: @tr("Only want Enclave gone from this device? Erase it instead; your account stays on your other devices."); }
        if root.can-change-words: HorizontalLayout {
            alignment: start;
            QuietButton { text: @tr("Erase only this device"); outlined: true; clicked => { if root.delete-confirm == "delete" && !root.busy { root.erase-device(); } } }
        }
    }

    if root.sheet == Sheet.change-words: SheetFrame {
        title: root.can-change-words ? @tr("Change your recovery words") : @tr("Make new recovery words");
        close => { root.sheet = Sheet.none; }
        Body {
            text: root.can-change-words
                ? @tr("Do this if someone may have seen your words. You'll get 24 new words, and the old ones stop working.")
                : @tr("Do this only if your words are lost and so is the device that had them. This device gets 24 new words and becomes the one that holds them.");
            wrap: word-wrap;
        }
        Secondary {
            text: root.can-change-words
                ? @tr("Everyone you talk to will see that your security code changed, and will be asked to check it again. Your conversations, groups and devices stay as they are.")
                : @tr("Without the old words Enclave can't prove to your contacts that this was you, so each of them is asked to check your security code in person. Your conversations, groups and devices stay as they are, and your username stays with the old words.");
        }
        Secondary {
            text: root.can-change-words
                ? @tr("Old invite links and codes stop working, and backups made with the old words won't restore. Save a new backup afterwards.")
                : @tr("Share new invite links and codes: old ones still lead to the account under the old words. Save a new backup afterwards.");
        }
        if root.has-root-pin: Field { placeholder: @tr("Your PIN"); secret: true; text <=> root.root-pin-input; }
        HorizontalLayout {
            spacing: Tokens.space-s;
            alignment: start;
            PrimaryButton {
                text: root.can-change-words ? @tr("Change my words") : @tr("Make new words");
                clicked => { if root.has-root-pin { root.unlock-root(root.root-pin-input); root.root-pin-input = ""; } root.change-words(); root.open-sheet(Sheet.recovery); }
            }
            QuietButton { text: @tr("Not now"); clicked => { root.sheet = Sheet.recovery; } }
        }
    }

    // ------------------------------------------------------- camera (scan)
    if root.scanning: Rectangle {
        background: #000000d9;
        accessible-role: groupbox;
        accessible-label: @tr("Scanning a code");
        TouchArea { }
        VerticalLayout {
            alignment: center;
            padding: Tokens.space-l;
            spacing: Tokens.space-m;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: min(root.width - 2 * Tokens.space-l, 480px);
                    height: self.width * 3 / 4;
                    border-radius: Tokens.radius-sheet;
                    background: #111;
                    clip: true;
                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.scan-frame;
                        image-fit: cover;
                        accessible-role: image;
                        accessible-label: @tr("Camera");
                    }
                    // The frame to hold the code in.
                    Rectangle {
                        width: parent.height * 0.6;
                        height: self.width;
                        border-width: 3px;
                        border-radius: 12px;
                        border-color: Tokens.saffron;
                    }
                }
            }
            Text {
                text: root.scan-error != "" ? root.scan-error : @tr("Hold their code up to the camera.");
                color: #ffffff;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: center;
                PrimaryButton { text: @tr("Cancel"); clicked => { root.stop-scan(); } }
            }
        }
    }

    // ------------------------------------------------------------- the call
    Timer {
        interval: 1s;
        running: root.voice-recording;
        triggered => { root.voice-recording-secs += 1; }
    }
    // The time on the call, counted here between snapshots (also while the
    // call is a tile).
    Timer {
        interval: 1s;
        running: root.call-state == 4;
        triggered => { root.call-elapsed += 1; }
    }
    if root.call-state != 0 && !root.call-small: Rectangle {
        background: #101914;
        accessible-role: groupbox;
        accessible-label: root.call-state == 2 ? @tr("Incoming call from {}", root.call-name) : @tr("Call with {}", root.call-name);
        TouchArea { }
        // The other person's picture, filling the window, under all of it.
        if root.call-video && root.call-has-remote && root.call-state == 4: Image {
            width: 100%;
            height: 100%;
            source: root.call-remote;
            // A shared screen whole; a face filling the window.
            image-fit: root.call-remote-screen ? contain : cover;
            accessible-role: image;
            accessible-label: root.call-remote-screen ? @tr("{}'s screen", root.call-name) : @tr("{}'s video", root.call-name);
        }
        // Our own, small, in a corner (mirrored, like a mirror).
        if root.call-video && (root.call-camera || root.call-screen) && (root.call-state == 3 || root.call-state == 4): Rectangle {
            x: parent.width - self.width - Tokens.space-m;
            y: Tokens.space-m;
            width: min(parent.width / 4, 200px);
            height: self.width * 3 / 4;
            border-radius: Tokens.radius-control;
            clip: true;
            background: #000;
            Image {
                width: 100%;
                height: 100%;
                source: root.call-self;
                image-fit: cover;
                accessible-role: image;
                accessible-label: @tr("Your video");
            }
        }
        // Back to the app, the call in a tile.
        if root.call-state == 1 || root.call-state == 3 || root.call-state == 4: Rectangle {
            x: Tokens.space-m;
            y: Tokens.space-m;
            width: 48px;
            height: 48px;
            border-radius: self.width / 2;
            background: shrink.pressed ? #ffffff40 : shrink.has-hover ? #ffffff26 : #ffffff14;
            accessible-role: button;
            accessible-label: @tr("Back to the app (the call goes on)");
            accessible-action-default => { root.call-small = true; }
            Path {
                width: 24px;
                height: 24px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Icons.back;
                stroke: #ffffff;
                stroke-width: 1.75px;
            }
            shrink := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.call-small = true; }
            }
        }
        VerticalLayout {
            alignment: center;
            padding: Tokens.space-xl;
            spacing: Tokens.space-m;
            if !(root.call-group && (root.call-state == 3 || root.call-state == 4)): HorizontalLayout {
                alignment: center;
                Avatar { initials: root.call-initials; tint: root.call-tint; size: 112px; }
            }
            if root.call-group && (root.call-state == 3 || root.call-state == 4) && root.call-peers.length > 0: CallGrid {
                min-height: 200px;
                vertical-stretch: 1;
                peers: root.call-peers;
            }
            Text {
                text: root.call-name;
                color: #ffffff;
                font-size: Tokens.type-screen-title;
                font-weight: 600;
                horizontal-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.call-state == 1 ? (root.call-note != "" ? root.call-note : @tr("Calling…"))
                    : root.call-state == 2 ? (root.call-video ? @tr("Incoming video call") : @tr("Incoming call"))
                    : root.call-state == 3 ? @tr("Connecting…")
                    : root.call-state == 4 && root.call-group && root.call-peers.length == 0 ? @tr("Waiting for others to join…")
                    : root.call-state == 4 ? (Math.floor(root.call-elapsed / 60) + ":" + (Math.mod(root.call-elapsed, 60) < 10 ? "0" : "") + Math.mod(root.call-elapsed, 60))
                    : root.call-note;
                color: #ffffffbf;
                font-size: Tokens.type-body;
                horizontal-alignment: center;
                wrap: word-wrap;
                accessible-role: text;
            }
            if root.call-words != "" && root.call-state >= 3 && root.call-state <= 4: VerticalLayout {
                spacing: Tokens.space-xs;
                padding-top: Tokens.space-s;
                Text {
                    text: @tr("To check the call, both of you read these out:");
                    color: #ffffff99;
                    font-size: Tokens.type-caption;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.call-words;
                    color: Tokens.saffron;
                    font-family: "Atkinson Hyperlegible Mono";
                    font-size: Tokens.type-mono-code;
                    horizontal-alignment: center;
                    accessible-label: @tr("Call check words: {}", root.call-words);
                }
            }
            if root.call-state != 5: Text {
                text: root.call-group
                    ? @tr("Group call: voices and pictures are sealed for the group; the relays pass them on without being able to read them.")
                    : root.call-state == 2 && root.call-direct-asked
                    ? @tr("{} asked for a direct call: clearer, but answering directly shows your internet address to them.", root.call-name)
                    : root.call-direct
                    ? @tr("Direct: you and {} can see each other's internet address.", root.call-name)
                    : @tr("Private route: two relays, run by different operators, so neither sees both of you.");
                color: #ffffff73;
                font-size: Tokens.type-caption;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            for k in root.call-knocks: HorizontalLayout {
                alignment: center;
                spacing: Tokens.space-s;
                Text {
                    text: @tr("{} is asking to join", k.name);
                    color: #ffffff;
                    font-size: Tokens.type-body;
                    vertical-alignment: center;
                    overflow: elide;
                }
                CallPill {
                    text: @tr("Let in");
                    tint: #1f6f50;
                    clicked => { root.admit-call(k.id); }
                }
                CallPill {
                    text: @tr("Turn away");
                    clicked => { root.refuse-call(k.id); }
                }
            }
            if root.call-group && root.call-state == 4 && root.call-link != "": VerticalLayout {
                spacing: Tokens.space-xs;
                Text {
                    text: root.call-link;
                    color: #ffffffbf;
                    font-family: "Atkinson Hyperlegible Mono";
                    font-size: Tokens.type-caption;
                    horizontal-alignment: center;
                    overflow: elide;
                    accessible-label: @tr("Call link");
                }
                HorizontalLayout {
                    alignment: center;
                    CallPill {
                        text: @tr("Copy call link");
                        clicked => { root.copy-text(root.call-link); }
                    }
                }
            }
            if root.call-group && root.call-state == 4 && root.call-link == "" && !root.call-link-choosing: HorizontalLayout {
                alignment: center;
                CallPill {
                    text: @tr("Invite with a link");
                    clicked => { root.call-link-choosing = true; }
                }
            }
            if root.call-group && root.call-state == 4 && root.call-link == "" && root.call-link-choosing: VerticalLayout {
                spacing: Tokens.space-xs;
                Text {
                    text: @tr("Anyone with the link can ask to join. Share it only with people you'd let in.");
                    color: #ffffffbf;
                    font-size: Tokens.type-caption;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: Tokens.space-s;
                    CallPill {
                        text: @tr("Ask me first");
                        tint: #ffffff;
                        ink: #101914;
                        clicked => { root.call-link-choosing = false; root.create-call-link(true); }
                    }
                    CallPill {
                        text: @tr("Let anyone in");
                        clicked => { root.call-link-choosing = false; root.create-call-link(false); }
                    }
                }
            }
            if root.call-group && root.call-cameras-full && root.call-camera: Text {
                text: @tr("Up to 8 cameras can be on at once. Yours comes on when one goes off.");
                color: Tokens.saffron;
                font-size: Tokens.type-caption;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if root.call-group && root.call-state == 4: HorizontalLayout {
                alignment: center;
                spacing: Tokens.space-s;
                for r in ["👍", "👏", "😂", "❤️", "🎉"]: Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: self.width / 2;
                    background: react.pressed ? #ffffff40 : react.has-hover ? #ffffff26 : #ffffff14;
                    accessible-role: button;
                    accessible-label: @tr("React {}", r);
                    accessible-action-default => { root.react-call(r); }
                    Text { text: r; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                    react := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.react-call(r); }
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                spacing: Tokens.space-xl;
                padding-top: Tokens.space-l;
                if root.call-state == 2: CallButton {
                    icon: Icons.close;
                    label: @tr("Decline");
                    tint: #b3261e;
                    ink: #ffffff;
                    clicked => { root.decline-call(); }
                }
                if root.call-state == 2: CallButton {
                    icon: root.call-video ? Icons.video : Icons.phone;
                    label: root.call-group ? @tr("Join") : root.call-direct-asked ? @tr("Answer privately") : @tr("Answer");
                    tint: #1f6f50;
                    ink: #ffffff;
                    clicked => { root.answer-call(); }
                }
                if root.call-state == 2 && root.call-direct-asked: CallButton {
                    icon: root.call-video ? Icons.video : Icons.phone;
                    label: @tr("Answer directly");
                    tint: #ffffff26;
                    ink: #ffffff;
                    clicked => { root.answer-call-direct(); }
                }
                if root.call-state == 3 || root.call-state == 4: CallButton {
                    icon: root.call-muted ? Icons.mic-off : Icons.voice;
                    label: root.call-muted ? @tr("Unmute") : @tr("Mute");
                    tint: root.call-muted ? #ffffff : #ffffff26;
                    ink: root.call-muted ? #101914 : #ffffff;
                    clicked => { root.mute-call(!root.call-muted); }
                }
                if root.call-video && (root.call-state == 3 || root.call-state == 4): CallButton {
                    icon: Icons.video;
                    label: root.call-camera ? @tr("Camera off") : @tr("Camera on");
                    tint: root.call-camera ? #ffffff26 : #ffffff;
                    ink: root.call-camera ? #ffffff : #101914;
                    clicked => { root.camera-call(!root.call-camera); }
                }
                if root.call-video && (root.call-state == 3 || root.call-state == 4): CallButton {
                    icon: Icons.screen-share;
                    label: root.call-screen ? @tr("Stop sharing") : @tr("Share screen");
                    tint: root.call-screen ? #ffffff : #ffffff26;
                    ink: root.call-screen ? #101914 : #ffffff;
                    clicked => { root.screen-call(!root.call-screen); }
                }
                if root.call-group && (root.call-state == 3 || root.call-state == 4): CallButton {
                    icon: Icons.hand;
                    label: root.call-hand ? @tr("Lower hand") : @tr("Raise hand");
                    tint: root.call-hand ? Tokens.saffron : #ffffff26;
                    ink: root.call-hand ? #101914 : #ffffff;
                    clicked => { root.hand-call(!root.call-hand); }
                }
                if root.call-state == 1 || root.call-state == 3 || root.call-state == 4: CallButton {
                    icon: Icons.phone;
                    label: root.call-group ? @tr("Leave") : @tr("Hang up");
                    tint: #b3261e;
                    ink: #ffffff;
                    clicked => { root.end-call(); }
                }
            }
        }
    }

    // The call as a tile over the app: the other person's picture (or who
    // and how long), tap to go back to the call, or hang up.
    if root.call-small && (root.call-state == 1 || root.call-state == 3 || root.call-state == 4): tile := Rectangle {
        property <bool> picture: root.call-video && root.call-has-remote && root.call-state == 4;
        x: parent.width - self.width - Tokens.space-m;
        y: 84px;
        width: 184px;
        height: self.picture ? 184px : 64px;
        border-radius: Tokens.radius-control;
        clip: true;
        background: #101914;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000059;
        accessible-role: groupbox;
        accessible-label: @tr("Call with {}", root.call-name);
        open := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.call-small = false; }
        }
        if tile.picture: Image {
            y: 0;
            width: 100%;
            height: tile.height - 48px;
            source: root.call-remote;
            image-fit: cover;
            accessible-role: image;
            accessible-label: @tr("{}'s video", root.call-name);
        }
        HorizontalLayout {
            y: tile.height - 48px - 8px;
            height: 48px;
            padding-left: Tokens.space-s;
            padding-right: 8px;
            spacing: Tokens.space-s;
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.call-name;
                    color: #ffffff;
                    font-size: Tokens.type-body;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.call-state == 1 ? @tr("Calling…")
                        : root.call-state == 3 ? @tr("Connecting…")
                        : (Math.floor(root.call-elapsed / 60) + ":" + (Math.mod(root.call-elapsed, 60) < 10 ? "0" : "") + Math.mod(root.call-elapsed, 60))
                            + (root.call-muted ? " · " + @tr("Muted") : "");
                    color: #ffffffbf;
                    font-size: Tokens.type-caption;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: self.width / 2;
                    background: hang.pressed ? #b3261e.darker(20%) : #b3261e;
                    accessible-role: button;
                    accessible-label: @tr("Hang up");
                    accessible-action-default => { root.end-call(); }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: Icons.phone;
                        stroke: #ffffff;
                        stroke-width: 1.75px;
                    }
                    hang := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.end-call(); }
                    }
                }
            }
        }
    }
}
