// Enclave app window. Point of view (docs/17-design.md): private
// correspondence done well: warm paper, deep pine ink, and one saffron seal
// that appears only when something has really been confirmed.
import "fonts/AtkinsonHyperlegibleNext-Regular.ttf";
import "fonts/AtkinsonHyperlegibleNext-SemiBold.ttf";
import "fonts/AtkinsonHyperlegibleMono-Regular.ttf";
// Emoji (reactions, and emoji people type): Noto Emoji, monochrome outlines.
import "fonts/NotoEmoji-Regular.ttf";
import { Tokens } from "tokens.slint";
import {
    Body, Secondary, Caption, Title, ScreenTitle, Code, Seal, SealState, PrimaryButton,
    QuietButton, ActionTile, Field, Avatar, Notice, Icons,
} from "controls.slint";

export { Tokens }

// 0 = waiting for them, 1 = request to us, 2 = talking.
export struct ContactRow {
    id: string,
    name: string,
    initials: string,
    tint: color,
    preview: string,
    time: string,
    unread: int,
    state: int,
    verified: bool,
    met: bool,
    // 0 person, 1 group
    kind: int,
    members: int,
    pinned: bool,
    muted: bool,
    archived: bool,
    blocked: bool,
    // A group member who is an admin (members sheet).
    admin: bool,
    // Contact art: filled cells in bits 0–24 (0 for none), and its tint.
    art: int,
    art-tint: color,
}

export struct PickRow {
    id: string,
    name: string,
    initials: string,
    tint: color,
    selected: bool,
}

export struct DeviceRow {
    id: string,
    label: string,
    detail: string,
    removable: bool,
    history-action: string,
}

// status: 0 sending privately, 1 on its way, 2 delivered, 3 read,
// 4 not delivered yet.
export struct PollOption {
    text: string,
    count: int,
    mine: bool,
}

export struct MessageRow {
    text: string,
    outgoing: bool,
    time: string,
    status: int,
    sender: string,
    // Position in the conversation (decimal), for actions on it.
    seq: string,
    can-edit: bool,
    deleted: bool,
    file: string,
    // A picture: its preview comes separately (decoded by mediad).
    picture: bool,
    has-image: bool,
    image: image,
    // 0 not a poll, 1 open, 2 closed, 3 closed with a different tally.
    poll-state: int,
    poll-options: [PollOption],
    poll-ours: bool,
    pinned: bool,
    // A shared contact (empty when the message isn't one).
    contact-name: string,
    contact-initials: string,
    contact-known: bool,
    // A shared place: coordinates (empty when the message isn't one).
    location: string,
    location-label: string,
    sticker: bool,
    pack-added: bool,
    // A voice note: its waveform (0–255 per bar) and length, "0:42".
    voice: bool,
    waveform: [int],
    voice-time: string,
    // An animated picture (a clip): its length, "0:03"; empty otherwise.
    clip-time: string,
}

// A server from the foundation's list. votes: admins of the open group who
// voted to move it there.
export struct ServerOption {
    id: string,
    domain: string,
    operator: string,
    votes: int,
}

export struct StickerPackRow {
    id: string,
    title: string,
    count: int,
}

// One sticker in the picker; its picture comes as a preview.
export struct StickerCell {
    pack: string,
    index: int,
    has-image: bool,
    image: image,
}

export enum Screen { welcome, name, setting-up, join, locked, main, restore }
export enum Sheet { none, servers, my-code, add, check-code, settings, recovery, new-group, devices, meet, timer, attach, members, poll, friends, share, conversation, share-contact, location, gallery, report, stickers, new-pack, change-words, player, delete-account }

component DeliveryMark inherits Rectangle {
    in property <int> status;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    border-width: 1.5px;
    border-color: root.status == 4 ? Tokens.danger : Tokens.meta-on-bubble-out;
    background: root.status == 2 || root.status == 3 ? Tokens.meta-on-bubble-out : transparent;
    accessible-role: image;
    accessible-label: root.status == 0 ? "Sending privately"
        : root.status == 1 ? "On its way"
        : root.status == 2 ? "Delivered"
        : root.status == 3 ? "Read"
        : "Not delivered yet";
    // Read: a second ring around the filled mark.
    if root.status == 3: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: self.width / 2;
        border-width: 1px;
        border-color: Tokens.meta-on-bubble-out;
    }
    if root.status == 1: Rectangle {
        x: 0;
        width: parent.width / 2;
        border-top-left-radius: 5px;
        border-bottom-left-radius: 5px;
        background: Tokens.meta-on-bubble-out;
    }
}

component Bubble inherits HorizontalLayout {
    in property <MessageRow> msg;
    in property <length> bubble-max;
    in property <bool> selected;
    callback tapped();
    callback vote(int);
    callback close-poll();
    callback add-contact();
    callback copy(string);
    callback add-pack();
    callback play-clip();
    alignment: root.msg.outgoing ? end : start;
    Rectangle {
        max-width: root.bubble-max;
        // A sticker stands on its own, without a bubble.
        background: root.msg.sticker ? transparent : root.msg.outgoing ? Tokens.bubble-out : Tokens.bubble-in;
        border-width: root.selected ? 2px : 0px;
        border-color: Tokens.focus-ring;
        TouchArea { clicked => { root.tapped(); } }
        border-top-left-radius: Tokens.radius-bubble;
        border-top-right-radius: Tokens.radius-bubble;
        border-bottom-left-radius: root.msg.outgoing ? Tokens.radius-bubble : Tokens.radius-bubble-tail;
        border-bottom-right-radius: root.msg.outgoing ? Tokens.radius-bubble-tail : Tokens.radius-bubble;
        accessible-role: text;
        accessible-label: (root.msg.outgoing ? "You: " : "") + (root.msg.picture ? "Photo: " + root.msg.file + ". " : "") + (root.msg.sticker ? "Sticker. " : "") + (root.msg.voice ? "Voice note, " + (root.msg.voice-time != "" ? root.msg.voice-time : "length unknown") + ". Select it to save it as a sound file. " : "") + (root.msg.contact-name != "" ? "Contact: " + root.msg.contact-name + ". " : "") + (root.msg.location != "" ? "Location: " + root.msg.location-label + " " + root.msg.location + ". " : "") + root.msg.text + ", " + root.msg.time;
        accessible-action-default => { root.tapped(); }
        VerticalLayout {
            padding-left: Tokens.space-sm;
            padding-right: Tokens.space-sm;
            padding-top: Tokens.space-s;
            padding-bottom: Tokens.space-s;
            spacing: Tokens.space-xs;
            if !root.msg.outgoing && root.msg.sender != "": Text {
                text: root.msg.sender;
                font-size: Tokens.type-caption;
                font-weight: 600;
                color: Tokens.pine;
            }
            if root.msg.voice: HorizontalLayout {
                spacing: Tokens.space-sm;
                VerticalLayout {
                    alignment: center;
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: Icons.voice;
                        stroke: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.pine;
                        stroke-width: 1.75px;
                    }
                }
                HorizontalLayout {
                    spacing: 2px;
                    alignment: center;
                    for w in root.msg.waveform: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 3px;
                            height: max(3px, w * 28px / 255);
                            border-radius: 1.5px;
                            background: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.pine;
                        }
                    }
                    if root.msg.waveform.length == 0: Caption { text: "Voice note"; vertical-alignment: center; }
                }
                Text {
                    text: root.msg.voice-time;
                    font-size: Tokens.type-caption;
                    color: root.msg.outgoing ? Tokens.meta-on-bubble-out : Tokens.text-muted;
                    vertical-alignment: center;
                }
            }
            if root.msg.sticker && !root.msg.has-image: Rectangle {
                width: 120px;
                height: 120px;
                border-radius: Tokens.radius-control;
                background: Tokens.bubble-in;
                Caption { text: "Sticker"; }
            }
            if root.msg.has-image: Rectangle {
                // Natural size, narrowed to the bubble, aspect kept; stickers
                // at most 160 px.
                width: min(root.msg.sticker ? 160px : root.bubble-max - 2 * Tokens.space-sm, root.msg.image.width * 1px);
                height: self.width * root.msg.image.height / max(1, root.msg.image.width);
                border-radius: Tokens.radius-control;
                clip: true;
                Image {
                    source: root.msg.image;
                    width: parent.width;
                    height: parent.height;
                    image-fit: fill;
                    accessible-role: image;
                    accessible-label: "Picture: " + root.msg.file;
                }
            }
            if root.msg.contact-name != "": HorizontalLayout {
                spacing: Tokens.space-sm;
                VerticalLayout {
                    alignment: center;
                    Avatar { initials: root.msg.contact-initials; tint: Tokens.pine; size: 36px; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.msg.contact-name;
                        font-size: Tokens.type-body;
                        font-weight: 600;
                        color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.text;
                    }
                    Text {
                        text: root.msg.outgoing ? "Contact you shared" : root.msg.contact-known ? "Someone you already talk to" : "Contact. Check their code when you meet.";
                        font-size: Tokens.type-caption;
                        color: root.msg.outgoing ? Tokens.meta-on-bubble-out : Tokens.text-muted;
                        wrap: word-wrap;
                    }
                }
                if !root.msg.outgoing && !root.msg.contact-known: VerticalLayout {
                    alignment: center;
                    QuietButton { text: "Add"; outlined: true; clicked => { root.add-contact(); } }
                }
            }
            if root.msg.location != "": VerticalLayout {
                spacing: 2px;
                Text {
                    text: root.msg.location-label != "" ? root.msg.location-label : "Location";
                    font-size: Tokens.type-body;
                    font-weight: 600;
                    color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.text;
                }
                Text {
                    text: root.msg.location;
                    font-family: "Atkinson Hyperlegible Mono";
                    font-size: Tokens.type-secondary;
                    color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.text;
                }
                HorizontalLayout {
                    alignment: start;
                    QuietButton {
                        text: "Copy coordinates";
                        accessible-label: "Copy coordinates " + root.msg.location;
                        clicked => { root.copy(root.msg.location); }
                    }
                }
            }
            if root.msg.clip-time != "" && !root.msg.deleted: HorizontalLayout {
                alignment: start;
                QuietButton {
                    text: "Play · " + root.msg.clip-time;
                    accessible-label: "Play animated picture, " + root.msg.clip-time;
                    clicked => { root.play-clip(); }
                }
            }
            if root.msg.picture && !root.msg.has-image: Text {
                text: "Photo: " + root.msg.file;
                font-size: Tokens.type-body;
                color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.text;
                wrap: word-wrap;
            }
            if root.msg.sticker && !root.msg.outgoing && !root.msg.pack-added && !root.msg.deleted: HorizontalLayout {
                alignment: start;
                QuietButton {
                    text: "Add pack";
                    accessible-label: "Add this sticker pack";
                    clicked => { root.add-pack(); }
                }
            }
            if root.msg.text != "": Text {
                text: root.msg.text;
                font-size: Tokens.type-body;
                font-weight: root.msg.poll-state > 0 ? 600 : 400;
                color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.text;
                wrap: word-wrap;
            }
            for o[i] in root.msg.poll-options: Rectangle {
                min-width: 220px;
                height: 40px;
                border-radius: Tokens.radius-control;
                border-width: o.mine ? 2px : 1px;
                border-color: o.mine ? Tokens.pine : Tokens.hairline;
                accessible-role: button;
                accessible-label: o.text + ", " + o.count + (o.count == 1 ? " vote" : " votes") + (o.mine ? ", your vote" : "");
                accessible-action-default => { if root.msg.poll-state == 1 { root.vote(i); } }
                TouchArea {
                    enabled: root.msg.poll-state == 1;
                    mouse-cursor: root.msg.poll-state == 1 ? pointer : default;
                    clicked => { root.vote(i); }
                }
                HorizontalLayout {
                    padding-left: Tokens.space-sm;
                    padding-right: Tokens.space-sm;
                    spacing: Tokens.space-s;
                    Text {
                        text: o.text;
                        font-size: Tokens.type-body;
                        color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: o.count;
                        font-size: Tokens.type-secondary;
                        font-weight: 600;
                        color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.text;
                        vertical-alignment: center;
                    }
                }
            }
            if root.msg.poll-state >= 2: Text {
                text: root.msg.poll-state == 2 ? "Closed." : "Closed. The count the person who asked sees differs from yours, so some votes may not have reached everyone.";
                font-size: Tokens.type-caption;
                color: root.msg.outgoing ? Tokens.meta-on-bubble-out : Tokens.text-muted;
                wrap: word-wrap;
            }
            if root.msg.poll-state == 1 && root.msg.poll-ours: HorizontalLayout {
                alignment: start;
                QuietButton { text: "Close poll"; clicked => { root.close-poll(); } }
            }
            HorizontalLayout {
                alignment: end;
                spacing: Tokens.space-xs;
                Text {
                    text: root.msg.time;
                    font-size: Tokens.type-caption;
                    color: root.msg.outgoing ? Tokens.meta-on-bubble-out : Tokens.text-muted;
                    vertical-alignment: center;
                }
                // A negative status (notes to self) shows no mark.
                if root.msg.outgoing && root.msg.status >= 0: VerticalLayout {
                    alignment: center;
                    DeliveryMark { status: root.msg.status; }
                }
            }
        }
    }
}

component ContactItem inherits Rectangle {
    in property <ContactRow> item;
    in property <bool> selected;
    callback clicked();
    height: 72px;
    background: root.selected ? Tokens.bubble-in : touch.has-hover ? Tokens.surface : transparent;
    border-radius: Tokens.radius-control;
    accessible-role: list-item;
    accessible-label: root.item.name + (root.item.pinned ? ", pinned" : "") + (root.item.muted ? ", muted" : "") + (root.item.unread > 0 ? ", " + root.item.unread + " unread" : "") + ", " + root.item.preview;
    accessible-action-default => { clicked(); }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: Tokens.space-sm;
        padding-right: Tokens.space-sm;
        spacing: Tokens.space-sm;
        VerticalLayout {
            alignment: center;
            Avatar { initials: root.item.initials; tint: root.item.tint; art: root.item.art; art-tint: root.item.art-tint; size: 44px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: Tokens.space-xs;
                Text {
                    text: root.item.name;
                    font-size: Tokens.type-body;
                    font-weight: root.item.unread > 0 ? 600 : 400;
                    color: Tokens.text;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.item.verified: VerticalLayout {
                    alignment: center;
                    Seal { state: SealState.checked; size: 16px; }
                }
                if root.item.pinned: VerticalLayout {
                    alignment: center;
                    Path {
                        width: 14px;
                        height: 14px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: Icons.pin;
                        stroke: Tokens.text-muted;
                        stroke-width: 2px;
                    }
                }
                Caption { text: root.item.time; vertical-alignment: center; }
            }
            HorizontalLayout {
                spacing: Tokens.space-s;
                Text {
                    text: root.item.blocked ? "Blocked" : root.item.state == 1 ? "Wants to talk" : root.item.state == 0 ? "Waiting for them to accept" : root.item.preview;
                    font-size: Tokens.type-secondary;
                    color: Tokens.text-muted;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.item.unread > 0: Rectangle {
                    min-width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    // Muted: the count is still there, without the Pine.
                    background: root.item.muted ? Tokens.hairline : Tokens.pine;
                    Text {
                        text: root.item.unread;
                        font-size: Tokens.type-caption;
                        font-weight: 600;
                        color: root.item.muted ? Tokens.text : Tokens.on-pine;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// A labelled on/off switch filling one row.
component SwitchRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> on;
    callback toggled();
    min-height: max(Tokens.space-touch-target-min, row.preferred-height);
    accessible-role: checkbox;
    accessible-checked: root.on;
    accessible-label: root.label;
    accessible-description: root.detail;
    accessible-action-default => { root.toggled(); }
    TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
    row := HorizontalLayout {
        spacing: Tokens.space-m;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Body { text: root.label; }
            Secondary { text: root.detail; }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 26px;
                border-radius: 13px;
                background: root.on ? Tokens.pine : transparent;
                border-width: root.on ? 0px : 2px;
                border-color: Tokens.text-muted;
                Rectangle {
                    x: root.on ? parent.width - self.width - 4px : 4px;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: root.on ? Tokens.on-pine : Tokens.text-muted;
                    animate x { duration: Tokens.reduce-motion ? 0ms : Tokens.motion-duration-default; easing: ease-out; }
                }
            }
        }
    }
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> filled: false;
    callback clicked();
    width: Tokens.space-touch-target-min;
    height: Tokens.space-touch-target-min;
    border-radius: root.filled ? self.width / 2 : Tokens.radius-control;
    background: root.filled ? (touch.pressed ? Tokens.pine.darker(20%) : Tokens.pine) : (touch.has-hover ? Tokens.bubble-in : transparent);
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Path {
        width: 24px;
        height: 24px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        stroke: root.filled ? Tokens.on-pine : Tokens.pine;
        stroke-width: 1.75px;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        key-pressed(e) => {
            if e.text == " " || e.text == "\n" { root.clicked(); return accept; }
            reject
        }
    }
    if focus.has-focus: Rectangle {
        border-radius: parent.border-radius;
        border-width: Tokens.icon-focus-ring-width;
        border-color: Tokens.focus-ring;
    }
}

component SheetFrame inherits Rectangle {
    in property <string> title;
    in property <length> max-card-width: 520px;
    callback close();
    background: #0000008c;
    accessible-role: groupbox;
    accessible-label: root.title;
    TouchArea { clicked => { root.close(); } }
    card := Rectangle {
        width: min(root.width - 2 * Tokens.space-m, root.max-card-width);
        // As tall as its content, up to the window; beyond that the body
        // scrolls under a fixed title row.
        height: min(root.height - 2 * Tokens.space-m, frame.padding-top + head.preferred-height + Tokens.space-m + inner.preferred-height);
        background: Tokens.surface;
        border-radius: Tokens.radius-sheet;
        clip: true;
        TouchArea { }
        frame := VerticalLayout {
            padding-top: Tokens.space-l;
            spacing: Tokens.space-m;
            head := HorizontalLayout {
                padding-left: Tokens.space-l;
                padding-right: Tokens.space-l;
                spacing: Tokens.space-s;
                Title { text: root.title; vertical-alignment: center; horizontal-stretch: 1; }
                IconButton { icon: Icons.close; label: "Close"; clicked => { root.close(); } }
            }
            body := Flickable {
                vertical-stretch: 1;
                viewport-width: self.width;
                viewport-height: inner.preferred-height;
                inner := VerticalLayout {
                    x: 0;
                    y: 0;
                    width: body.width;
                    padding-left: Tokens.space-l;
                    padding-right: Tokens.space-l;
                    padding-bottom: Tokens.space-l;
                    spacing: Tokens.space-m;
                    @children
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Enclave";
    preferred-width: 1180px;
    preferred-height: 780px;
    min-width: 360px;
    min-height: 560px;
    background: Tokens.background;
    default-font-family: "Atkinson Hyperlegible Next";
    default-font-size: Tokens.type-body;

    in-out property <Screen> screen: Screen.welcome;
    in-out property <Sheet> sheet: Sheet.none;
    in property <string> my-name;
    in property <string> my-initials;
    in property <color> my-tint: Tokens.pine;
    in property <[ContactRow]> contacts;
    in property <[ContactRow]> requests;
    in property <[ContactRow]> archived;
    in-out property <bool> show-archived;
    callback conv-prefs(string, bool, bool, bool);
    callback set-on-record(bool);
    callback block(string, bool);
    callback share-contact(string, string);
    callback add-shared(string, string);
    callback share-location(string, string, string, string);
    callback report(string, int, bool, bool, bool);
    callback add-pack(string, string);
    callback send-sticker(string, string, int);
    callback load-stickers();
    in property <bool> typing-setting;
    in property <bool> typing;
    callback set-typing-setting(bool);
    in property <bool> can-change-words;
    in property <string> held-moves;
    in property <bool> words-pending;
    in property <int> moved;
    callback change-words();
    callback play-clip(string, string);
    in property <[image]> player-frames;
    in-out property <int> player-index;
    in property <duration> player-interval: 66ms;
    callback draft-changed(string, bool);
    callback create-pack(string, string);
    in property <[StickerPackRow]> sticker-packs;
    in property <[StickerCell]> sticker-cells;
    in-out property <string> pack-title;
    in-out property <string> pack-paths;
    in-out property <string> pack-error;
    in-out property <int> report-reason: 1;
    in-out property <bool> report-quote: true;
    in-out property <bool> report-block: true;
    in-out property <bool> report-costlier: true;
    in-out property <string> location-lat;
    // Photos and files in the open conversation.
    in property <int> gallery-count;
    in-out property <string> location-lon;
    in-out property <string> location-name;
    in property <[MessageRow]> messages;
    in-out property <string> current-id;
    in property <ContactRow> current;
    in property <string> my-link;
    in property <image> my-qr;
    in property <[string]> code-groups;
    in property <string> add-error;
    in property <string> my-username;
    in property <bool> usernames;
    in property <string> username-error;
    in-out property <string> username-input;
    in property <bool> busy;
    in property <string> status-line;
    in property <bool> show-delivery-hint: true;
    in-out property <int> privacy: 0;
    in property <[string]> recovery-words;
    // BIP-39 list the words are shown in (`en`, `es`, … `zh-Hant`).
    in property <string> words-language: "en";
    // The security code as 10 words, and whether they're in English.
    in property <[string]> code-words;
    in property <bool> code-words-english;
    callback code-words-english-toggled(bool);
    callback choose-words-language(string);
    in property <[PickRow]> pick;
    in property <[DeviceRow]> devices;
    in property <[string]> link-choices;
    in property <string> link-status;
    in property <bool> can-link;
    in-out property <string> group-name;
    in-out property <string> link-code;
    in property <bool> recovery-saved;
    // Maximum privacy is holding what was written here until all three
    // KEMs protect the conversation.
    in property <bool> finishing;
    in property <bool> gap;
    // The current conversation is on the record; its contact closed their
    // account.
    in property <bool> on-record;
    in property <bool> closed;
    in-out property <string> draft;
    in-out property <string> add-link;
    in-out property <string> add-text;
    in-out property <string> name-input;

    callback get-started();
    callback create-account(string);
    callback select(string);
    callback send(string, string);
    callback accept(string);
    callback decline(string);
    callback add-contact(string, string);
    callback claim-username(string);
    callback remove-device(string);
    callback send-history(string);
    callback start-join();
    callback sheet-changed(Sheet);
    changed sheet => { root.sheet-changed(root.sheet); }
    callback cancel-join();
    in property <bool> can-join;
    in property <string> join-code;
    in property <image> join-qr;
    in property <string> join-words;
    in property <string> recovery-alert;
    in property <string> recovery-hold;
    in property <bool> recovery-stopped;
    in property <string> username-problem;
    in property <string> kt-split;
    in property <string> clock-skew;
    in property <string> new-device;
    // 0 the mixnet, 1 offer the backup route, 2 on the backup route.
    in property <int> route;
    // Censorship mode: Tor didn't come up; the bridges set (empty,
    // "builtin" or lines), why some weren't taken, and whether they wait
    // for a restart.
    in property <bool> tor-blocked;
    in property <string> bridges;
    in property <string> bridges-error;
    in property <bool> bridges-restart;
    in-out property <string> bridges-input;
    in property <string> joining;
    in property <string> restore-error;
    in property <[PickRow]> friends;
    in property <int> friends-chosen;
    in property <[string]> share-holders;
    in property <int> share-threshold;
    in property <bool> holds-share;
    in property <string> share-release;
    in property <string> share-release-words;
    in property <image> share-release-qr;
    in-out property <string> share-request-input;
    in property <string> share-request;
    in property <string> share-request-words;
    in property <image> share-request-qr;
    in-out property <string> restore-words;
    in-out property <string> restore-s1;
    in-out property <string> restore-s2;
    in-out property <string> restore-s3;
    in-out property <string> restore-s4;
    in-out property <string> restore-s5;
    in-out property <string> restore-file;
    callback restore(string, string, string, string, string, string, string);
    callback save-backup(bool);
    callback set-server-backup(bool);
    // The servers to pick from, and what picking is for: 0 setting up,
    // 1 moving the account, 2 voting to move the open group.
    in property <[ServerOption]> servers;
    in property <string> home-id;
    in property <string> home-label;
    in property <bool> moving;
    in property <bool> can-move;
    in property <string> group-host;
    in property <string> group-host-label;
    in property <string> group-vote-label;
    in property <int> group-admins;
    in-out property <int> server-pick-for;
    in-out property <string> chosen-server;
    callback pick-server(int, string);
    callback check-backup(string, string);
    in-out property <bool> backup-media;
    in property <bool> server-backup;
    in property <string> server-backup-at;
    in property <string> backup-check;
    in-out property <string> check-words;
    in-out property <string> check-file;
    callback give-shares(int);
    callback reveal-share(string);
    callback release-share(string);
    callback delete-account();
    callback set-root-pin(string);
    callback secure-account();
    callback set-previews(bool);
    in property <bool> previews;
    in property <bool> securing;
    callback unlock-root(string);
    in property <bool> has-root-pin;
    in property <string> pin-error;
    in-out property <string> root-pin-input;
    in-out property <string> new-pin-input;
    callback erase-device();
    in property <bool> removed;
    in-out property <string> delete-confirm;
    callback ask-shares();
    callback new-group-invite(string);
    callback stop-recovery();
    callback backup-route(bool);
    callback set-bridges(string);
    callback meet-scan(string);
    callback search(string);
    callback add-members(string);
    callback unlock(string);
    callback lock-now();
    callback set-app-lock(string);
    callback set-lock-timeout(int);
    callback set-emergency-pin(string);
    // The window is locked by the app PIN (not the passphrase).
    in property <bool> pin-lock;
    // An app PIN is set.
    in property <bool> app-lock;
    // Seconds without use before Enclave locks (0: never).
    in property <int> lock-timeout: 300;
    in-out property <string> app-pin-input;
    in-out property <string> emergency-pin-input;
    callback set-passphrase(string);
    callback new-invite();
    callback cancel-invites();
    in property <int> invites;
    in property <string> unlock-error;
    in property <bool> can-lock;
    in-out property <string> passphrase-input;
    in-out property <string> new-passphrase;
    callback remove-member(string, string);
    callback set-group-admin(string, string, bool);
    callback leave-group(string);
    in property <[ContactRow]> members;
    in property <[PickRow]> addable;
    in property <bool> group-admin;
    in-out property <string> confirm-leave;
    in property <[ContactRow]> search-results;
    in-out property <string> search-query;
    callback react(string, string, string);
    callback pin(string, string, bool);
    // The open conversation's pinned messages, most recently pinned first.
    in property <[string]> pins;
    callback edit-message(string, string, string);
    callback delete-message(string, string);
    callback set-timer(string, int);
    callback send-file(string, string, string);
    callback save-file(string, string);
    in property <int> timer;
    in-out property <string> selected-seq;
    in-out property <string> editing-seq;
    in-out property <string> attach-path;
    in-out property <string> poll-question;
    in-out property <string> poll-a;
    in-out property <string> poll-b;
    in-out property <string> poll-c;
    in-out property <string> poll-d;
    callback create-poll(string, string, string, string, string, string);
    callback vote(string, string, int);
    callback close-poll(string, string);
    in-out property <string> attach-caption;
    in-out property <string> attach-error;
    in-out property <string> file-note;
    callback meet-confirm();
    in property <string> meet-code;
    in property <image> meet-qr;
    in property <string> meet-words;
    in property <string> meet-name;
    in property <string> meet-error;
    in property <string> meet-done;
    in-out property <string> meet-input;
    callback approve-recovery();
    in-out property <string> confirm-remove;
    callback mark-checked(string);
    callback copy-text(string);
    callback set-privacy(int);
    callback open-sheet(Sheet);
    callback words-saved();
    callback toggle-pick(string);
    callback create-group(string);
    callback link-scan(string);
    callback link-pick(int);

    property <bool> wide: root.width >= 760px;
    property <bool> has-current: root.current-id != "";

    // ---------------------------------------------------------------- welcome
    if root.screen == Screen.welcome: VerticalLayout {
        alignment: center;
        padding: Tokens.space-l;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(440px, root.width - 2 * Tokens.space-l);
                spacing: Tokens.space-l;
                HorizontalLayout { alignment: start; Seal { state: SealState.checked; size: 64px; } }
                VerticalLayout {
                    spacing: Tokens.space-s;
                    Text {
                        text: "Talk privately.";
                        font-size: Tokens.type-onboarding;
                        font-weight: 600;
                        color: Tokens.text;
                        wrap: word-wrap;
                    }
                    Body { text: "No phone number. No email. Only the people you choose can reach you."; color: Tokens.text-muted; }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-s;
                    PrimaryButton { text: "Get started"; clicked => { root.get-started(); } }
                    if root.can-join: QuietButton { text: "I already have Enclave"; clicked => { root.start-join(); } }
                }
                if root.can-join: HorizontalLayout {
                    alignment: start;
                    QuietButton { text: "Restore from a backup"; clicked => { root.screen = Screen.restore; } }
                }
            }
        }
    }

    // ---------------------------------------------------------------- restore
    if root.screen == Screen.restore: Flickable {
        VerticalLayout {
            alignment: start;
            padding: Tokens.space-l;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    width: min(480px, root.width - 2 * Tokens.space-l);
                    spacing: Tokens.space-m;
                    ScreenTitle { text: "Bring your account back"; }
                    Secondary { text: "You need your backup file, and either your 24 recovery words or enough shares from the friends who hold them."; }
                    Field { placeholder: "Your 24 recovery words"; mono: true; text <=> root.restore-words; }
                    Caption { text: "Or get your friends' shares: meet each of them, let them scan the code below, and scan the code they show you back, one in each box."; wrap: word-wrap; }
                    if root.share-request == "": HorizontalLayout {
                        alignment: start;
                        QuietButton { text: "Ask a friend in person"; outlined: true; clicked => { root.ask-shares(); } }
                    }
                    if root.share-request != "": HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 296px;
                            height: 296px;
                            background: #ffffff;
                            border-radius: Tokens.radius-control;
                            Image {
                                width: 280px;
                                height: 280px;
                                source: root.share-request-qr;
                                image-rendering: pixelated;
                                accessible-role: image;
                                accessible-label: "Code for a friend who holds part of your recovery";
                            }
                        }
                    }
                    if root.share-request != "": Secondary {
                        text: "Their screen should show: " + root.share-request-words + ". Each friend scans this same code.";
                    }
                    Field { placeholder: "Share 1 (the code a friend shows you)"; mono: true; text <=> root.restore-s1; }
                    Field { placeholder: "Share 2"; mono: true; text <=> root.restore-s2; }
                    Field { placeholder: "Share 3 (if needed)"; mono: true; text <=> root.restore-s3; }
                    Field { placeholder: "Share 4 (if needed)"; mono: true; text <=> root.restore-s4; }
                    Field { placeholder: "Share 5 (if needed)"; mono: true; text <=> root.restore-s5; }
                    Field { placeholder: "Path to your backup file (or leave empty for the one on your server)"; mono: true; text <=> root.restore-file; }
                    if root.restore-file == "" && root.home-label != "": HorizontalLayout {
                        spacing: Tokens.space-s;
                        Secondary { text: "Your server: " + root.home-label; horizontal-stretch: 1; }
                        if root.servers.length > 1: QuietButton {
                            text: "Change";
                            accessible-label: "Choose the server your backup is on";
                            clicked => { root.server-pick-for = 0; root.chosen-server = root.home-id; root.sheet = Sheet.servers; }
                        }
                    }
                    if root.restore-error != "": Text {
                        text: root.restore-error;
                        color: Tokens.danger;
                        font-size: Tokens.type-secondary;
                        wrap: word-wrap;
                    }
                    Secondary { text: "Your contacts accept this device after 72 hours, unless one of your other devices stops it. That wait protects you if someone else has your words."; }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-s;
                        PrimaryButton {
                            text: root.busy ? "Restoring…" : (root.restore-file == "" ? "Restore from my server" : "Restore");
                            enabled: (root.restore-words != "" || (root.restore-s1 != "" && root.restore-s2 != "")) && !root.busy;
                            clicked => { root.restore(root.restore-words, root.restore-s1, root.restore-s2, root.restore-s3, root.restore-s4, root.restore-s5, root.restore-file); }
                        }
                        QuietButton { text: "Back"; clicked => { root.screen = Screen.welcome; } }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------------- name
    if root.screen == Screen.name: VerticalLayout {
        alignment: center;
        padding: Tokens.space-l;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(440px, root.width - 2 * Tokens.space-l);
                spacing: Tokens.space-m;
                ScreenTitle { text: "What should people call you?"; }
                name-field := Field {
                    placeholder: "Your name";
                    text <=> root.name-input;
                    accepted => { if root.name-input != "" { root.create-account(root.name-input); } }
                    init => { self.focus(); }
                }
                Secondary { text: "Only people you talk to can see this."; }
                if root.home-label != "": HorizontalLayout {
                    spacing: Tokens.space-s;
                    Secondary { text: "Your server: " + root.home-label; horizontal-stretch: 1; }
                    if root.servers.length > 1: QuietButton {
                        text: "Change";
                        accessible-label: "Choose another server";
                        clicked => { root.server-pick-for = 0; root.chosen-server = root.home-id; root.sheet = Sheet.servers; }
                    }
                }
                if root.can-join: Field {
                    placeholder: "Passphrase for this computer (optional)";
                    secret: true;
                    text <=> root.new-passphrase;
                }
                if root.can-join && root.new-passphrase != "": Secondary {
                    text: "You'll type it each time Enclave starts. Nobody can reset it; if you forget it, your recovery words bring your account back.";
                }
                HorizontalLayout {
                    alignment: start;
                    PrimaryButton {
                        text: "Continue";
                        enabled: root.name-input != "";
                        clicked => { root.create-account(root.name-input); }
                    }
                }
            }
        }
    }

    // ----------------------------------------------------------------- locked
    if root.screen == Screen.locked: VerticalLayout {
        alignment: center;
        padding: Tokens.space-l;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(440px, root.width - 2 * Tokens.space-l);
                spacing: Tokens.space-m;
                HorizontalLayout { alignment: start; Seal { state: SealState.checked; size: 48px; } }
                ScreenTitle { text: "Enclave is locked"; }
                Secondary { text: root.pin-lock ? "Type your PIN to open Enclave." : "Type your passphrase to open your messages on this computer."; }
                unlock-field := Field {
                    placeholder: root.pin-lock ? "PIN" : "Passphrase";
                    secret: true;
                    text <=> root.passphrase-input;
                    accepted => { if root.passphrase-input != "" { root.unlock(root.passphrase-input); root.passphrase-input = ""; } }
                    init => { self.focus(); }
                }
                if root.unlock-error != "": Text {
                    text: root.unlock-error;
                    color: Tokens.danger;
                    font-size: Tokens.type-secondary;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    PrimaryButton {
                        text: root.busy ? "Opening…" : "Unlock";
                        enabled: root.passphrase-input != "" && !root.busy;
                        clicked => { root.unlock(root.passphrase-input); root.passphrase-input = ""; }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------- setting up
    if root.screen == Screen.setting-up: VerticalLayout {
        alignment: center;
        padding: Tokens.space-l;
        spacing: Tokens.space-m;
        HorizontalLayout { alignment: center; Seal { size: 48px; } }
        Body { text: "Setting up your private address…"; horizontal-alignment: center; }
        Secondary { text: root.status-line; horizontal-alignment: center; }
    }

    // ------------------------------------------------------ link this device
    if root.screen == Screen.join: VerticalLayout {
        alignment: center;
        padding: Tokens.space-l;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(440px, root.width - 2 * Tokens.space-l);
                spacing: Tokens.space-m;
                ScreenTitle { text: root.join-words == "" ? "Link this device" : "Pick these words"; }
                Secondary {
                    text: root.join-words == ""
                        ? "On the device you already use, open Settings → Your devices and paste this code. Only use it with your own account."
                        : "Your other device now shows four sets of words. Pick the set that matches these.";
                }
                if root.join-words == "" && root.join-code != "": HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 216px;
                        height: 216px;
                        background: #ffffff;
                        border-radius: Tokens.radius-control;
                        Image {
                            width: 200px;
                            height: 200px;
                            source: root.join-qr;
                            image-rendering: pixelated;
                            accessible-role: image;
                            accessible-label: "QR code of this device's link code";
                        }
                    }
                }
                if root.join-words == "" && root.join-code != "": Text {
                    text: root.join-code;
                    font-family: "Atkinson Hyperlegible Mono";
                    font-size: Tokens.type-caption;
                    color: Tokens.text-muted;
                    overflow: elide;
                }
                if root.join-words != "": Code {
                    text: root.join-words;
                    wrap: word-wrap;
                    accessible-label: "Words: " + root.join-words;
                }
                if root.status-line != "": Secondary { text: root.status-line; }
                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-s;
                    if root.join-words == "" && root.join-code != "": PrimaryButton { text: "Copy code"; clicked => { root.copy-text(root.join-code); } }
                    QuietButton { text: "Cancel"; clicked => { root.cancel-join(); } }
                }
            }
        }
    }

    // ------------------------------------------------------------------- main
    if root.screen == Screen.main: HorizontalLayout {
        // Conversation list.
        if root.wide || !root.has-current: Rectangle {
            width: root.wide ? 320px : root.width;
            background: Tokens.background;
            VerticalLayout {
                padding: Tokens.space-m;
                spacing: Tokens.space-m;
                HorizontalLayout {
                    spacing: Tokens.space-sm;
                    Avatar { initials: root.my-initials; tint: root.my-tint; size: 36px; }
                    Title { text: root.my-name; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    IconButton {
                        icon: Icons.settings;
                        label: "Settings";
                        clicked => { root.open-sheet(Sheet.settings); }
                    }
                }
                HorizontalLayout {
                    spacing: Tokens.space-s;
                    vertical-stretch: 0;
                    ActionTile { text: "My code"; icon: Icons.qr; horizontal-stretch: 1; clicked => { root.open-sheet(Sheet.my-code); } }
                    ActionTile { text: "Add"; icon: Icons.link; horizontal-stretch: 1; clicked => { root.open-sheet(Sheet.add); } }
                    ActionTile { text: "Group"; icon: Icons.group; horizontal-stretch: 1; clicked => { root.open-sheet(Sheet.new-group); } }
                }
                if root.recovery-alert != "": Notice {
                    title: "Someone is setting up your account on another device";
                    text: "They used your recovery words. If this isn't you, stop it now. Otherwise your contacts will accept that device on " + root.recovery-alert + ".";
                    kind: 2;
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-s;
                        PrimaryButton {
                            text: "Stop it";
                            danger: true;
                            enabled: !root.busy;
                            clicked => { root.stop-recovery(); }
                        }
                        QuietButton { text: "It's me"; clicked => { root.approve-recovery(); } }
                    }
                }
                if root.recovery-stopped: Notice {
                    title: "One of your other devices stopped this change";
                    text: "Your contacts won't accept this device, so it can't send. If this was you, link this device from your other one instead.";
                    kind: 2;
                }
                if root.recovery-hold != "" && !root.recovery-stopped: Notice {
                    title: "Your contacts are checking this device";
                    text: "You restored your account without one of your other devices, so contacts wait until " + root.recovery-hold + " before accepting it. Approve it from another device to skip the wait. You can read, but not send, until then.";
                    kind: 1;
                }
                if root.removed: Notice {
                    title: "This device was removed from your account";
                    text: "It can't get new messages any more. Erase it to remove your conversations from it.";
                    kind: 2;
                    HorizontalLayout {
                        alignment: start;
                        PrimaryButton { text: "Erase this device"; danger: true; clicked => { root.erase-device(); } }
                    }
                }
                if root.joining != "": Notice {
                    title: "Waiting to join " + root.joining;
                    text: "An admin needs to let you in. You'll see the group here when they do.";
                    kind: 0;
                }
                if root.tor-blocked && !root.bridges-restart: Notice {
                    title: "This network seems to block Tor";
                    text: "Enclave reaches the private network through Tor, and Tor couldn't connect from here. A bridge can get around the block.";
                    kind: 2;
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-s;
                        PrimaryButton { text: "Use a bridge"; clicked => { root.set-bridges("builtin"); } }
                        QuietButton { text: "Enter my own"; clicked => { root.open-sheet(Sheet.settings); } }
                    }
                }
                if root.bridges-restart: Notice {
                    title: "Restart Enclave to use the new bridge settings";
                    text: "Tor picks up bridges when it starts.";
                    kind: 1;
                }
                if root.route == 1: Notice {
                    title: "Backup route: slower to hide who you talk to";
                    text: "Enclave can't reach the private network. It can use a backup route through Tor until the network is back: your server still can't read your messages, and nobody learns where you are, but someone watching the internet closely could more easily tell when you and your contacts talk.";
                    kind: 1;
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-s;
                        PrimaryButton { text: "Use it"; clicked => { root.backup-route(true); } }
                        QuietButton { text: "Keep waiting"; clicked => { root.backup-route(false); } }
                    }
                }
                if root.route == 2: Notice {
                    title: "On the backup route";
                    text: "Messages go to your server through Tor instead of the private network. Switch back when the private network works again.";
                    kind: 1;
                    HorizontalLayout {
                        alignment: start;
                        QuietButton { text: "Back to the private route"; clicked => { root.backup-route(false); } }
                    }
                }
                if root.kt-split != "": Notice {
                    title: "A username server showed people different lists";
                    text: root.kt-split + " gave you and one of your contacts two different signed versions of its public list of usernames. Someone may be trying to send you, or them, to the wrong person. Check security codes, ideally in person, before sharing anything private.";
                    kind: 2;
                }
                if root.new-device != "": Notice {
                    title: "New device linked";
                    text: "Your account was linked to " + root.new-device + ". If that wasn't you, remove it now: it can read your new messages.";
                    kind: 1;
                    HorizontalLayout {
                        alignment: start;
                        QuietButton { text: "Your devices"; clicked => { root.open-sheet(Sheet.devices); } }
                    }
                }
                if root.clock-skew != "": Notice {
                    title: "This device's clock is wrong";
                    text: "It is " + root.clock-skew + " compared with the time Enclave's independent witnesses sign. Set the date and time to automatic in your device's settings. Until then, message times may look wrong and some checks may fail.";
                    kind: 1;
                }
                if root.username-problem != "": Notice {
                    title: "Your username no longer leads to you";
                    text: "The server's public log now shows " + root.username-problem + " pointing to someone else, or to no one. Your server may have changed it. Tell your contacts to use your code or invite link, and check security codes before sharing anything private.";
                    kind: 2;
                    HorizontalLayout {
                        alignment: start;
                        QuietButton { text: "Choose a new username"; clicked => { root.open-sheet(Sheet.settings); } }
                    }
                }
                if !root.recovery-saved: Notice {
                    title: "Save your recovery words";
                    text: "They bring your account back if you lose this device.";
                    kind: 0;
                    HorizontalLayout {
                        alignment: start;
                        QuietButton { text: "Show words"; clicked => { root.open-sheet(Sheet.recovery); } }
                    }
                }
                Field {
                    placeholder: "Search messages";
                    text <=> root.search-query;
                    edited => { root.search(root.search-query); }
                }
                Flickable {
                    vertical-stretch: 1;
                    content-height: list.preferred-height;
                    list := VerticalLayout {
                        alignment: start;
                        spacing: 2px;
                        if root.search-query != "": Caption {
                            text: root.search-results.length == 0
                                ? (root.search-query.character-count < 2 ? "Keep typing…" : "No messages found. Search only looks on this device.")
                                : "Messages";
                            font-weight: 600;
                            height: 28px;
                            vertical-alignment: center;
                        }
                        if root.search-query != "": VerticalLayout {
                            spacing: 2px;
                            for h in root.search-results: ContactItem {
                                item: h;
                                selected: false;
                                clicked => { root.select(h.id); }
                            }
                        }
                        if root.search-query == "" && root.requests.length > 0: Caption {
                            text: "Message requests";
                            font-weight: 600;
                            height: 28px;
                            vertical-alignment: center;
                        }
                        if root.search-query == "": VerticalLayout {
                            spacing: 2px;
                            for r in root.requests: ContactItem {
                                item: r;
                                selected: r.id == root.current-id;
                                clicked => { root.select(r.id); }
                            }
                            if root.requests.length > 0 && root.contacts.length > 0: Caption {
                                text: "Conversations";
                                font-weight: 600;
                                height: 28px;
                                vertical-alignment: center;
                            }
                            for c in root.contacts: ContactItem {
                                item: c;
                                selected: c.id == root.current-id;
                                clicked => { root.select(c.id); }
                            }
                            if root.archived.length > 0: Rectangle {
                                height: Tokens.space-touch-target-min;
                                border-radius: Tokens.radius-control;
                                background: archived-touch.has-hover ? Tokens.surface : transparent;
                                accessible-role: button;
                                accessible-label: (root.show-archived ? "Hide archived, " : "Show archived, ") + root.archived.length;
                                accessible-action-default => { root.show-archived = !root.show-archived; }
                                archived-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.show-archived = !root.show-archived; }
                                }
                                HorizontalLayout {
                                    padding-left: Tokens.space-sm;
                                    padding-right: Tokens.space-sm;
                                    Text {
                                        text: "Archived (" + root.archived.length + ")";
                                        font-size: Tokens.type-secondary;
                                        font-weight: 600;
                                        color: Tokens.pine;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Caption { text: root.show-archived ? "Hide" : "Show"; vertical-alignment: center; }
                                }
                            }
                            if root.show-archived: VerticalLayout {
                                spacing: 2px;
                                for c in root.archived: ContactItem {
                                    item: c;
                                    selected: c.id == root.current-id;
                                    clicked => { root.select(c.id); }
                                }
                            }
                        }
                    }
                }
                Caption { text: root.status-line; wrap: word-wrap; }
            }
        }
        if root.wide: Rectangle { width: 1px; background: Tokens.hairline; }

        // Conversation.
        if root.wide || root.has-current: Rectangle {
            horizontal-stretch: 1;
            background: Tokens.background;

            if !root.has-current: VerticalLayout {
                alignment: center;
                padding: Tokens.space-xl;
                spacing: Tokens.space-m;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: min(420px, parent.width - 2 * Tokens.space-xl);
                        spacing: Tokens.space-m;
                        Title { text: root.contacts.length + root.requests.length == 0 ? "Start your first conversation" : "Choose a conversation"; }
                        Secondary {
                            text: "Show your code to someone next to you, or send them your invite link. Meeting in person is the strongest way to check it's really them.";
                        }
                    }
                }
            }

            if root.has-current: VerticalLayout {
                // Header.
                Rectangle {
                    height: 72px;
                    HorizontalLayout {
                        padding-left: Tokens.space-m;
                        padding-right: Tokens.space-m;
                        spacing: Tokens.space-sm;
                        if !root.wide: VerticalLayout {
                            alignment: center;
                            IconButton { icon: Icons.back; label: "Back"; clicked => { root.current-id = ""; } }
                        }
                        VerticalLayout {
                            alignment: center;
                            Avatar { initials: root.current.initials; tint: root.current.tint; art: root.current.art; art-tint: root.current.art-tint; size: 40px; }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Title { text: root.current.name; overflow: elide; wrap: no-wrap; }
                            HorizontalLayout {
                                spacing: Tokens.space-xs;
                                if root.current.kind == 0: Seal { state: root.current.verified ? SealState.checked : SealState.unchecked; size: 16px; }
                                if root.typing && root.current.kind == 0: Caption {
                                    text: "typing…";
                                    color: Tokens.pine;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    accessible-label: root.current.name + " is typing";
                                }
                                if !(root.typing && root.current.kind == 0): Caption {
                                    text: root.current.kind == 2
                                        ? "Only you, on your devices"
                                        : root.current.kind == 1
                                        ? root.current.members + (root.on-record ? " people · On the record" : " people · Off the record")
                                        : (root.current.met ? "Met in person" : root.current.verified ? "Checked" : "Not checked yet") + (root.on-record ? " · On the record" : " · Off the record");
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                        if root.current.state == 2: VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: Icons.more;
                                label: "Conversation settings";
                                clicked => { root.open-sheet(Sheet.conversation); }
                            }
                        }
                        if root.current.kind == 1: VerticalLayout {
                            alignment: center;
                            QuietButton {
                                text: "Members";
                                clicked => { root.open-sheet(Sheet.members); }
                            }
                        }
                        // On a phone the timer lives in the conversation sheet.
                        if root.wide && root.current.state == 2 && root.current.kind == 0: VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: Icons.timer;
                                label: root.timer > 0 ? "Disappearing messages: on" : "Disappearing messages: off";
                                clicked => { root.open-sheet(Sheet.timer); }
                            }
                        }
                        if root.current.state == 2 && root.current.kind == 0: VerticalLayout {
                            alignment: center;
                            QuietButton {
                                text: !root.wide ? "Code" : root.current.verified ? "Security code" : "Check code";
                                clicked => { root.open-sheet(Sheet.check-code); }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.hairline; }
                }

                // Pinned messages: the most recent one, and how many.
                if root.pins.length > 0: Rectangle {
                    background: Tokens.surface;
                    accessible-role: text;
                    accessible-label: (root.pins.length == 1 ? "Pinned message: " : root.pins.length + " pinned messages. Latest: ") + root.pins[0];
                    HorizontalLayout {
                        padding-left: Tokens.space-m;
                        padding-right: Tokens.space-m;
                        padding-top: Tokens.space-s;
                        padding-bottom: Tokens.space-s;
                        spacing: Tokens.space-sm;
                        Rectangle { width: 3px; border-radius: 1.5px; background: Tokens.pine; }
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Caption { text: root.pins.length == 1 ? "Pinned" : "Pinned · " + root.pins.length; }
                            Text {
                                text: root.pins[0];
                                font-size: Tokens.type-secondary;
                                color: Tokens.text;
                                overflow: elide;
                                wrap: no-wrap;
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.hairline; }
                }

                // Messages.
                Flickable {
                    vertical-stretch: 1;
                    content-height: max(self.height, thread.preferred-height);
                    content-y: min(0px, self.height - self.content-height);
                    thread := VerticalLayout {
                        alignment: end;
                        padding: Tokens.space-m;
                        spacing: Tokens.space-s;
                        if root.show-delivery-hint && root.current.state == 2 && root.current.kind != 2: Caption {
                            text: "Private delivery takes a few seconds. That pause is part of what hides who you talk to.";
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        for m in root.messages: Bubble {
                            msg: m;
                            bubble-max: min(480px, root.width * 0.7);
                            selected: root.selected-seq == m.seq;
                            tapped => {
                                if root.current.state == 2 && !m.deleted {
                                    root.selected-seq = root.selected-seq == m.seq ? "" : m.seq;
                                }
                            }
                            vote(i) => { root.vote(root.current-id, m.seq, i); }
                            close-poll => { root.close-poll(root.current-id, m.seq); }
                            add-contact => { root.add-shared(root.current-id, m.seq); }
                            copy(t) => { root.copy-text(t); }
                            add-pack => { root.add-pack(root.current-id, m.seq); }
                            play-clip => { root.play-clip(root.current-id, m.seq); }
                        }
                    }
                }

                // A message held back somewhere (RT-24).
                if root.gap && root.current.state == 2: Rectangle {
                    VerticalLayout {
                        padding-left: Tokens.space-m;
                        padding-right: Tokens.space-m;
                        padding-top: Tokens.space-s;
                        Notice {
                            title: "A message may not have arrived";
                            text: "Later messages from " + root.current.name + " came over a minute ago, but an earlier one hasn't. If it comes, it's marked “delivered late”. Their app sends it again if it was lost.";
                            kind: 1;
                        }
                    }
                }
                // Request, pending or composer.
                if root.current.state == 1: Rectangle {
                    VerticalLayout {
                        padding: Tokens.space-m;
                        Notice {
                            title: root.current.name + " wants to talk";
                            text: "You haven't talked before. They can't see whether you've read this until you accept. The name is what they typed; check their security code before sharing anything private.";
                            HorizontalLayout {
                                spacing: Tokens.space-s;
                                alignment: start;
                                PrimaryButton { text: "Accept"; clicked => { root.accept(root.current-id); } }
                                QuietButton { text: "Delete"; danger: true; clicked => { root.decline(root.current-id); } }
                                QuietButton {
                                    text: "Block";
                                    danger: true;
                                    accessible-label: "Block " + root.current.name;
                                    clicked => { root.block(root.current-id, true); }
                                }
                                QuietButton {
                                    text: "Report";
                                    danger: true;
                                    accessible-label: "Report " + root.current.name;
                                    clicked => { root.open-sheet(Sheet.report); }
                                }
                            }
                        }
                    }
                }
                if root.current.state == 0: Rectangle {
                    VerticalLayout {
                        padding: Tokens.space-m;
                        Notice {
                            title: "Waiting for " + root.current.name + " to accept";
                            text: "You can write again once they accept your request.";
                        }
                    }
                }
                // Actions on the selected message.
                if root.current.state == 2 && root.selected-seq != "": Rectangle {
                    background: Tokens.surface;
                    Rectangle { y: 0; height: 1px; background: Tokens.hairline; }
                    HorizontalLayout {
                        padding-left: Tokens.space-m;
                        padding-right: Tokens.space-m;
                        padding-top: Tokens.space-s;
                        spacing: Tokens.space-xs;
                        for e in root.current.kind == 2 ? [] : ["👍", "❤", "😂", "😮", "😢", "🙏"]: Rectangle {
                            width: Tokens.space-touch-target-min;
                            height: Tokens.space-touch-target-min;
                            border-radius: Tokens.radius-control;
                            background: react-touch.has-hover ? Tokens.bubble-in : transparent;
                            accessible-role: button;
                            accessible-label: "React " + e;
                            accessible-action-default => {
                                root.react(root.current-id, root.selected-seq, e);
                                root.selected-seq = "";
                            }
                            Text {
                                text: e;
                                font-size: 24px;
                                color: Tokens.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            react-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.react(root.current-id, root.selected-seq, e);
                                    root.selected-seq = "";
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        for m in root.messages: HorizontalLayout {
                            spacing: Tokens.space-xs;
                            if m.seq == root.selected-seq && root.current.kind != 2: QuietButton {
                                text: m.pinned ? "Unpin" : "Pin";
                                accessible-label: m.pinned ? "Unpin for everyone" : "Pin for everyone";
                                clicked => {
                                    root.pin(root.current-id, m.seq, !m.pinned);
                                    root.selected-seq = "";
                                }
                            }
                            if m.seq == root.selected-seq && m.can-edit: QuietButton {
                                text: "Edit";
                                clicked => {
                                    root.editing-seq = m.seq;
                                    root.draft = m.text;
                                    root.selected-seq = "";
                                }
                            }
                            if m.seq == root.selected-seq && m.outgoing && !m.deleted: QuietButton {
                                text: "Delete";
                                danger: true;
                                accessible-label: root.current.kind == 2 ? "Delete note" : "Delete for everyone";
                                clicked => {
                                    root.delete-message(root.current-id, m.seq);
                                    root.selected-seq = "";
                                }
                            }
                            if m.seq == root.selected-seq && m.file != "": QuietButton {
                                text: "Save";
                                accessible-label: "Save " + m.file;
                                clicked => {
                                    root.save-file(root.current-id, m.seq);
                                    root.selected-seq = "";
                                }
                            }
                        }
                    }
                }
                if root.moved != 0 && root.current.kind == 0: HorizontalLayout {
                    padding-left: Tokens.space-m;
                    padding-right: Tokens.space-m;
                    Notice {
                        title: root.moved == 1
                            ? root.current.name + " changed their recovery words"
                            : root.current.name + "'s account moved to a new key";
                        text: root.moved == 1
                            ? "Their security code changed too. Check it again before sharing anything private."
                            : "Enclave can't confirm it was them who did this. Check the security code in person before sharing anything private.";
                        kind: 1;
                        HorizontalLayout {
                            alignment: start;
                            QuietButton { text: "Check now"; clicked => { root.open-sheet(Sheet.check-code); } }
                        }
                    }
                }
                if root.held-moves != "" && root.current.kind == 1: HorizontalLayout {
                    padding-left: Tokens.space-m;
                    padding-right: Tokens.space-m;
                    Notice {
                        title: root.held-moves + " changed their recovery words, but this device didn't hear it from them";
                        text: "Their new key is on hold in this group until it does. Ask them to open Enclave, and check with them another way before sharing anything private.";
                        kind: 1;
                    }
                }
                if root.holds-share && root.current.kind == 0 && root.current.state == 2: HorizontalLayout {
                    padding-left: Tokens.space-m;
                    padding-right: Tokens.space-m;
                    Notice {
                        title: "You hold part of " + root.current.name + "'s recovery";
                        text: "If they lose every device, meet them: their new phone shows a code, and you give them your part by scanning it. Only in person.";
                        kind: 0;
                        HorizontalLayout {
                            alignment: start;
                            QuietButton { text: "Help them get back in"; clicked => { root.share-request-input = ""; root.reveal-share(root.current-id); root.open-sheet(Sheet.share); } }
                        }
                    }
                }
                if root.current.state == 2 && root.file-note != "": Caption {
                    text: root.file-note;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if root.current.blocked: Rectangle {
                    VerticalLayout {
                        padding: Tokens.space-m;
                        Notice {
                            title: "You blocked " + root.current.name;
                            text: "They can't send you messages, and they aren't told. Anything they send is dropped.";
                            HorizontalLayout {
                                alignment: start;
                                QuietButton { text: "Unblock"; outlined: true; clicked => { root.block(root.current-id, false); } }
                            }
                        }
                    }
                }
                if root.closed && root.current.kind == 0: Rectangle {
                    VerticalLayout {
                        padding: Tokens.space-m;
                        Notice {
                            title: root.current.name + " closed their account";
                            text: "You can still read this conversation. Nothing more can be sent to them.";
                        }
                    }
                }
                if root.current.state == 2 && !root.current.blocked && !(root.closed && root.current.kind == 0): Rectangle {
                    HorizontalLayout {
                        padding: Tokens.space-m;
                        spacing: Tokens.space-s;
                        if root.current.kind != 2 && root.editing-seq == "": IconButton {
                            icon: Icons.attach;
                            label: "Send a file";
                            clicked => { root.attach-error = ""; root.open-sheet(Sheet.attach); }
                        }
                        if root.current.kind == 1: IconButton {
                            icon: Icons.poll;
                            label: "Ask a question";
                            clicked => { root.open-sheet(Sheet.poll); }
                        }
                        if root.current.kind != 2 && root.editing-seq == "": IconButton {
                            icon: Icons.sticker;
                            label: "Stickers";
                            clicked => { root.load-stickers(); root.open-sheet(Sheet.stickers); }
                        }
                        composer := Field {
                            placeholder: root.editing-seq != "" ? "Edit your message" : "Message";
                            text <=> root.draft;
                            horizontal-stretch: 1;
                            edited => {
                                if root.current.kind == 0 && root.editing-seq == "" {
                                    root.draft-changed(root.current-id, root.draft != "");
                                }
                            }
                            accepted => {
                                if root.draft != "" {
                                    if root.editing-seq != "" {
                                        root.edit-message(root.current-id, root.editing-seq, root.draft);
                                        root.editing-seq = "";
                                    } else {
                                        root.send(root.current-id, root.draft);
                                    }
                                    root.draft = "";
                                }
                            }
                        }
                        if root.editing-seq != "": QuietButton {
                            text: "Cancel";
                            clicked => { root.editing-seq = ""; root.draft = ""; }
                        }
                        IconButton {
                            icon: Icons.send;
                            label: root.editing-seq != "" ? "Save edit" : "Send";
                            filled: true;
                            clicked => {
                                if root.draft != "" {
                                    if root.editing-seq != "" {
                                        root.edit-message(root.current-id, root.editing-seq, root.draft);
                                        root.editing-seq = "";
                                    } else {
                                        root.send(root.current-id, root.draft);
                                    }
                                    root.draft = "";
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ----------------------------------------------------------------- sheets
    if root.sheet == Sheet.my-code: SheetFrame {
        title: "Your code";
        close => { root.sheet = Sheet.none; }
        Secondary { text: "Let someone next to you scan this. For someone who isn't here, copy an invite link: each one works for one person, for 7 days. Either way, they can then send you a message request."; }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 248px;
                height: 248px;
                background: #ffffff;
                border-radius: Tokens.radius-control;
                Image {
                    width: 232px;
                    height: 232px;
                    source: root.my-qr;
                    image-rendering: pixelated;
                    accessible-role: image;
                    accessible-label: "QR code of your contact code";
                }
            }
        }
        if root.my-username != "": HorizontalLayout {
            spacing: Tokens.space-s;
            Secondary { text: "Or they can look you up as"; vertical-alignment: center; horizontal-stretch: 0; }
            Text {
                text: root.my-username;
                font-family: "Atkinson Hyperlegible Mono";
                font-size: Tokens.type-secondary;
                color: Tokens.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton { text: "Copy invite link"; enabled: !root.busy; clicked => { root.new-invite(); } }
            if root.my-username != "": QuietButton { text: "Copy username"; clicked => { root.copy-text(root.my-username); } }
        }
        if root.invites > 0: HorizontalLayout {
            spacing: Tokens.space-s;
            Caption {
                text: root.invites == 1 ? "1 invite link hasn't been used yet." : root.invites + " invite links haven't been used yet.";
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            QuietButton { text: "Cancel them"; horizontal-stretch: 0; clicked => { root.cancel-invites(); } }
        }
    }

    if root.sheet == Sheet.add: SheetFrame {
        title: "Add someone";
        close => { root.sheet = Sheet.none; }
        Secondary { text: root.usernames ? "Paste the invite link they sent you, or type their username." : "Paste the invite link they sent you."; }
        Field { placeholder: root.usernames ? "enclave:add#…  or  @name@server" : "enclave:add#…"; mono: true; text <=> root.add-link; }
        Field { placeholder: "Say hello (optional)"; text <=> root.add-text; }
        if root.add-error != "": HorizontalLayout {
            spacing: Tokens.space-s;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: Tokens.danger;
                Text { text: "!"; color: Tokens.surface; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            }
            Text { text: "Couldn't add them"; color: Tokens.danger; font-size: Tokens.type-body; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
        }
        if root.add-error != "": Text {
            text: root.add-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton {
                text: root.busy ? "Sending request…" : "Send request";
                enabled: root.add-link != "" && !root.busy;
                clicked => { root.add-contact(root.add-link, root.add-text); }
            }
        }
        HorizontalLayout {
            alignment: start;
            QuietButton { text: "Together right now? Meet in person"; outlined: true; clicked => { root.open-sheet(Sheet.meet); } }
        }
    }

    if root.sheet == Sheet.conversation: SheetFrame {
        title: root.current.name;
        close => { root.sheet = Sheet.none; }
        // Contact info: the McEliece braid isn't done (`docs/17-design.md`
        // keeps this off the conversation itself).
        if root.finishing: Notice {
            title: "Extra protection: finishing…";
            text: "Maximum privacy holds what you write until all three kinds of encryption protect this conversation. It goes out on its own once " + root.current.name + "'s app has finished setting it up.";
        }
        if root.current.kind == 0: SwitchRow {
            label: "On the record";
            detail: root.on-record
                ? "Your messages carry your signature. Anyone who gets a copy can prove you wrote them."
                : "Nobody can prove to others who wrote these messages.";
            on: root.on-record;
            toggled => { root.set-on-record(!root.on-record); }
        }
        if root.current.kind == 0: Caption {
            text: "Both of you see when this changes, and who changed it.";
            wrap: word-wrap;
        }
        SwitchRow {
            label: "Pin to top";
            detail: "Keep it above your other conversations. Up to 4.";
            on: root.current.pinned;
            toggled => { root.conv-prefs(root.current-id, false, !root.current.pinned, root.current.muted); }
        }
        SwitchRow {
            label: "Mute";
            detail: "New messages are counted quietly and don't bring it back from the archive.";
            on: root.current.muted;
            toggled => { root.conv-prefs(root.current-id, root.current.archived, root.current.pinned, !root.current.muted); }
        }
        SwitchRow {
            label: "Archive";
            detail: "Move it out of your list until someone writes.";
            on: root.current.archived;
            toggled => {
                root.conv-prefs(root.current-id, !root.current.archived, root.current.pinned, root.current.muted);
                if !root.current.archived { root.sheet = Sheet.none; }
            }
        }
        Caption {
            text: "These choices stay on this device. Nobody in the conversation sees them.";
            wrap: word-wrap;
        }
        if root.gallery-count > 0: HorizontalLayout {
            alignment: start;
            QuietButton {
                text: "Photos and files (" + root.gallery-count + ")";
                outlined: true;
                clicked => { root.sheet = Sheet.gallery; }
            }
        }
        if root.current.kind == 0: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            QuietButton {
                text: root.timer > 0 ? "Disappearing messages: on" : "Disappearing messages: off";
                outlined: true;
                clicked => { root.open-sheet(Sheet.timer); }
            }
            QuietButton {
                text: "Report";
                danger: true;
                accessible-label: "Report " + root.current.name;
                clicked => { root.sheet = Sheet.report; }
            }
            QuietButton {
                text: root.current.blocked ? "Unblock" : "Block";
                danger: !root.current.blocked;
                accessible-label: (root.current.blocked ? "Unblock " : "Block ") + root.current.name;
                clicked => {
                    root.block(root.current-id, !root.current.blocked);
                    root.sheet = Sheet.none;
                }
            }
        }
    }

    if root.sheet == Sheet.timer: SheetFrame {
        title: "Disappearing messages";
        close => { root.sheet = Sheet.none; }
        Secondary { text: "New messages in this conversation disappear from both phones this long after they're read. Anyone can still take a screenshot."; }
        for option in [
            { label: "Off", secs: 0 },
            { label: "5 minutes", secs: 300 },
            { label: "1 hour", secs: 3600 },
            { label: "1 day", secs: 86400 },
            { label: "1 week", secs: 604800 },
        ]: Rectangle {
            height: Tokens.space-touch-target-min;
            border-radius: Tokens.radius-control;
            border-width: root.timer == option.secs ? 2px : 1px;
            border-color: root.timer == option.secs ? Tokens.pine : Tokens.hairline;
            accessible-role: radio-button;
            accessible-checked: root.timer == option.secs;
            accessible-label: option.label;
            accessible-action-default => { root.set-timer(root.current-id, option.secs); }
            TouchArea { clicked => { root.set-timer(root.current-id, option.secs); } }
            HorizontalLayout {
                padding-left: Tokens.space-m;
                spacing: Tokens.space-sm;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        border-width: 2px;
                        border-color: root.timer == option.secs ? Tokens.pine : Tokens.text-muted;
                        if root.timer == option.secs: Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Tokens.pine; }
                    }
                }
                Body { text: option.label; vertical-alignment: center; }
            }
        }
    }

    if root.sheet == Sheet.attach: SheetFrame {
        title: "Send a file";
        close => { root.sheet = Sheet.none; }
        Secondary { text: "Files are sealed before they leave this device and padded so their size doesn't give them away. " + (root.current.kind == 1 ? "Each member downloads them" : root.current.name + " downloads them") + " only when they choose to. A WAV recording is sent as a voice note."; }
        Field { placeholder: "Path to the file"; mono: true; text <=> root.attach-path; }
        Field { placeholder: "Add a caption (optional)"; text <=> root.attach-caption; }
        if root.attach-error != "": Text {
            text: root.attach-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? "Sending…" : "Send";
                enabled: root.attach-path != "" && !root.busy;
                clicked => { root.send-file(root.current-id, root.attach-path, root.attach-caption); }
            }
            if root.current.kind == 0: QuietButton {
                text: "Share a contact instead";
                clicked => { root.sheet = Sheet.share-contact; }
            }
            if root.current.kind == 0: QuietButton {
                text: "Share a location";
                clicked => { root.sheet = Sheet.location; }
            }
        }
    }

    if root.sheet == Sheet.stickers: SheetFrame {
        title: "Stickers";
        close => { root.sheet = Sheet.none; }
        if root.sticker-packs.length == 0: Secondary { text: "No sticker packs yet. Make one from your own pictures, or add one from a sticker someone sends you."; }
        for p in root.sticker-packs: VerticalLayout {
            spacing: Tokens.space-xs;
            Caption { text: p.title; font-weight: 600; }
            Flickable {
                height: 72px;
                content-width: p.count * 76px;
                HorizontalLayout {
                    spacing: 4px;
                    for c in root.sticker-cells: Rectangle {
                        visible: c.pack == p.id;
                        width: self.visible ? 72px : 0px;
                        height: 72px;
                        border-radius: Tokens.radius-control;
                        background: cell-touch.has-hover ? Tokens.bubble-in : transparent;
                        accessible-role: button;
                        accessible-label: "Send sticker " + (c.index + 1) + " from " + p.title;
                        accessible-action-default => { root.send-sticker(root.current-id, c.pack, c.index); root.sheet = Sheet.none; }
                        cell-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.send-sticker(root.current-id, c.pack, c.index); root.sheet = Sheet.none; }
                        }
                        if c.has-image: Image {
                            source: c.image;
                            width: 64px;
                            height: 64px;
                            image-fit: contain;
                        }
                        if !c.has-image: Caption { text: c.index + 1; }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            QuietButton { text: "Make a pack"; outlined: true; clicked => { root.pack-error = ""; root.sheet = Sheet.new-pack; } }
        }
    }

    if root.sheet == Sheet.new-pack: SheetFrame {
        title: "Make a sticker pack";
        close => { root.sheet = Sheet.stickers; }
        Secondary { text: "Pictures are redrawn small, without their metadata, and sealed into one pack. People you send a sticker to can add the whole pack."; }
        Field { placeholder: "Pack name"; text <=> root.pack-title; }
        Field { placeholder: "Paths to pictures, separated by ;"; mono: true; text <=> root.pack-paths; }
        if root.pack-error != "": Text {
            text: root.pack-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? "Making…" : "Make pack";
                enabled: root.pack-title != "" && root.pack-paths != "" && !root.busy;
                clicked => { root.create-pack(root.pack-title, root.pack-paths); }
            }
        }
    }

    if root.sheet == Sheet.report: SheetFrame {
        title: "Report " + root.current.name;
        close => { root.sheet = Sheet.none; }
        Secondary { text: "The report goes to the people who run " + root.current.name + "'s server. It doesn't say who you are. They can close the account's message requests; they can't read your conversations."; }
        for option in [
            { label: "Spam", value: 1 },
            { label: "Harassment or threats", value: 2 },
            { label: "Something else", value: 3 },
        ]: Rectangle {
            height: Tokens.space-touch-target-min;
            border-radius: Tokens.radius-control;
            border-width: root.report-reason == option.value ? 2px : 1px;
            border-color: root.report-reason == option.value ? Tokens.pine : Tokens.hairline;
            accessible-role: radio-button;
            accessible-checked: root.report-reason == option.value;
            accessible-label: option.label;
            accessible-action-default => { root.report-reason = option.value; }
            TouchArea { clicked => { root.report-reason = option.value; } }
            HorizontalLayout {
                padding-left: Tokens.space-m;
                Body { text: option.label; vertical-alignment: center; }
            }
        }
        SwitchRow {
            label: "Include their last messages";
            detail: "Up to 10, as you see them. This chat is off the record, so the operator can't confirm who wrote them.";
            on: root.report-quote;
            toggled => { root.report-quote = !root.report-quote; }
        }
        SwitchRow {
            label: "Also block them";
            detail: "They can't send you anything more, and they aren't told.";
            on: root.report-block;
            toggled => { root.report-block = !root.report-block; }
        }
        if root.report-reason == 1: SwitchRow {
            label: "Make message requests cost more";
            detail: "For a month, anyone sending you a message request has their device do more work first. It slows down people who send many; one message from a friend still goes through.";
            on: root.report-costlier;
            toggled => { root.report-costlier = !root.report-costlier; }
        }
        HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? "Sending…" : "Send report";
                enabled: !root.busy;
                clicked => {
                    root.report(root.current-id, root.report-reason, root.report-quote, root.report-block, root.report-costlier);
                    root.sheet = Sheet.none;
                }
            }
        }
    }

    if root.sheet == Sheet.gallery: SheetFrame {
        title: "Photos and files";
        close => { root.sheet = Sheet.conversation; }
        Secondary { text: "Everything sent in this conversation, newest last. Files stay sealed on this device until you save them."; }
        VerticalLayout {
            spacing: Tokens.space-xs;
            for m in root.messages: Rectangle {
                visible: m.file != "" && !m.deleted;
                height: self.visible ? 64px : 0px;
                accessible-role: list-item;
                accessible-label: (m.picture ? "Photo: " : "File: ") + m.file + ", " + m.time;
                HorizontalLayout {
                    spacing: Tokens.space-sm;
                    Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: Tokens.radius-control;
                        background: Tokens.bubble-in;
                        clip: true;
                        if m.has-image: Image {
                            source: m.image;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                        }
                        if !m.has-image: Path {
                            width: 24px;
                            height: 24px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: Icons.attach;
                            stroke: Tokens.text-muted;
                            stroke-width: 1.75px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Body { text: m.file; overflow: elide; }
                        Caption { text: (m.picture ? "Photo" : "File") + " · " + (m.outgoing ? "you sent it" : "received") + " · " + m.time; overflow: elide; }
                    }
                    VerticalLayout {
                        alignment: center;
                        QuietButton {
                            text: "Save";
                            accessible-label: "Save " + m.file;
                            clicked => { root.save-file(root.current-id, m.seq); }
                        }
                    }
                }
            }
        }
    }

    if root.sheet == Sheet.location: SheetFrame {
        title: "Share a location";
        close => { root.sheet = Sheet.none; }
        Secondary { text: "Type or paste the coordinates. Enclave doesn't look anything up and shows no map, so nobody else learns the place."; }
        Field { placeholder: "Latitude, like 52.5200"; mono: true; text <=> root.location-lat; }
        Field { placeholder: "Longitude, like 13.4050"; mono: true; text <=> root.location-lon; }
        Field { placeholder: "Name it (optional)"; text <=> root.location-name; }
        HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: "Send";
                enabled: root.location-lat != "" && root.location-lon != "";
                clicked => {
                    root.share-location(root.current-id, root.location-lat, root.location-lon, root.location-name);
                    root.location-lat = "";
                    root.location-lon = "";
                    root.location-name = "";
                    root.sheet = Sheet.none;
                }
            }
        }
    }

    if root.sheet == Sheet.share-contact: SheetFrame {
        title: "Share a contact";
        close => { root.sheet = Sheet.none; }
        Secondary { text: root.current.name + " gets their code and can send them a request. Nobody is told who shared it."; }
        for p in root.friends: Rectangle {
            visible: p.id != root.current-id;
            height: self.visible ? 56px : 0px;
            border-radius: Tokens.radius-control;
            background: share-touch.has-hover ? Tokens.bubble-in : transparent;
            accessible-role: button;
            accessible-label: "Share " + p.name;
            accessible-action-default => { root.share-contact(root.current-id, p.id); root.sheet = Sheet.none; }
            share-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.share-contact(root.current-id, p.id); root.sheet = Sheet.none; }
            }
            HorizontalLayout {
                padding-left: Tokens.space-s;
                padding-right: Tokens.space-s;
                spacing: Tokens.space-sm;
                VerticalLayout { alignment: center; Avatar { initials: p.initials; tint: p.tint; size: 36px; } }
                Body { text: p.name; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            }
        }
        if root.friends.length < 2: Secondary { text: "You can share people you already talk to."; }
    }

    if root.sheet == Sheet.poll: SheetFrame {
        title: "Ask a question";
        close => { root.sheet = Sheet.none; }
        Secondary { text: "Everyone in " + root.current.name + " can vote and see how everyone else voted. Only you can close it."; }
        Field { placeholder: "Question"; text <=> root.poll-question; }
        Field { placeholder: "Option 1"; text <=> root.poll-a; }
        Field { placeholder: "Option 2"; text <=> root.poll-b; }
        Field { placeholder: "Option 3 (optional)"; text <=> root.poll-c; }
        Field { placeholder: "Option 4 (optional)"; text <=> root.poll-d; }
        HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? "Sending…" : "Ask";
                enabled: root.poll-question != "" && root.poll-a != "" && root.poll-b != "" && !root.busy;
                clicked => { root.create-poll(root.current-id, root.poll-question, root.poll-a, root.poll-b, root.poll-c, root.poll-d); }
            }
        }
    }

    if root.sheet == Sheet.meet: SheetFrame {
        title: root.meet-done != "" ? "You and " + root.meet-done + " are checked in person" : root.meet-words != "" ? "Do you both see these words?" : "Meet in person";
        close => { root.sheet = Sheet.none; }
        if root.meet-done != "": HorizontalLayout {
            alignment: start;
            Seal { state: SealState.checked; size: 48px; }
        }
        if root.meet-done != "": Secondary { text: "If anything changes, we'll tell you before you send anything. Your conversation now also rests on a secret that only crossed the room between your two screens."; }
        if root.meet-done != "": HorizontalLayout {
            alignment: start;
            PrimaryButton { text: "Done"; clicked => { root.sheet = Sheet.none; } }
        }

        if root.meet-done == "" && root.meet-words == "": Secondary {
            text: "Show this code to the other person and scan theirs. It only works face to face: codes sent over a message or a call don't count.";
        }
        if root.meet-done == "" && root.meet-words == "" && root.meet-code != "": HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 216px;
                height: 216px;
                background: #ffffff;
                border-radius: Tokens.radius-control;
                Image {
                    width: 200px;
                    height: 200px;
                    source: root.meet-qr;
                    image-rendering: pixelated;
                    accessible-role: image;
                    accessible-label: "Your in-person code";
                }
            }
        }
        if root.meet-done == "" && root.meet-words == "": Field { placeholder: "Their code: enclave:meet#…"; mono: true; text <=> root.meet-input; }
        if root.meet-done == "" && root.meet-words == "" && root.meet-error != "": Text {
            text: root.meet-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        if root.meet-done == "" && root.meet-words == "": HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: "Continue";
                enabled: root.meet-input != "";
                clicked => { root.meet-scan(root.meet-input); root.meet-input = ""; }
            }
        }

        if root.meet-done == "" && root.meet-words != "": HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-sm;
            Seal { state: SealState.checked; size: 32px; }
            Code {
                text: root.meet-words;
                vertical-alignment: center;
                accessible-label: "Seal words: " + root.meet-words;
            }
        }
        if root.meet-done == "" && root.meet-words != "": Secondary {
            text: root.meet-name + "'s phone should show the same three words. If it does, you scanned each other and nobody else.";
        }
        if root.meet-done == "" && root.meet-words != "" && root.meet-error != "": Text {
            text: root.meet-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        if root.meet-done == "" && root.meet-words != "": HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton {
                text: root.busy ? "Checking…" : "They match";
                enabled: !root.busy;
                clicked => { root.meet-confirm(); }
            }
            QuietButton { text: "They don't"; clicked => { root.sheet = Sheet.none; } }
        }
    }

    if root.sheet == Sheet.check-code: SheetFrame {
        title: root.current.verified ? "You and " + root.current.name + " are checked" : "Check it's really " + root.current.name;
        close => { root.sheet = Sheet.none; }
        Secondary {
            text: root.current.verified
                ? "If anything changes, we'll tell you before you send anything."
                : "Compare these numbers with " + root.current.name + " in person or on a call. If every group matches, tap They match.";
        }
        HorizontalLayout {
            alignment: center;
            Avatar { initials: root.current.initials; tint: root.current.tint; art: root.current.art; art-tint: root.current.art-tint; size: 56px; }
        }
        HorizontalLayout {
            alignment: center;
            GridLayout {
                spacing-horizontal: Tokens.space-l;
                spacing-vertical: Tokens.space-s;
                for g[i] in root.code-groups: Code {
                    text: g;
                    row: i / 3;
                    col: mod(i, 3);
                    accessible-label: "Group " + (i + 1) + ": " + g;
                }
            }
        }
        // The same code to read aloud on a call.
        if root.code-words.length > 0: VerticalLayout {
            spacing: Tokens.space-xs;
            Caption { text: "Or read these words to each other:"; }
            Text {
                text: root.code-words[0] + " " + root.code-words[1] + " " + root.code-words[2] + " " + root.code-words[3] + " " + root.code-words[4] + " · " + root.code-words[5] + " " + root.code-words[6] + " " + root.code-words[7] + " " + root.code-words[8] + " " + root.code-words[9];
                font-family: "Atkinson Hyperlegible Mono";
                font-size: Tokens.type-body;
                color: Tokens.text;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: start;
                QuietButton {
                    text: root.code-words-english ? "Show in my language" : "Show in English";
                    clicked => { root.code-words-english-toggled(!root.code-words-english); }
                }
            }
        }
        if root.current.verified: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            Seal { state: SealState.checked; size: 24px; }
            Body { text: root.current.met ? "Checked in person" : "Checked"; vertical-alignment: center; }
        }
        if !root.current.verified: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton { text: "They match"; clicked => { root.mark-checked(root.current-id); } }
            QuietButton { text: "Not now"; clicked => { root.sheet = Sheet.none; } }
        }
        if !root.current.met: HorizontalLayout {
            alignment: start;
            QuietButton { text: "Together right now? Meet in person"; outlined: true; clicked => { root.open-sheet(Sheet.meet); } }
        }
    }

    if root.sheet == Sheet.servers: SheetFrame {
        title: root.server-pick-for == 0 ? "Choose a server" : root.server-pick-for == 1 ? "Move to another server" : "Move the group";
        close => { root.sheet = root.server-pick-for == 2 ? Sheet.members : root.server-pick-for == 1 ? Sheet.settings : Sheet.none; }
        Secondary {
            text: root.server-pick-for == 0
                ? "Your messages wait on this server until your devices collect them. It sees only sealed units of one size: it can't read them or tell who sent them. You can move later."
                : root.server-pick-for == 1
                    ? "Your inboxes, username and invite links move with you. Contacts and groups are told as they come online; keep Enclave running until the move is done."
                    : "The group moves from the next day once more than half of its admins vote for the same server. Votes count for 7 days, and earlier messages stay where they are.";
        }
        Flickable {
            height: min(360px, server-list.preferred-height);
            server-list := VerticalLayout {
                spacing: Tokens.space-s;
                for o in root.servers: Rectangle {
                    property <bool> current: o.id == (root.server-pick-for == 2 ? root.group-host : root.server-pick-for == 1 ? root.home-id : "");
                    min-height: srow.preferred-height;
                    border-radius: Tokens.radius-control;
                    border-width: root.chosen-server == o.id ? 2px : 1px;
                    border-color: root.chosen-server == o.id ? Tokens.pine : Tokens.hairline;
                    accessible-role: radio-button;
                    accessible-checked: root.chosen-server == o.id;
                    accessible-label: o.domain + ", run by " + o.operator;
                    accessible-action-default => { root.chosen-server = o.id; }
                    TouchArea { clicked => { root.chosen-server = o.id; } }
                    srow := HorizontalLayout {
                        padding: Tokens.space-m;
                        spacing: Tokens.space-sm;
                        VerticalLayout {
                            alignment: start;
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 10px;
                                border-width: 2px;
                                border-color: root.chosen-server == o.id ? Tokens.pine : Tokens.text-muted;
                                if root.chosen-server == o.id: Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Tokens.pine; }
                            }
                        }
                        VerticalLayout {
                            spacing: Tokens.space-xs;
                            Body { text: o.domain; font-weight: 600; overflow: elide; }
                            Secondary {
                                text: "Run by " + o.operator
                                    + (current ? (root.server-pick-for == 2 ? " · The group is here" : " · You're here") : "")
                                    + (root.server-pick-for == 2 && o.votes > 0 ? " · " + o.votes + " of " + root.group-admins + " admins voted for it" : "");
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton {
                text: root.server-pick-for == 0 ? "Use this server" : root.server-pick-for == 1 ? (root.busy ? "Moving…" : "Move my account") : "Vote for this server";
                enabled: root.chosen-server != "" && !root.busy
                    && root.chosen-server != (root.server-pick-for == 2 ? root.group-host : root.server-pick-for == 1 ? root.home-id : "");
                clicked => {
                    root.pick-server(root.server-pick-for, root.chosen-server);
                    root.sheet = root.server-pick-for == 2 ? Sheet.members : root.server-pick-for == 1 ? Sheet.settings : Sheet.none;
                }
            }
        }
    }

    if root.sheet == Sheet.settings: SheetFrame {
        title: "Settings";
        close => { root.sheet = Sheet.none; }
        for option[i] in [
            { title: "Standard", text: "Hides who you talk to. Uses about 80 MB an hour while Enclave is open, and about 50 MB a day in the background." },
            { title: "Maximum", text: "Also hides when you're using Enclave. Uses about 2 GB a day. Large files send slowly." },
        ]: Rectangle {
            min-height: row.preferred-height;
            border-radius: Tokens.radius-control;
            border-width: root.privacy == i ? 2px : 1px;
            border-color: root.privacy == i ? Tokens.pine : Tokens.hairline;
            accessible-role: radio-button;
            accessible-checked: root.privacy == i;
            accessible-label: option.title;
            accessible-action-default => { root.set-privacy(i); }
            TouchArea { clicked => { root.set-privacy(i); } }
            row := HorizontalLayout {
                padding: Tokens.space-m;
                spacing: Tokens.space-sm;
                VerticalLayout {
                    alignment: start;
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        border-width: 2px;
                        border-color: root.privacy == i ? Tokens.pine : Tokens.text-muted;
                        if root.privacy == i: Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Tokens.pine; }
                    }
                }
                VerticalLayout {
                    spacing: Tokens.space-xs;
                    Body { text: option.title; font-weight: 600; }
                    Secondary { text: option.text; }
                }
            }
        }
        Rectangle { height: 1px; background: Tokens.hairline; }
        if root.home-label != "": Body { text: "Your server"; font-weight: 600; }
        if root.home-label != "": Secondary {
            text: root.home-label + (root.moving ? ". Moving: still telling your contacts and groups. Keep Enclave running until it's done." : ".");
        }
        if root.can-move && !root.moving && root.servers.length > 1: HorizontalLayout {
            alignment: start;
            QuietButton {
                text: "Move to another server";
                outlined: true;
                clicked => { root.server-pick-for = 1; root.chosen-server = ""; root.sheet = Sheet.servers; }
            }
        }
        Body { text: "Tor bridges"; font-weight: 600; }
        Secondary {
            text: root.bridges == ""
                ? "Off. If your network blocks Tor, a bridge gets around it. Use Tor's built-in bridges, or paste obfs4 bridge lines from bridges.torproject.org."
                : root.bridges == "builtin"
                    ? "Using Tor's built-in bridges."
                    : "Using your own bridges.";
        }
        Field { placeholder: "obfs4 … cert=… iat-mode=0"; mono: true; multiline: true; text <=> root.bridges-input; }
        HorizontalLayout {
            spacing: Tokens.space-s;
            alignment: start;
            PrimaryButton { text: "Save"; enabled: root.bridges-input != ""; clicked => { root.set-bridges(root.bridges-input); } }
            QuietButton { text: "Built-in"; clicked => { root.set-bridges("builtin"); } }
            if root.bridges != "": QuietButton { text: "Turn off"; clicked => { root.set-bridges(""); } }
        }
        if root.bridges-error != "": Text {
            text: root.bridges-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        Rectangle { height: 1px; background: Tokens.hairline; }
        SwitchRow {
            label: "Typing indicators";
            detail: "Show people when you're typing, and see when they are. They only replace cover traffic, so they never use more data, and some may not arrive.";
            on: root.typing-setting;
            toggled => { root.set-typing-setting(!root.typing-setting); }
        }
        if root.usernames: Rectangle { height: 1px; background: Tokens.hairline; }
        if root.usernames: Body { text: "Username"; font-weight: 600; }
        if root.usernames && root.my-username != "": Text {
            text: root.my-username;
            font-family: "Atkinson Hyperlegible Mono";
            font-size: Tokens.type-body;
            color: Tokens.text;
            accessible-label: "Your username: " + root.my-username;
        }
        if root.usernames: Secondary {
            text: root.my-username == ""
                ? "Optional. A username is public, like an email address: anyone who knows it can send you a message request."
                : "Anyone who knows it can send you a message request. Choosing a new one retires this one.";
        }
        if root.usernames: HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: "name"; mono: true; text <=> root.username-input; horizontal-stretch: 1; }
            PrimaryButton {
                text: root.busy ? "Checking…" : (root.my-username == "" ? "Choose" : "Change");
                enabled: root.username-input != "" && !root.busy;
                clicked => { root.claim-username(root.username-input); }
            }
        }
        if root.usernames && root.username-error != "": Text {
            text: root.username-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Tokens.space-s;
            QuietButton {
                text: "Recovery words";
                outlined: true;
                horizontal-stretch: 1;
                clicked => { root.open-sheet(Sheet.recovery); }
            }
            QuietButton {
                text: "Your devices";
                outlined: true;
                horizontal-stretch: 1;
                clicked => { root.open-sheet(Sheet.devices); }
            }
        }
        if root.can-join: Rectangle { height: 1px; background: Tokens.hairline; }
        if root.can-join: Body { text: "Passphrase"; font-weight: 600; }
        if root.can-join: Secondary {
            text: root.can-lock
                ? "Enclave asks for it each time it starts on this computer."
                : "Optional. Enclave would ask for it each time it starts on this computer.";
        }
        if root.can-join: HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: root.can-lock ? "New passphrase" : "Passphrase"; secret: true; text <=> root.new-passphrase; horizontal-stretch: 1; }
            PrimaryButton {
                text: root.busy ? "Saving…" : (root.can-lock ? "Change" : "Set");
                enabled: root.new-passphrase != "" && !root.busy;
                clicked => { root.set-passphrase(root.new-passphrase); }
            }
        }
        if root.can-lock: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            QuietButton { text: "Lock now"; outlined: true; clicked => { root.sheet = Sheet.none; root.lock-now(); } }
            QuietButton { text: "Remove passphrase"; danger: true; clicked => { root.set-passphrase(""); } }
        }
        Rectangle { height: 1px; background: Tokens.hairline; }
        Body { text: "Screen lock"; font-weight: 600; }
        Secondary {
            text: root.can-lock
                ? "Enclave locks itself when you haven't used it for a while, and your passphrase opens it again."
                : root.app-lock
                    ? "Enclave locks itself when you haven't used it for a while, and your PIN opens it again. Messages keep arriving while it's locked."
                    : "Set a PIN, and Enclave locks itself when you haven't used it for a while. Messages keep arriving while it's locked.";
        }
        if !root.can-lock: HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: root.app-lock ? "New PIN" : "PIN (at least 4 digits)"; secret: true; text <=> root.app-pin-input; horizontal-stretch: 1; }
            PrimaryButton {
                text: root.app-lock ? "Change" : "Set";
                enabled: root.app-pin-input != "";
                clicked => { root.set-app-lock(root.app-pin-input); root.app-pin-input = ""; }
            }
        }
        if root.can-lock || root.app-lock: Caption { text: "Lock after"; }
        if root.can-lock || root.app-lock: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-xs;
            for t in [
                { secs: 60, name: "1 minute" }, { secs: 300, name: "5 minutes" },
                { secs: 900, name: "15 minutes" }, { secs: 3600, name: "1 hour" },
                { secs: 0, name: "Never" },
            ]: QuietButton {
                text: t.name;
                outlined: root.lock-timeout == t.secs;
                accessible-label: "Lock after " + t.name;
                clicked => { root.set-lock-timeout(t.secs); }
            }
        }
        if root.app-lock && !root.can-lock: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            QuietButton { text: "Lock now"; outlined: true; clicked => { root.sheet = Sheet.none; root.lock-now(); } }
            QuietButton { text: "Turn off"; danger: true; clicked => { root.set-app-lock(""); } }
        }
        Body { text: "Emergency PIN"; font-weight: 600; }
        Secondary {
            text: "If someone makes you open Enclave, type this instead of your PIN or passphrase. It erases Enclave from this computer and opens it as if it were new. A copy of this computer made before you used it isn't affected.";
        }
        HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: "Emergency PIN (at least 4 digits)"; secret: true; text <=> root.emergency-pin-input; horizontal-stretch: 1; }
            PrimaryButton {
                text: "Set";
                enabled: root.emergency-pin-input != "";
                clicked => { root.set-emergency-pin(root.emergency-pin-input); root.emergency-pin-input = ""; }
            }
            QuietButton { text: "Remove"; clicked => { root.set-emergency-pin(""); } }
        }
        Body { text: "Backup"; font-weight: 600; }
        Secondary { text: "An encrypted copy of your contacts, messages and notes. Only your recovery words open it."; }
        if root.can-change-words: SwitchRow {
            label: "Keep a backup on my server";
            detail: root.server-backup
                ? (root.server-backup-at != "" ? "Renewed every week. Last: " + root.server-backup-at + "." : "Renewed every week.")
                : "Renewed every week. Your server sees only an encrypted file; your words alone bring it back.";
            on: root.server-backup;
            toggled => { if !root.busy { root.set-server-backup(!root.server-backup); } }
        }
        SwitchRow {
            label: "Include photos and files";
            detail: "In backups you save here. They can get large.";
            on: root.backup-media;
            toggled => { root.backup-media = !root.backup-media; }
        }
        HorizontalLayout {
            alignment: start;
            QuietButton { text: "Save a backup"; outlined: true; clicked => { root.save-backup(root.backup-media); } }
        }
        Caption { text: "Check my backup"; }
        Secondary { text: "Make sure the words you wrote down open your backup, without restoring anything."; }
        Field { placeholder: "Your 24 recovery words"; mono: true; secret: true; text <=> root.check-words; }
        Field { placeholder: "Path to a backup file (or leave empty for the one on your server)"; mono: true; text <=> root.check-file; }
        HorizontalLayout {
            alignment: start;
            QuietButton {
                text: root.busy ? "Checking…" : "Check";
                outlined: true;
                clicked => { if root.check-words != "" && !root.busy { root.check-backup(root.check-words, root.check-file); root.check-words = ""; } }
            }
        }
        if root.backup-check != "": Secondary { text: root.backup-check; }
        Body { text: "PIN"; font-weight: 600; }
        Secondary { text: root.has-root-pin ? "Enclave asks for your PIN before removing a device, changing your recovery words or deleting your account." : "Set a PIN, and Enclave asks for it before removing a device, changing your recovery words or deleting your account. Someone who picks up your unlocked phone can't do those."; }
        if root.has-root-pin: Field { placeholder: "Current PIN"; secret: true; text <=> root.root-pin-input; }
        HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: root.has-root-pin ? "New PIN" : "PIN (at least 6)"; secret: true; text <=> root.new-pin-input; horizontal-stretch: 1; }
            QuietButton {
                text: root.has-root-pin ? "Change PIN" : "Set PIN";
                outlined: true;
                clicked => {
                    if root.has-root-pin { root.unlock-root(root.root-pin-input); }
                    root.set-root-pin(root.new-pin-input);
                    root.new-pin-input = "";
                    root.root-pin-input = "";
                }
            }
        }
        if root.pin-error != "": Text { text: root.pin-error; color: Tokens.danger; font-size: Tokens.type-secondary; wrap: word-wrap; }
        Body { text: "Notifications"; font-weight: 600; }
        Secondary { text: root.previews ? "Notifications on your phone show who wrote and the start of the message. Only your devices can read them; Apple and Google see nothing." : "Notifications say \"New message\" only. Turn previews on to see who wrote and the start of the message, readable only by your devices."; }
        HorizontalLayout {
            alignment: start;
            QuietButton { text: root.previews ? "Turn previews off" : "Show previews"; outlined: true; clicked => { root.set-previews(!root.previews); } }
        }
        Body { text: "Secure my account"; font-weight: 600; }
        Secondary { text: root.securing ? "Securing your account. This finishes on its own." : "Lost a device, or worried someone saw something? This gives your account new keys, new inboxes and new device keys, and starts fresh protection with every contact and group. Your security code and conversations stay the same."; }
        if root.can-change-words && !root.securing && root.has-root-pin: Field { placeholder: "Your PIN"; secret: true; text <=> root.root-pin-input; }
        if root.can-change-words && !root.securing: HorizontalLayout {
            alignment: start;
            QuietButton {
                text: root.busy ? "Securing…" : "Secure my account";
                outlined: true;
                clicked => { if !root.busy { if root.has-root-pin { root.unlock-root(root.root-pin-input); root.root-pin-input = ""; } root.secure-account(); } }
            }
        }
        Body { text: "Delete"; font-weight: 600; }
        Secondary { text: root.can-change-words ? "Delete your account for everyone, or only erase this device." : "Erase this device. Deleting the account is done on the device that holds your recovery words."; }
        HorizontalLayout {
            alignment: start;
            QuietButton { text: root.can-change-words ? "Delete my account" : "Erase this device"; danger: true; clicked => { root.delete-confirm = ""; root.open-sheet(Sheet.delete-account); } }
        }
        Body { text: "Recovery with friends"; font-weight: 600; }
        Secondary {
            text: root.share-threshold > 0
                ? "Any " + root.share-threshold + " of the " + root.share-holders.length + " people you chose can help you get your account back if you lose your words and every device. None of them can do it alone."
                : "Give a few people you trust each a share of your recovery. If you lose your words and every device, meeting enough of them gets your account back. None of them can do it alone.";
        }
        HorizontalLayout {
            alignment: start;
            QuietButton { text: root.share-threshold > 0 ? "Choose again" : "Choose friends"; outlined: true; clicked => { root.open-sheet(Sheet.friends); } }
        }
    }

    if root.sheet == Sheet.friends: SheetFrame {
        property <int> chosen: root.friends-chosen;
        title: "Recovery with friends";
        close => { root.sheet = Sheet.none; }
        Secondary { text: "Choose 3 to 5 people you trust and can meet. Each gets a share by message, and can only give it back to you in person."; }
        if root.share-threshold > 0: Secondary { text: "Leaving out someone who holds a share now changes your recovery words, so their share stops working. You'll be shown the new words."; }
        for p in root.friends: Rectangle {
            height: 56px;
            border-radius: Tokens.radius-control;
            background: p.selected ? Tokens.bubble-in : transparent;
            accessible-role: checkbox;
            accessible-checked: p.selected;
            accessible-label: p.name;
            accessible-action-default => { root.toggle-pick(p.id); }
            TouchArea { clicked => { root.toggle-pick(p.id); } }
            HorizontalLayout {
                padding-left: Tokens.space-s;
                padding-right: Tokens.space-s;
                spacing: Tokens.space-sm;
                VerticalLayout { alignment: center; Avatar { initials: p.initials; tint: p.tint; size: 36px; } }
                Body { text: p.name; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Text { text: p.selected ? "Chosen" : ""; font-size: Tokens.type-caption; color: Tokens.pine; vertical-alignment: center; }
            }
        }
        if root.friends.length < 2: Secondary { text: "You need at least two conversations with people you trust first."; }
        if root.has-root-pin: Field { placeholder: "Your PIN"; secret: true; text <=> root.root-pin-input; }
        HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? "Sharing…" : (chosen >= 2 ? "Share with " + chosen + " (" + (floor(chosen / 2) + 1) + " needed)" : "Share");
                enabled: chosen >= 2 && !root.busy;
                clicked => { if root.has-root-pin { root.unlock-root(root.root-pin-input); root.root-pin-input = ""; } root.give-shares(floor(chosen / 2) + 1); root.sheet = Sheet.none; }
            }
        }
    }

    if root.sheet == Sheet.share: SheetFrame {
        title: "Part of " + root.current.name + "'s recovery";
        close => { root.reveal-share(""); root.sheet = Sheet.none; }
        if root.share-release == "": Body {
            text: root.current.name + " asked for your part of their recovery. Only continue if you're with " + root.current.name + " right now.";
            wrap: word-wrap;
        }
        if root.share-release == "": Secondary {
            text: "Anyone who collects enough of these can take over their account. Never give it over a message or a call, even if it seems to be them.";
        }
        if root.share-release == "": Field {
            placeholder: "Scan or paste the code on their new device";
            mono: true;
            text <=> root.share-request-input;
        }
        if root.share-release == "": HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton {
                text: "I'm with them: continue";
                enabled: root.share-request-input != "";
                clicked => { root.release-share(root.share-request-input); }
            }
            QuietButton { text: "Not now"; clicked => { root.reveal-share(""); root.sheet = Sheet.none; } }
        }
        if root.share-release != "": Body {
            text: "Check their screen shows these words: " + root.share-release-words;
            wrap: word-wrap;
        }
        if root.share-release != "": Secondary {
            text: "If the words differ, close this: you scanned the wrong screen. If they match, let " + root.current.name + " scan this code.";
        }
        if root.share-release != "": HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 296px;
                height: 296px;
                background: #ffffff;
                border-radius: Tokens.radius-control;
                Image {
                    width: 280px;
                    height: 280px;
                    source: root.share-release-qr;
                    image-rendering: pixelated;
                    accessible-role: image;
                    accessible-label: "Your part of " + root.current.name + "'s recovery, sealed for their new device";
                }
            }
        }
        if root.share-release != "": HorizontalLayout {
            alignment: start;
            PrimaryButton { text: "Done"; clicked => { root.reveal-share(""); root.sheet = Sheet.none; } }
        }
    }

    if root.sheet == Sheet.new-group: SheetFrame {
        title: "New group";
        close => { root.sheet = Sheet.none; }
        Field { placeholder: "Group name"; text <=> root.group-name; }
        Secondary { text: root.pick.length == 0 ? "Add people as contacts first. Groups are made from people who have accepted you." : "Choose who to add. Everyone in the group can see who else is in it."; }
        for p in root.pick: Rectangle {
            height: 56px;
            border-radius: Tokens.radius-control;
            background: p.selected ? Tokens.bubble-in : transparent;
            accessible-role: checkbox;
            accessible-checked: p.selected;
            accessible-label: p.name;
            accessible-action-default => { root.toggle-pick(p.id); }
            TouchArea { clicked => { root.toggle-pick(p.id); } }
            HorizontalLayout {
                padding-left: Tokens.space-s;
                padding-right: Tokens.space-s;
                spacing: Tokens.space-sm;
                VerticalLayout { alignment: center; Avatar { initials: p.initials; tint: p.tint; size: 36px; } }
                Body { text: p.name; vertical-alignment: center; horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: p.selected ? Tokens.pine : Tokens.text-muted;
                        background: p.selected ? Tokens.pine : transparent;
                        if p.selected: Path {
                            width: 16px;
                            height: 16px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M 5 12 L 10 17 L 19 7";
                            stroke: Tokens.on-pine;
                            stroke-width: 2.5px;
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? "Creating…" : "Create group";
                enabled: root.group-name != "" && !root.busy;
                clicked => { root.create-group(root.group-name); }
            }
        }
    }

    if root.sheet == Sheet.members: SheetFrame {
        title: root.current.name;
        close => { root.sheet = Sheet.none; root.confirm-leave = ""; }
        Secondary { text: root.current.members + " people, you included. Everyone in the group can see who else is in it."; }
        for m in root.members: HorizontalLayout {
            spacing: Tokens.space-sm;
            min-height: 56px;
            VerticalLayout { alignment: start; padding-top: Tokens.space-s; Avatar { initials: m.initials; tint: m.tint; art: m.art; art-tint: m.art-tint; size: 36px; } }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Body { text: m.name; overflow: elide; }
                if m.met || m.verified || m.admin: Caption {
                    text: (m.admin ? "Admin" : "") + (m.admin && (m.met || m.verified) ? " · " : "") + (m.met ? "Met in person" : m.verified ? "Checked" : "");
                }
                // An admin's controls go under the name, so a long name
                // keeps its room on a phone.
                if root.group-admin: HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-s;
                    QuietButton {
                        text: m.admin ? "Not admin" : "Make admin";
                        accessible-label: (m.admin ? "Stop " + m.name + " being an admin" : "Make " + m.name + " an admin");
                        clicked => { root.set-group-admin(root.current-id, m.id, !m.admin); }
                    }
                    QuietButton {
                        text: "Remove";
                        danger: true;
                        accessible-label: "Remove " + m.name;
                        clicked => { root.remove-member(root.current-id, m.id); }
                    }
                }
            }
        }
        if root.group-admin: SwitchRow {
            label: "On the record";
            detail: root.on-record
                ? "Messages carry their sender's signature. Anyone who gets a copy can prove who wrote them."
                : "Nobody can prove to others who wrote these messages.";
            on: root.on-record;
            toggled => { root.set-on-record(!root.on-record); }
        }
        if !root.group-admin: Caption {
            text: root.on-record
                ? "On the record: messages carry their sender's signature. Admins can change this."
                : "Off the record: nobody can prove to others who wrote these messages. Admins can change this.";
            wrap: word-wrap;
        }
        if root.group-host-label != "": Secondary { text: root.group-host-label + root.group-vote-label; }
        if root.group-admin && root.servers.length > 1: HorizontalLayout {
            alignment: start;
            QuietButton {
                text: "Vote to move the group";
                clicked => { root.server-pick-for = 2; root.chosen-server = ""; root.sheet = Sheet.servers; }
            }
        }
        if root.group-admin: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            QuietButton {
                text: "Copy invite link";
                accessible-label: "Copy a group invite link";
                clicked => { root.new-group-invite(root.current-id); }
            }
        }
        if root.group-admin: Caption {
            text: "Each link works for one person, for 7 days. You approve them before they join, and they see only new messages.";
            wrap: word-wrap;
        }
        if root.group-admin && root.addable.length > 0: Body { text: "Add people"; font-weight: 600; }
        if root.group-admin && root.addable.length > 0: Secondary { text: "They'll see new messages from now on, not what was said before they joined."; }
        if root.group-admin: VerticalLayout {
        for p in root.addable: Rectangle {
            height: 56px;
            border-radius: Tokens.radius-control;
            background: p.selected ? Tokens.bubble-in : transparent;
            accessible-role: checkbox;
            accessible-checked: p.selected;
            accessible-label: p.name;
            accessible-action-default => { root.toggle-pick(p.id); }
            TouchArea { clicked => { root.toggle-pick(p.id); } }
            HorizontalLayout {
                padding-left: Tokens.space-s;
                padding-right: Tokens.space-s;
                spacing: Tokens.space-sm;
                VerticalLayout { alignment: center; Avatar { initials: p.initials; tint: p.tint; size: 36px; } }
                Body { text: p.name; vertical-alignment: center; horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: p.selected ? Tokens.pine : Tokens.text-muted;
                        background: p.selected ? Tokens.pine : transparent;
                        if p.selected: Path {
                            width: 16px;
                            height: 16px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M 5 12 L 10 17 L 19 7";
                            stroke: Tokens.on-pine;
                            stroke-width: 2.5px;
                        }
                    }
                }
            }
        }
        }
        if root.group-admin && root.addable.length > 0: HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? "Adding…" : "Add to group";
                enabled: !root.busy;
                clicked => { root.add-members(root.current-id); }
            }
        }
        if root.confirm-leave == "": HorizontalLayout {
            alignment: start;
            QuietButton { text: "Leave group"; danger: true; clicked => { root.confirm-leave = root.current-id; } }
        }
        if root.confirm-leave != "": Notice {
            title: "Leave " + root.current.name + "?";
            text: "You'll stop getting its messages. Someone would have to add you again.";
            kind: 2;
            HorizontalLayout {
                alignment: start;
                spacing: Tokens.space-s;
                PrimaryButton { text: "Leave"; danger: true; clicked => { root.leave-group(root.current-id); root.confirm-leave = ""; } }
                QuietButton { text: "Stay"; clicked => { root.confirm-leave = ""; } }
            }
        }
    }

    if root.sheet == Sheet.devices: SheetFrame {
        title: "Your devices";
        close => { root.sheet = Sheet.none; }
        for d in root.devices: Rectangle {
            min-height: dev.preferred-height;
            dev := VerticalLayout {
            spacing: Tokens.space-s;
            HorizontalLayout {
                spacing: Tokens.space-sm;
                VerticalLayout {
                    horizontal-stretch: 1;
                    Body { text: d.label; font-weight: 600; }
                    Secondary { text: d.detail; }
                }
                if d.removable && root.confirm-remove != d.id: QuietButton {
                    text: "Remove";
                    accessible-label: "Remove " + d.label;
                    clicked => { root.confirm-remove = d.id; }
                }
            }
            if d.history-action != "" && root.confirm-remove != d.id: HorizontalLayout {
                alignment: start;
                QuietButton {
                    text: d.history-action;
                    outlined: true;
                    accessible-label: d.history-action + ": " + d.label;
                    clicked => { root.send-history(d.id); }
                }
            }
            if root.confirm-remove == d.id: Rectangle {
                min-height: confirm.preferred-height;
                border-radius: Tokens.radius-control;
                border-width: 1px;
                border-color: Tokens.danger;
                confirm := VerticalLayout {
                    padding: Tokens.space-m;
                    spacing: Tokens.space-s;
                    Body { text: "Remove this device?"; font-weight: 600; }
                    Secondary { text: "It stops getting new messages, and your contacts stop sending to it. Messages already on it stay there until it's erased."; }
                    if root.has-root-pin: Field { placeholder: "Your PIN"; secret: true; text <=> root.root-pin-input; }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-s;
                        PrimaryButton {
                            text: root.busy ? "Removing…" : "Remove device";
                            danger: true;
                            enabled: !root.busy;
                            clicked => { if root.has-root-pin { root.unlock-root(root.root-pin-input); root.root-pin-input = ""; } root.remove-device(d.id); }
                        }
                        QuietButton { text: "Keep it"; clicked => { root.confirm-remove = ""; } }
                    }
                }
            }
        }
        }
        if root.can-link && root.link-choices.length == 0: Secondary {
            text: "To link a new device, open Enclave on it, choose \"I already have Enclave\", and paste its link code here. Only do this with your own device.";
        }
        if root.can-link && root.link-choices.length == 0: Field { placeholder: "enclave:link#…"; mono: true; text <=> root.link-code; }
        if root.can-link && root.link-choices.length == 0: HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? "Checking…" : "Continue";
                enabled: root.link-code != "" && !root.busy;
                clicked => { root.link-scan(root.link-code); }
            }
        }
        if root.link-choices.length > 0: VerticalLayout {
            spacing: Tokens.space-s;
            Body { text: "Which words does your new device show?"; font-weight: 600; }
            for c[i] in root.link-choices: QuietButton {
                text: c;
                outlined: true;
                clicked => { root.link-pick(i); }
            }
        }
        if root.link-status != "": Secondary { text: root.link-status; }
        if !root.can-link: Secondary { text: "Only your first device can link new ones."; }
    }

    if root.sheet == Sheet.recovery: SheetFrame {
        title: "Your recovery words";
        max-card-width: 640px;
        close => { root.sheet = Sheet.none; }
        Secondary {
            text: "If you lose this device, these 24 words bring your account back. Anyone who has them can become you. Write them down on paper and keep them somewhere safe.";
        }
        // The same words in any of BIP-39's lists: whichever is written
        // down brings the same account back.
        Caption { text: "Show them in:"; }
        GridLayout {
            spacing: Tokens.space-xs;
            for l[i] in [
                { code: "en", name: "English" }, { code: "es", name: "Español" },
                { code: "fr", name: "Français" }, { code: "it", name: "Italiano" },
                { code: "pt", name: "Português" }, { code: "cs", name: "Čeština" },
                { code: "ja", name: "日本語" }, { code: "ko", name: "한국어" },
                { code: "zh-Hans", name: "简体中文" }, { code: "zh-Hant", name: "繁體中文" },
            ]: QuietButton {
                row: root.wide ? i / 5 : i / 2;
                col: root.wide ? mod(i, 5) : mod(i, 2);
                text: l.name;
                outlined: l.code == root.words-language;
                accessible-label: "Show the words in " + l.name;
                clicked => { root.choose-words-language(l.code); }
            }
        }
        // Behind a PIN the words are wrapped: they show for two minutes
        // after it is entered.
        if root.can-change-words && root.has-root-pin && root.recovery-words.length == 0 && !root.busy: Secondary {
            text: "Your words are locked with your PIN.";
        }
        if root.can-change-words && root.has-root-pin && root.recovery-words.length == 0 && !root.busy: HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: "Your PIN"; secret: true; text <=> root.root-pin-input; horizontal-stretch: 1; }
            PrimaryButton {
                text: "Show";
                clicked => { root.unlock-root(root.root-pin-input); root.root-pin-input = ""; }
            }
        }
        if root.can-change-words && root.has-root-pin && root.recovery-words.length == 0 && root.pin-error != "": Text {
            text: root.pin-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        GridLayout {
            spacing-horizontal: Tokens.space-m;
            spacing-vertical: Tokens.space-xs;
            for w[i] in root.recovery-words: HorizontalLayout {
                row: root.wide ? mod(i, 6) : i / 2;
                col: root.wide ? i / 6 : mod(i, 2);
                spacing: Tokens.space-s;
                Caption { text: i + 1; width: 20px; horizontal-alignment: right; vertical-alignment: center; }
                Text {
                    text: w;
                    font-family: "Atkinson Hyperlegible Mono";
                    font-size: Tokens.type-body;
                    color: Tokens.text;
                }
            }
        }
        if root.busy: Secondary { text: "Making your new words…"; }
        if !root.busy: HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.recovery-saved ? "Done" : "I've written them down";
                clicked => { root.words-saved(); root.sheet = Sheet.none; }
            }
        }
        if root.words-pending && !root.busy: Caption {
            text: "Telling your contacts and groups about your new words. This finishes on its own.";
            wrap: word-wrap;
        }
        if root.can-change-words && !root.busy && !root.words-pending: Rectangle { height: 1px; background: Tokens.hairline; }
        if root.can-change-words && !root.busy && !root.words-pending: Secondary {
            text: "Think someone may have seen them? You can replace them with new words.";
        }
        if root.can-change-words && !root.busy && !root.words-pending: HorizontalLayout {
            alignment: start;
            QuietButton {
                text: "Change my words";
                outlined: true;
                clicked => { root.open-sheet(Sheet.change-words); }
            }
        }
        // A linked device: the words live on the first device.
        if !root.can-change-words && root.recovery-words.length == 0 && !root.busy && !root.words-pending: Secondary {
            text: "Your recovery words are on the device you set Enclave up on first, not this one. Lost the words and that device too? You can make new words here.";
        }
        if !root.can-change-words && root.recovery-words.length == 0 && !root.busy && !root.words-pending: HorizontalLayout {
            alignment: start;
            QuietButton {
                text: "Make new words";
                outlined: true;
                clicked => { root.open-sheet(Sheet.change-words); }
            }
        }
    }

    if root.sheet == Sheet.player: SheetFrame {
        title: "Animated picture";
        close => { root.sheet = Sheet.none; }
        if root.player-frames.length == 0: Secondary { text: root.busy ? "Getting it ready…" : "Enclave couldn't play this one."; }
        if root.player-frames.length > 0: Rectangle {
            height: self.width * root.player-frames[0].height / max(1, root.player-frames[0].width);
            border-radius: Tokens.radius-control;
            clip: true;
            Image {
                source: root.player-frames[min(root.player-index, root.player-frames.length - 1)];
                width: parent.width;
                height: parent.height;
                image-fit: contain;
                accessible-role: image;
                accessible-label: "Animated picture";
            }
        }
        // Plays on a loop while the sheet is open; reduce-motion shows the
        // first frame only.
        Timer {
            interval: root.player-interval;
            running: root.sheet == Sheet.player && root.player-frames.length > 1 && !Tokens.reduce-motion;
            triggered => { root.player-index = mod(root.player-index + 1, root.player-frames.length); }
        }
    }

    if root.sheet == Sheet.delete-account: SheetFrame {
        title: root.can-change-words ? "Delete your account" : "Erase this device";
        close => { root.sheet = Sheet.none; }
        if root.can-change-words: Body {
            text: "This deletes your account for everyone. Your contacts see that you closed it, you leave every group, your username is withdrawn for good, and your server deletes your inboxes. Then everything on this device is erased, and your other devices erase themselves. It can't be undone.";
            wrap: word-wrap;
        }
        if !root.can-change-words: Body {
            text: "This erases your conversations and keys from this device only. Your account goes on on your other devices.";
            wrap: word-wrap;
        }
        Field { placeholder: "Type delete to confirm"; text <=> root.delete-confirm; }
        if root.has-root-pin && root.can-change-words: Field { placeholder: "Your PIN"; secret: true; text <=> root.root-pin-input; }
        HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton {
                text: root.busy ? "Deleting…" : (root.can-change-words ? "Delete my account" : "Erase this device");
                danger: true;
                enabled: root.delete-confirm == "delete" && !root.busy;
                clicked => { if root.can-change-words { if root.has-root-pin { root.unlock-root(root.root-pin-input); root.root-pin-input = ""; } root.delete-account(); } else { root.erase-device(); } }
            }
            QuietButton { text: "Keep it"; clicked => { root.sheet = Sheet.none; } }
        }
        if root.can-change-words: Rectangle { height: 1px; background: Tokens.hairline; }
        if root.can-change-words: Secondary { text: "Only want Enclave gone from this device? Erase it instead; your account stays on your other devices."; }
        if root.can-change-words: HorizontalLayout {
            alignment: start;
            QuietButton { text: "Erase only this device"; outlined: true; clicked => { if root.delete-confirm == "delete" && !root.busy { root.erase-device(); } } }
        }
    }

    if root.sheet == Sheet.change-words: SheetFrame {
        title: root.can-change-words ? "Change your recovery words" : "Make new recovery words";
        close => { root.sheet = Sheet.none; }
        Body {
            text: root.can-change-words
                ? "Do this if someone may have seen your words. You'll get 24 new words, and the old ones stop working."
                : "Do this only if your words are lost and so is the device that had them. This device gets 24 new words and becomes the one that holds them.";
            wrap: word-wrap;
        }
        Secondary {
            text: root.can-change-words
                ? "Everyone you talk to will see that your security code changed, and will be asked to check it again. Your conversations, groups and devices stay as they are."
                : "Without the old words Enclave can't prove to your contacts that this was you, so each of them is asked to check your security code in person. Your conversations, groups and devices stay as they are, and your username stays with the old words.";
        }
        Secondary {
            text: root.can-change-words
                ? "Old invite links and codes stop working, and backups made with the old words won't restore. Save a new backup afterwards."
                : "Share new invite links and codes: old ones still lead to the account under the old words. Save a new backup afterwards.";
        }
        if root.has-root-pin: Field { placeholder: "Your PIN"; secret: true; text <=> root.root-pin-input; }
        HorizontalLayout {
            spacing: Tokens.space-s;
            alignment: start;
            PrimaryButton {
                text: root.can-change-words ? "Change my words" : "Make new words";
                clicked => { if root.has-root-pin { root.unlock-root(root.root-pin-input); root.root-pin-input = ""; } root.change-words(); root.open-sheet(Sheet.recovery); }
            }
            QuietButton { text: "Not now"; clicked => { root.sheet = Sheet.recovery; } }
        }
    }
}
