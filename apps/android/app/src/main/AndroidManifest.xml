<?xml version="1.0" encoding="utf-8"?>
<!-- The activity is Android's NativeActivity running libenclave_mobile.so
     (nym/enclave-mobile), with a small Java subclass for what only Java
     reaches (pickers, camera, notifications, clipboard, keystore). Nothing
     is backed up by the system (the profile is backed up by Enclave,
     sealed). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scanning codes; asked for when a scan starts. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Calls: the microphone (asked when a call starts), and the call
         audio mode. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- "New message" notifications (Android 13 and later ask). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Staying connected with the app closed, and being woken by a push
         (EnclaveService); again after a restart. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Calls on the system's call handling (Calls.java: a self-managed
         ConnectionService, which needs no phone permission), a ringing
         call full screen over the lock screen, and the call kept going
         with the window closed. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- UnifiedPush distributors and their link screen (UnifiedPush.java). -->
    <queries>
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="unifiedpush" android:host="link" />
        </intent>
    </queries>

    <application
        android:label="Enclave"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hasCode="true"
        android:supportsRtl="true"
        android:theme="@style/Enclave">

        <activity
            android:name=".EnclaveActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="enclave_mobile" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".EnclaveService"
            android:exported="false"
            android:foregroundServiceType="specialUse|phoneCall|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps an end-to-end encrypted messenger connected to its mixnet so messages arrive without Google's push service, or fetches them after a push woke it." />
        </service>

        <service
            android:name=".Calls$Service"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".Calls$Decline"
            android:exported="false" />

        <!-- The helpers in processes of their own (HelperService): the
             network in ":net", the media parsers isolated in ":media". -->
        <service
            android:name=".HelperService$Net"
            android:process=":net"
            android:exported="false" />
        <service
            android:name=".HelperService$Media"
            android:process=":media"
            android:isolatedProcess="true"
            android:exported="false" />

        <receiver
            android:name=".EnclaveService$Boot"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".UnifiedPush$Receiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.TEMP_UNAVAILABLE" />
            </intent-filter>
        </receiver>

        <service
            android:name=".UnifiedPush$Raise"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.RAISE_TO_FOREGROUND" />
            </intent-filter>
        </service>
    </application>
</manifest>
